; Production || Development
APP_ENV=Production
APP_DEBUG=true
APP_KEY=SomeRandomString
APP_URL=http://localhost

REDMINE_URL=https://forge.typo3.org
REDMINE_APIKEY=YOUR_SECRET_APIKEY
REDMINE_ELEVATED_APIKEY=YOUR_SECRET_ELEVATED_APIKEY
REDMINE_PROJECT_ID=27
SLACK_TEAM_URL=TEAMURL
SLACK_WEBHOOK_URL=TEAMURL
SLACK_RECAPTCHA_SECRET=
