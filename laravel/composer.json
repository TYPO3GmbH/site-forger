{
    "name": "t3g/forger",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "type": "project",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/wmdbsystems/FluidLaravel.git"
        }
    ],
    "require": {
        "laravel/framework": "^5.5",
        "kbsali/redmine-api": "^1.5",
        "ruflin/elastica": "^6.0",
        "typo3fluid/fluid": "^2.4.0",
        "wmdbsystems/fluidlaravel": "dev-master",
        "netcarver/textile": "dev-master as 3.7",
        "symfony/yaml": "^3.0",
        "barryvdh/laravel-debugbar": "^2.0",
        "barryvdh/laravel-ide-helper": "^2.1",
        "guzzlehttp/guzzle": "^6.2",
        "backpack/base": "^0.7.14",
        "backpack/crud": "^3.1",
        "backpack/permissionmanager": "^2.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^2.12",
        "phpunit/phpunit": "^6.5",
        "phpspec/phpspec": "~2.1",
        "backpack/generators": "^1.1",
        "laracasts/generators": "^1.1"
    },
    "autoload": {
        "classmap": [
            "database"
        ],
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": [
            ]
        }
    },
    "scripts": {
        "t3g:test:php:unit": [
            "phpunit -c ../Build/UnitTests.xml --log-junit logs/phpunit.xml"
        ],
        "t3g:test": [
            "@t3g:test:php:unit"
        ],
        "t3g:cgl": [
            "php-cs-fixer fix --config ../Build/.php_cs.dist --format=junit > logs/php-cs-fixer.xml"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump"
        ],
        "post-install-cmd": [
            "php artisan clear-compiled",
            "php artisan optimize"
        ],
        "post-update-cmd": [
            "php artisan clear-compiled",
            "php artisan optimize"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "bin-dir": "bin",
        "optimize-autoloader": true,
        "platform": {
            "php": "7.2.4"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
