{#
 # A task of the page "Get involved" as a card: an icon, the title, what to do, what it takes, the first items as
 # rows of the size "xs", see _partials/row/, and a button to all of them.
 # Expects: id, icon, title, text, chips (time and skill), url (the list or search with the same filter), items (a
 #          SearchResult), kind ("issue" or "change"), empty (the text without items)
 # Optional: known, what all items have in common, left out of their rows, see _partials/row/;
 #           guide, a page of the Contribution Guide on the task: url and label
 #}
{% set shown = 3 %}
<section class="info-card task-card" aria-labelledby="{{ id }}">
    <span class="info-card-tile" aria-hidden="true">{{ icon(icon) }}</span>
    <h3 class="info-card-title" id="{{ id }}">{{ title }}</h3>
    <p class="info-card-text">
        {{ text }}
        {% if guide is defined %}
            <a href="{{ guide.url }}" target="_blank" rel="noopener">{{ guide.label }}</a>
        {% endif %}
    </p>
    <p class="task-card-chips">
        <span class="effort-chip effort-chip-time" title="What it takes">{{ chips.time }}</span>
        <span class="effort-chip" title="What you need">{{ chips.skill }}</span>
    </p>
    {% if items is empty %}
        <p class="task-card-empty">{{ empty }}</p>
    {% else %}
        <ul class="task-card-items">
            {% for item in items|slice(0, shown) %}
                <li>
                    {% if kind == 'change' %}
                        {% include '_partials/row/change.html.twig' with {'change': item, 'size': 'xs', 'known': known ?? []} only %}
                    {% else %}
                        {% include '_partials/row/issue.html.twig' with {'issue': item, 'size': 'xs', 'known': known ?? []} only %}
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    {% endif %}
    <a class="info-card-link" href="{{ url }}">
        {{- items.total > 0 ? 'Show all ' ~ items.total : 'Show the list' }} {{ icon('actions-arrow-right') -}}
    </a>
</section>
