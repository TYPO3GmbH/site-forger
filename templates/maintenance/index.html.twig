{#
 # The page while Elasticsearch does not answer, see App\Subscriber\MaintenanceSubscriber. A page of its own over the
 # whole window, without the layout: the menu and its parts need nothing that may be down. It tells only that Forger
 # is under maintenance. Admins do not see it: they log in at /login, which stays open.
 #}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title>Maintenance - Forger</title>
    <link rel="shortcut icon" href="{{ asset('bundles/template/images/favicon.ico', 'template') }}">
    <style>
        html, body { height: 100%; margin: 0; }
        body {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
            box-sizing: border-box;
            background: #f4f4f4;
            color: #313131;
            font: 16px/1.6 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        }
        .maintenance {
            max-width: 480px;
            text-align: center;
        }
        .maintenance-brand {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 32px;
            font-size: 1.25rem;
            font-weight: 600;
        }
        .maintenance-brand img { height: 32px; }
        .maintenance-title {
            margin: 0 0 12px;
            font-size: 2rem;
            line-height: 1.2;
        }
        .maintenance-text { margin: 0; color: #5a5a5a; }
        .maintenance::after {
            content: "";
            display: block;
            width: 64px;
            height: 4px;
            margin: 32px auto 0;
            border-radius: 2px;
            background: #ff8700;
        }
        @media (prefers-color-scheme: dark) {
            body { background: #1c1c1c; color: #f0f0f0; }
            .maintenance-text { color: #bdbdbd; }
        }
    </style>
</head>
<body>
    <main class="maintenance">
        <div class="maintenance-brand">
            <img src="{{ asset('bundles/template/images/typo3-soul.svg', 'template') }}" alt="TYPO3">
            <span>Forger</span>
        </div>
        <h1 class="maintenance-title">We are under maintenance</h1>
        <p class="maintenance-text">Forger is back in a few minutes. Please try again later.</p>
    </main>
</body>
</html>
