{% extends 'base.html.twig' %}
{% block title %}#{{ issue.id }} {{ issue.subject }}{% endblock %}
{% block breadcrumb %}
    {% import '_macros/breadcrumb.html.twig' as breadcrumb %}
    {{ breadcrumb.trail([{'label': 'Issues', 'url': path('search_search')}, {'label': '#' ~ issue.id}]) }}
{% endblock %}
{% block body %}
    {% import '_macros/status.html.twig' as status %}
    {% import '_macros/refresh.html.twig' as refresh %}
    {% import '_macros/detail.html.twig' as detail %}
    {% import '_macros/user.html.twig' as user %}
    {% set tracker = issue_tracker(issue.tracker.name ?? null) %}
    {% import '_macros/timeline.html.twig' as timeline %}
    {# The history as Relations::historyOf() leaves it #}
    {% set history = history ?? [] %}
    {% set botCount = history|filter(journal => journal.isByBot)|length %}
    {# How a change belongs to the issue: its commit message resolves or names it, or a comment links it #}
    {% set relations = {'Resolves': 'Resolves this issue', 'Related': 'Related to this issue', 'Linked': 'Linked in a comment'} %}

    <div class="content-section content-section-small">
        <div class="container">
            <article class="overview detail">
                <header class="detail-header">
                    <div class="detail-header-main">
                        <div class="detail-tags">
                            <span class="detail-kind kind-issue">{{ icon('actions-list') }}Issue</span>
                            <span class="tag-label tag-label-{{ tracker.severity ?? 'default' }}">{{ tracker.label ?? issue.tracker.name ?? 'Issue' }}</span>
                            {{ status.issue(issue.status.name ?? null) }}
                            {{ status.issueActivity(issue) }}
                        </div>
                        <h1 class="detail-title"><span class="detail-number">#{{ issue.id }}</span>{{ issue.subject }}</h1>
                        <p class="detail-meta">
                            {{ user.inline(issue.author ?? null, url: detail.issueSearch('author', user_key(issue.author ?? null)), title: 'Issues by them', role: 'Author') }}
                            <span title="{{ issue.createdOn }}">{{ relativetime(to_datetime(issue.createdOn)) }}</span>
                            <span title="{{ issue.updatedOn }}">updated {{ relativetime(to_datetime(issue.updatedOn)) }}</span>
                        </p>
                    </div>
                    <div class="detail-actions">
                        <a class="btn btn-sm btn-default" href="{{ forge_issue_url(issue.id) }}" target="issue{{ issue.id }}">{{ icon('actions-window-open') }} Open in Forge</a>
                        {# The marked and the similar open issues, see DuplicateGroups #}
                        {% set duplicateCount = duplicates.offered ?? 0 %}
                        {% if duplicateCount > 0 %}
                            <a class="btn btn-sm btn-primary duplicates-button" href="{{ path('issue_duplicates', {'id': issue.id}) }}">
                                {{- icon('actions-duplicates') }} Possible duplicates <span class="detail-count">{{ duplicateCount }}</span>
                            </a>
                        {% endif %}
                        {{ refresh.issue(issue.id) }}
                    </div>
                </header>

                <div class="detail-body">
                    <div class="detail-main">
                        <section class="detail-section" aria-labelledby="description-title">
                            <h2 id="description-title" class="detail-section-title">Description</h2>
                            {% if (issue.description ?? '') is not empty %}
                                <div class="detail-text">{{ issue.description|forgeMarkdown(issue.attachments) }}</div>
                            {% else %}
                                <p class="detail-empty">No description.</p>
                            {% endif %}
                        </section>

                        <section class="detail-section" aria-labelledby="changes-title">
                            <h2 id="changes-title" class="detail-section-title">Reviews <span class="detail-count">{{ changes|length + unknownChanges|length }}</span></h2>
                            {% if changes is not empty %}
                                <ul class="row-list">
                                    {% for change in changes %}
                                        <li>{% include '_partials/row/change.html.twig' with {'change': change.change, 'relation': relations[change.relation] ?? change.relation} only %}</li>
                                    {% endfor %}
                                </ul>
                            {% endif %}
                            {% if unknownChanges is not empty %}
                                <p class="detail-empty">
                                    Linked, but not in Forger:
                                    {% for number in unknownChanges %}
                                        <a href="{{ gerrit_change_url(number) }}" target="gerrit{{ number }}">Change {{ number }}</a>{{ not loop.last ? ', ' }}
                                    {% endfor %}
                                </p>
                            {% endif %}
                            {% if changes is empty and unknownChanges is empty %}
                                <p class="detail-empty">
                                    No change resolves or names this issue in its commit message, and no comment links one.
                                </p>
                            {% endif %}
                        </section>

                        {% if (subtasks ?? []) is not empty %}
                            <section class="detail-section" aria-labelledby="subtasks-title">
                                <h2 id="subtasks-title" class="detail-section-title">Subtasks <span class="detail-count">{{ subtasks|length }}</span></h2>
                                <ul class="row-list">
                                    {% for subtask in subtasks %}
                                        <li>{% include '_partials/row/issue.html.twig' with {'issue': subtask} only %}</li>
                                    {% endfor %}
                                </ul>
                            </section>
                        {% endif %}

                        {# The relations of Forge other than duplicates, see Relations::relatedIssuesOf() #}
                        {% if (relatedIssues ?? []) is not empty %}
                            <section class="detail-section" aria-labelledby="related-issues-title">
                                <h2 id="related-issues-title" class="detail-section-title">Related issues <span class="detail-count">{{ relatedIssues|length }}</span></h2>
                                <ul class="row-list">
                                    {% for item in relatedIssues %}
                                        <li>{% include '_partials/row/related_issue.html.twig' with {'item': item, 'relation': item.relation} only %}</li>
                                    {% endfor %}
                                </ul>
                            </section>
                        {% endif %}

                        {% if issue.attachments is not empty %}
                            <section class="detail-section" aria-labelledby="attachments-title">
                                <h2 id="attachments-title" class="detail-section-title">
                                    {#- -#}Files <span class="detail-count">{{ issue.attachments|length }}</span>
                                {#- -#}</h2>
                                <ul class="row-list">
                                    {% for file in issue.attachments %}
                                        <li>
                                            {% include '_partials/row/attachment.html.twig' with {'file': file} only %}
                                        </li>
                                    {% endfor %}
                                </ul>
                            </section>
                        {% endif %}

                        {% if history is not empty %}
                            <section class="detail-section timeline" aria-labelledby="history-title">
                                {{ timeline.header('history-title', 'History', history|length, botCount, 'Gerrit') }}
                                {# In the order of Forge, the last ones open, the earlier ones on a click #}
                                {% set recent = 25 %}
                                {% set earlier = max(0, history|length - recent) %}
                                {% if earlier > 0 %}
                                    {% set earlierEntries = history|slice(0, earlier) %}
                                    {% set earlierOfPeople = earlierEntries|filter(journal => not journal.isByBot)|length %}
                                    <details class="timeline-earlier{{ earlierOfPeople == 0 ? ' is-bots-only' }}">
                                        {{ timeline.earlier(earlierOfPeople, earlier) }}
                                        {{ _self.history(earlierEntries, issue.attachments) }}
                                    </details>
                                {% endif %}
                                {{ _self.history(history|slice(earlier), issue.attachments) }}
                            </section>
                        {% endif %}
                    </div>

                    <aside class="detail-aside" aria-label="Details">
                        <dl class="detail-facts">
                            {# The issue this one is a subtask of: its page, or Forge when Forger does not have it #}
                            {% if (parent ?? null) is not null %}
                                {% set parentUrl = parent.issue is not null ? issue_path(parent.id) : forge_issue_url(parent.id) %}
                                {{ detail.fact('Parent task', '#' ~ parent.id ~ (parent.issue is not null ? ' ' ~ parent.issue.subject), parentUrl) }}
                            {% endif %}
                            {# Each value leads to the open issues with it, as the filter of the search shows them. Not the project: Forger has only TYPO3 Core #}
                            {{ detail.person('Assigned to', issue.assignedTo ?? null, detail.issueSearch('assigned_to', user_key(issue.assignedTo ?? null)), 'Issues assigned to them') }}
                            {{ detail.person('Author', issue.author ?? null, detail.issueSearch('author', user_key(issue.author ?? null)), 'Issues by them') }}
                            {{ detail.fact('Priority', issue.priority.name ?? null, detail.issueSearch('priority', issue.priority.name ?? ''), 'Issues with this priority') }}
                            {{ detail.fact('Category', issue.category.name ?? null, detail.issueSearch('category', issue.category.name ?? ''), 'Issues in this category') }}
                            {{ detail.fact('Target version', issue.fixedVersion.name ?? null, detail.issueSearch('target_version', issue.fixedVersion.name ?? ''), 'Issues for this version') }}
                            {{ detail.fact('TYPO3 version', issue.typo3Version ?? null, detail.issueSearch('typo3_version', issue.typo3Version ?? ''), 'Issues for this TYPO3 version') }}
                            {{ detail.fact('PHP version', issue.phpVersion ?? null, detail.issueSearch('php_version', issue.phpVersion ?? ''), 'Issues for this PHP version') }}
                            {{ detail.fact('Complexity', issue.complexity ?? null) }}
                            {% if (issue.tags ?? []) is not empty %}
                                <div class="detail-fact">
                                    <dt>Tags</dt>
                                    <dd class="detail-tags">{% for tag in issue.tags %}<a class="tag-label" href="{{ detail.issueSearch('tags', tag) }}" title="Issues with this tag">{{ tag }}</a>{% endfor %}</dd>
                                </div>
                            {% endif %}
                        </dl>
                    </aside>
                </div>
            </article>
        </div>
    </div>

{% endblock %}

{#
 # The history of an issue as a timeline, see App\Document\IssueJournal: who changed which fields, the comment of a
 # person in a box below. Gerrit names each patch set with its change. Relations::historyOf() left out the issues
 # Forger does not have, they may be private. files: the attachments of the issue, for the images of the comments.
 #}
{% macro history(journals, files) %}
    {% import '_macros/user.html.twig' as user %}
    <ol class="timeline-list">
        {% for journal in journals %}
            {% set changes = journal.changes %}
            <li class="timeline-entry{{ journal.isByBot ? ' is-bot' }}">
                <span class="timeline-avatar" aria-hidden="true">{{ user_avatar(journal.author, 32) }}</span>
                <div class="timeline-body">
                    <p class="timeline-line">
                        <strong class="timeline-name">{{ journal.author.name ?? 'Forge' }}</strong>
                        {% if journal.change is not null %}
                            <span class="timeline-event">pushed patch set {{ journal.patchSet }} for {{ journal.branch }} to</span>
                            <a href="{{ change_path(journal.change) }}">change {{ journal.change }}</a>
                        {% elseif journal.hasComment %}
                            <span class="timeline-event">{{ changes is empty ? 'commented' : 'commented and changed' }}</span>
                        {% elseif changes is not empty %}
                            <span class="timeline-event">changed</span>
                        {% endif %}
                        {% for change in changes %}
                            {{ _self.change(change) }}
                        {% endfor %}
                        {% if journal.createdOn is not null %}
                            <span class="timeline-time" title="{{ journal.createdOn }}">{{ relativetime(date(journal.createdOn)) }}</span>
                        {% endif %}
                        {% if journal.isByBot and journal.change is null and journal.notes is not empty %}
                            <span class="timeline-note">{{ journal.notes|autolink }}</span>
                        {% endif %}
                    </p>
                    {% if journal.hasComment %}
                        <div class="timeline-comment detail-text">{{ journal.notes|forgeMarkdown(files) }}</div>
                    {% endif %}
                </div>
            </li>
        {% endfor %}
    </ol>
{% endmacro %}

{#
 # A changed field as a chip: the name, the value before struck through, the value after. A relation or a file that
 # goes is struck through as a whole.
 #}
{% macro change(change) %}
    {% import '_macros/user.html.twig' as user %}
    {% set field = change.field.name %}
    <span class="timeline-change">
        {%- if field in ['RELATION', 'PARENT', 'SUBTASK'] -%}
            {%- set number = change.to ?? change.from -%}
            {%- set link -%}<a href="{{ issue_path(number) }}">#{{ number }}</a>{%- endset -%}
            {%- if change.isRemoved %}<s>{{ change.name }} {{ link }}</s>{% else %}{{ change.name }} {{ link }}{% endif -%}
        {%- elseif field == 'ATTACHMENT' -%}
            {%- if change.isRemoved %}<s>{{ change.from }}</s>{% else %}attached {{ change.to }}{% endif -%}
        {%- elseif field == 'ASSIGNEE' -%}
            {%- if change.to is null -%}
                removed the assignee
            {%- else -%}
                assigned to {{ user.inline(forge_person(change.to), 20) ?: 'user ' ~ change.to }}
            {%- endif -%}
        {%- elseif not change.field.showsValues -%}
            {{ change.name }}
        {%- else -%}
            {{ change.name }}
            {%- if change.from is not null %} <s>{{ change.from }}</s>{% endif -%}
            {%- if change.to is not null %} <span class="timeline-change-to">{{ change.to }}</span>{% endif -%}
        {%- endif -%}
    </span>
{% endmacro %}
