{% extends 'base.html.twig' %}
{% import '_macros/buttons.html.twig' as buttons %}
{% block title %}Sprint Boards{% endblock %}
{% block page_title %}Sprint Boards{% endblock %}
{% block breadcrumb %}
    {% import '_macros/breadcrumb.html.twig' as breadcrumb %}
    {{ breadcrumb.trail([{'label': 'Sprints', 'url': path('sprint_overview')}, {'label': 'Sprint boards', 'url': path('sprint_list')}, {'label': edit ? 'Edit ' ~ sprint.name : 'New sprint board'}]) }}
{% endblock %}
{% block body %}

    <div class="content-section">
        <div class="container">
            <div class="header">
                <h2 class="header-headline">
                    {% if edit is defined and edit %}
                        Edit a Sprint Board
                    {% else %}
                        Add a Sprint Board
                    {% endif %}
                </h2>
                {% if wizardAvailable is defined and wizardAvailable %}
                    <div class="header-actions">
                        {{ buttons.link(
                            sprint.id ? path('sprint_edit', {'sprintId': sprint.id}) : path('sprint_create', sprint.category ? {'category': sprint.category.identifier} : {}),
                            'Use the wizard',
                            'secondary',
                            'actions-open'
                        ) }}
                    </div>
                {% endif %}
            </div>
            {% if wizardAvailable is defined and not wizardAvailable %}
                {% include '_partials/alert.html.twig' with {'message': 'The query of this board does not filter by anything the wizard offers, so it can only be edited as YAML.', 'style': 'info'} only %}
            {% endif %}
            <div class="row">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-body">
                            {{ form_start(form) }}
                            {{ form_widget(form) }}
                            {{ form_end(form) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

{% endblock %}
