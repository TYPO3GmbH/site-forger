{% extends 'base.html.twig' %}
{% block title %}Delete {{ sprint.name }}{% endblock %}
{% block page_title %}Delete the board{% endblock %}
{% block breadcrumb %}
    {% import '_macros/breadcrumb.html.twig' as breadcrumb %}
    {{ breadcrumb.trail([
        {'label': 'Boards', 'url': path('sprint_overview')},
        {
            'label': sprint.name,
            'url': path('sprint', {'category': sprint.category.identifier, 'board': sprint.identifier}),
        },
        {'label': 'Delete'},
    ]) }}
{% endblock %}
{#
 # Asks before a sprint board goes. The deletion is a POST with a token, see SprintController::deleteSprint().
 # Expects: sprint (App\Entity\SprintBoard)
 #}
{% block body %}
    {% set board = path('sprint', {'category': sprint.category.identifier, 'board': sprint.identifier}) %}
    {% set token = csrf_token(constant('App\\Controller\\SprintController::DELETE_TOKEN_ID')) %}
    <div class="content-section content-section-small">
        <div class="container">
            <div class="info-card sprint-delete">
                <p class="info-card-text">
                    Do you want to delete the board <strong>{{ sprint.name }}</strong>? Its issues stay in
                    Forge, only the board goes.
                </p>
                <form
                    class="sprint-delete-actions"
                    action="{{ path('sprint_delete', {'uuid': sprint.uuid}) }}"
                    method="post"
                >
                    <input type="hidden" name="_token" value="{{ token }}">
                    <button type="submit" class="btn btn-danger">{{ icon('actions-delete') }} Delete the board</button>
                    <a class="btn btn-default" href="{{ board }}">Keep it</a>
                </form>
            </div>
        </div>
    </div>
{% endblock %}
