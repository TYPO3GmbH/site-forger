{% extends 'base.html.twig' %}
{% block title %}Review Board{% endblock %}
{% block body %}

    <div class="content-section content-section-smallest bg-dark">
        <div class="container-fluid text-center">
            {% if menu|length > 0 %}
                <div class="btn-group">
                    {% for boardNav in menu %}
                        <a href="{{ path("sprint_reviews", {"reviewType":boardNav.id}) }}" class="btn btn-default {{ (boardNav.active) ? 'active' : '' }}">
                            {{ boardNav.name }} ({{ boardNav.count }})
                        </a>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>

    <div class="board">
        <div class="board-container">
            {% for columnName, cardList in cards %}
                <div class="board-column" id="column-{{ columnName }}">
                    <div class="board-column-header">
                        {% if columnName == "missesBoth" %}
                            <h3 class="board-colum-header-headline"><strong>{{ cardList|length }}</strong> Unchecked</h3>
                        {% elseif columnName == "missesCodeReview" %}
                            <h3 class="board-colum-header-headline"><strong>{{ cardList|length }}</strong> Miss Code Review</h3>
                        {% elseif columnName == "missesTesting" %}
                            <h3 class="board-colum-header-headline"><strong>{{ cardList|length }}</strong> Miss Testing</h3>
                        {% elseif columnName == "hasPlusOne" %}
                            <h3 class="board-colum-header-headline"><strong>{{ cardList|length }}</strong> Has Votes</h3>
                        {% elseif columnName == "mergeConflict" %}
                            <h3 class="board-colum-header-headline"><strong>{{ cardList|length }}</strong> Merge Conflicts</h3>
                        {% elseif columnName == "blocked" %}
                            <h3 class="board-colum-header-headline"><strong>{{ cardList|length }}</strong> Blocked</h3>
                        {% else %}
                            <h3 class="board-colum-header-headline"><strong>{{ cardList|length }}</strong> Unclear</h3>
                        {% endif %}
                    </div>
                    <div class="board-column-content">
                        {% for card in cardList %}
                            {% include '_partials/review_card.html.twig' with {'card':card, 'mode': ''} %}
                        {% endfor %}
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>

{% endblock %}
