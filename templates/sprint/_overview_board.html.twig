{#
 # A sprint board on the overview: its issues by state, as figures and as a segmented bar.
 # count is null if the query of the board cannot be read.
 #}
{% set states = {'closed': 'Done', 'review': 'Review', 'blocked': 'Blocked', 'open': 'Open'} %}
<a class="overview-stat sprint-overview-board" href="{{ path('sprint', {'category': board.category.identifier, 'sprintId': board.id}) }}">
    <span class="overview-stat-label">{{ board.name }}</span>
    {% if count is null %}
        <span class="overview-stat-note">The query of this board cannot be read.</span>
    {% elseif count.total == 0 %}
        <span class="overview-stat-value">0</span>
        <span class="overview-stat-note">No issues match this board.</span>
    {% else %}
        <span class="overview-stat-value">{{ count.percentage ?? 0 }}%</span>
        <span class="overview-stat-note">{{ count.closed }} of {{ count.total }} issues done</span>
        <span class="overview-segments" aria-hidden="true">
            {% for state in states|keys|filter(state => attribute(count, state) > 0) %}
                <span class="overview-segment sprint-overview-segment-{{ state }}" style="flex-grow: {{ attribute(count, state) }}"></span>
            {% endfor %}
        </span>
        <span class="overview-legend">
            {% for state, label in states %}
                <span class="overview-legend-item"><span class="overview-legend-swatch sprint-overview-segment-{{ state }}"></span>{{ label }} <strong>{{ attribute(count, state) }}</strong></span>
            {% endfor %}
        </span>
    {% endif %}
</a>
