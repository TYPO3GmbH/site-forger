{% extends 'base.html.twig' %}
{# Over the whole width, as its content: the title too, see base.html.twig #}
{% set wide = true %}
{% block title %}{{ boardInfo is not empty ? boardInfo : categoryName }} - Sprints{% endblock %}
{# The board below its category, as the menu has the category only #}
{% block breadcrumb %}
    {% import '_macros/breadcrumb.html.twig' as breadcrumb %}
    {# The category leads to its boards on the overview #}
    {% set categoryItem = {'label': categoryName, 'url': path('sprint_overview') ~ '#sprints-' ~ category} %}
    {{ breadcrumb.trail(
        [{'label': 'Sprints', 'url': path('sprint_overview')}, categoryItem]
            |merge(boardInfo is not empty ? [{'label': boardInfo}] : [])
    ) }}
{% endblock %}
{#
 # A sprint board: its name with its progress, then its issues in columns by their state, see
 # SprintBoards::cards(). The bar and its colors are those of the overview, see _overview_board.html.twig.
 # Expects: cards (list<BoardColumn>), boardInfo, progress, category, categoryName, sprintId
 #}
{% block body %}
    {% set parts = 'sprint/_board_parts.html.twig' %}
    {# The head and the columns on one white ground, below the gray band of the breadcrumb. The parts that change
       with the issues load again every minute, see assets/ts/sprint/live-board.ts #}
    <div
        class="sprint-board-page"
        id="sprint-board-page"
        data-board-refresh="{{ path('sprint_columns', {'category': category, 'sprintId': sprintId}) }}"
    >
        <header class="sprint-board-header">
            <div>
                <h1 class="sprint-board-title">{{ boardInfo }}</h1>
                {{ block('summary', parts) }}
            </div>
            <div class="sprint-board-actions">
                {# Shown by assets/ts/sprint/live-board.ts once it loads the board again every minute #}
                <span class="sprint-board-live" data-board-updated hidden></span>
                {# Buttons with an icon only: their name is in their title and, for screen readers, in a hidden
                   text #}
                <div class="sprint-board-tools">
                    {# Shown by assets/ts/fullscreen/fullscreen.ts if the browser can #}
                    <button
                        type="button"
                        class="sprint-board-tool"
                        data-fullscreen="#sprint-board-page"
                        title="Full screen"
                        hidden
                    >
                        {{- icon('actions-fullscreen') }}<span class="sr-only" data-fullscreen-label>Full screen</span>
                    </button>
                    {% if sprintId > 0 and is_granted('ROLE_FORGER_MANAGEMENT') %}
                        <a
                            class="sprint-board-tool sprint-board-manage"
                            href="{{ path('sprint_edit', {'sprintId': sprintId}) }}"
                            title="Edit the board"
                        >
                            {{- icon('actions-open') }}<span class="sr-only">Edit the board</span>
                        </a>
                        <a
                            class="sprint-board-tool sprint-board-manage sprint-board-delete"
                            href="{{ path('sprint_delete_confirm', {'sprintId': sprintId}) }}"
                            title="Delete the board"
                        >
                            {{- icon('actions-delete') }}<span class="sr-only">Delete the board</span>
                        </a>
                    {% endif %}
                </div>
            </div>
        </header>
        {{ block('progress', parts) }}
        {{ block('columns', parts) }}
    </div>
{% endblock %}
