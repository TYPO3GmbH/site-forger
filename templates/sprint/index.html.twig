{% extends 'base.html.twig' %}

{% block title %}Hello SprintController!{% endblock %}

{% block body %}
<div class="content-section bg-transparent">
    <div class="container-fluid">
        <div class="row">
            <div class="btn-group">
                {% for boardNav in menu %}
                    <a href="{{ path("sprint", {"sprint":boardNav.id}) }}" class="btn btn-default {{ (boardNav.active) ? 'active' : '' }}" title="{{boardNav.count.open}} open, {{boardNav.count.closed}} closed, {{boardNav.count.total}} total">
                        {{ boardNav.title }} ({{boardNav.count.percentage}}%)
                    </a>
                {% endfor %}
            </div>
        </div>
        {% if cards|length > 0 %}
            <h3>{{ boardInfo }} ({{ progress.total }})</h3>
            <div class="progress">
                {% for bar in progress.sections %}
                    <div
                            class="progress-bar progress-bar-{{ bar.classes }}"
                            role="progressbar"
                            aria-valuenow="60"
                            aria-valuemin="0"
                            aria-valuemax="100"
                            style="width: {{ bar.value }}%;">
                        {{ bar.label }}
                    </div>
                {% endfor %}
            </div>
            <div class="row">
                {% for columnName, cardList in cards %}
                    <div class="col">
                        <h3 class="status-{{ columnName }}"><strong>{{ cardList|length }}</strong> {{ columnName }}</h3>
                        <div class="cards">
                            {% for card in cardList %}
                                {% if columnName == "Review" %}
                                    {% include '/_partials/ReviewCard.html.twig' with {'card':card, 'mode': ''} %}
                                {% else %}
                                    {% include '/_partials/BoardCard.html.twig' with {'card':card}  %}
                                {% endif %}
                            {% endfor %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
