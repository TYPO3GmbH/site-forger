{% extends 'base.html.twig' %}
{% block title %}Hello SprintController!{% endblock %}
{% block body %}

    <div class="content-section content-section-smallest bg-dark">
        <div class="container-fluid text-center">
            {% if menu|length > 0 %}
                <div class="btn-group">
                    {% for boardNav in menu %}
                        <a href="{{ path("sprint", {"category":category, "sprint":boardNav.id}) }}" class="btn btn-default {{ (boardNav.active) ? 'active' : '' }}" title="{{boardNav.count.open}} open, {{boardNav.count.closed}} closed, {{boardNav.count.total}} total">
                            {{ boardNav.title }} ({{ (boardNav.count.percentage is defined) ? boardNav.count.percentage : ''}}%)
                        </a>
                    {% endfor %}
                </div>
            {% else %}
                <div class="alert alert-info">No boards have been defined for this category, yet. If you think there should be something here, get in touch with us on Slack</div>
            {% endif %}
        </div>
    </div>

    {% if sprintId is defined and sprintId > 0 and is_granted('ROLE_ADMIN') %}
        <div class="float-right">
            <a href="{{ path('sprint_edit', {'sprintId': sprintId}) }}">
                <button class="btn btn-primary">Edit Sprint</button>
            </a>
            <a href="{{ path('sprint_delete_confirm', {'sprintId': sprintId}) }}">
                <button class="btn btn-danger">Delete Sprint</button>
            </a>
        </div>
    {% endif %}

    {% if cards|length > 0 %}
        <div class="content-section content-section-smallest">
            <div class="container-fluid">
                <h3>{{ boardInfo }} ({{ progress.total }})</h3>
                <div class="progress">
                    {% for bar in progress.sections %}
                        <div
                                class="progress-bar progress-bar-{{ bar.classes }}"
                                role="progressbar"
                                aria-valuenow="60"
                                aria-valuemin="0"
                                aria-valuemax="100"
                                style="width: {{ bar.value }}%;">
                            {{ bar.label }}
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
        <div class="board">
            <div class="board-container">
                {% for columnName, cardList in cards %}
                    <div class="board-column">
                        <div class="board-column-header">
                            <h3 class="board-colum-header-headline status-{{ columnName }}"><strong>{{ cardList|length }}</strong> {{ columnName }}</h3>
                        </div>
                        <div class="board-column-content">
                            {% for card in cardList %}
                                {% if columnName == "Review" %}
                                    {% include '_partials/review_card.html.twig' with {'card':card, 'mode': ''} %}
                                {% else %}
                                    {% include '_partials/board_card.html.twig' with {'card':card}  %}
                                {% endif %}
                            {% endfor %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    {% endif %}

{% endblock %}
