{#
 # The frame of the views of My Work: the overview, the switch between the Gerrit changes and the issues, named as
 # the tabs of the search and the menu: "Reviews" and "Issues", the interests of the user, and the people the user
 # follows, the search in it. Whether closed work is shown says the checkbox in the search, as in the search. Who
 # the work is found for only an empty list says, as the rows say how they belong to the person.
 # Expects: view ("overview", "changes", "issues", "interests" or "following"), email, name, includeClosed, query,
 # openChanges, openIssues, followingCount
 #}
{% extends 'base.html.twig' %}
{% block title %}My Work{% endblock %}

{#
 # One state chip of a filter bar.
 #}
{% macro chip(label, count, href, active, closed) %}
    <a href="{{ href }}" class="chip{{ active ? ' is-active' }}{{ closed ? ' is-closed' }}"{% if active %} aria-current="true"{% endif %}>
        {{ label }} <span class="chip-count">{{ count }}</span>
    </a>
{% endmacro %}

{#
 # The search in the work of the person, with the checkbox of the search whether closed work counts, too. New words keep
 # the filter and the order: their parameters as hidden fields.
 #}
{% macro search(route, query, parameters, placeholder, includeClosed, closedTitle) %}
    {% import '_macros/search.html.twig' as searchField %}
    {{ searchField.field(path(route), query, {
        'id': 'mywork-search',
        'small': true,
        'label': 'Search in my work',
        'placeholder': placeholder,
        'hidden': parameters|filter((v, k) => k not in ['query', 'state']),
        'closed': {'name': 'state', 'value': 'all', 'checked': includeClosed, 'title': closedTitle},
    }) }}
{% endmacro %}

{% block body %}
    {% set route = 'my_' ~ view %}
    {# The tabs keep the search words #}
    {% set queryParams = (query ?? '') is not empty ? {'query': query} : {} %}
    <div class="content-section content-section-small mywork mywork-view-{{ view }}">
        <div class="container">
            {# No orange band, as on the search: the breadcrumb and the tabs say where the page is #}
            <h1 class="sr-only">My Work</h1>

            <nav class="view-tabs" aria-label="My Work">
                <a href="{{ path('my_overview') }}" class="view-tab is-overview{{ view == 'overview' ? ' is-active' }}"
                   {%- if view == 'overview' %} aria-current="page"{% endif %}>
                    {{ icon('actions-viewmode-tiles') }}
                    <span>Overview</span>
                </a>
                <a href="{{ path('my_changes', queryParams) }}" class="view-tab is-changes{{ view == 'changes' ? ' is-active' }}"{% if view == 'changes' %} aria-current="page"{% endif %}>
                    {{ icon('actions-code-pull-request') }}
                    <span>Reviews</span>
                    <span class="view-tab-count" title="{{ queryParams is empty ? 'Open reviews' : 'Open reviews found' }}">{{ openChanges }}</span>
                </a>
                <a href="{{ path('my_issues', queryParams) }}" class="view-tab is-issues{{ view == 'issues' ? ' is-active' }}"{% if view == 'issues' %} aria-current="page"{% endif %}>
                    {{ icon('actions-list') }}
                    <span>Issues</span>
                    <span class="view-tab-count" title="{{ queryParams is empty ? 'Open issues' : 'Open issues found' }}">{{ openIssues }}</span>
                </a>
                <a href="{{ path('my_interests') }}" class="view-tab is-interests{{ view == 'interests' ? ' is-active' }}"
                   {%- if view == 'interests' %} aria-current="page"{% endif %}>
                    {{ icon('actions-filter') }}
                    <span>Interests</span>
                </a>
                <a href="{{ path('my_following') }}" class="view-tab is-following{{ view == 'following' ? ' is-active' }}"
                   {%- if view == 'following' %} aria-current="page"{% endif %}>
                    {{ icon('actions-users') }}
                    <span>Following</span>
                    <span class="view-tab-count" title="People you follow">{{ followingCount }}</span>
                </a>
            </nav>

            {% block view %}{% endblock %}

        </div>
    </div>
{% endblock %}
