{#
 # Gerrit changes as a list, in the rows of the review lists and the search. Each row names its state.
 # Expects: changes (list of change documents)
 #}
<ul class="mywork-list">
    {% for change in changes %}
        <li>{% include '_partials/row/change.html.twig' with {'change': change, 'detailed': true} only %}</li>
    {% endfor %}
</ul>
