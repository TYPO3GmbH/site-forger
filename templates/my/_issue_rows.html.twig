{#
 # Forge issues as a list, in the rows of the search. Each row names its status, and on the right whether the issue
 # is assigned to the logged-in user.
 # Expects: issues (list of issue documents), name (the name of the logged-in user)
 #}
<ul class="mywork-list">
    {% for issue in issues %}
        <li>{% include '_partials/row/issue.html.twig' with {'issue': issue, 'size': 'l', 'viewer': name} only %}</li>
    {% endfor %}
</ul>
