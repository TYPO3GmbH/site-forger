{% extends '@Template/layout.html.twig' %}

{#
 # The description of a page for search engines and the previews of shared links: the block "description" of a
 # page, else what Forger is. The link leaves out the query, so a search or a list with filters names its page.
 #}
{% block metatags %}
    {% set request = app.request %}
    {% include '_partials/meta_tags.html.twig' with {
        'title': (block('title') is defined ? block('title')|metaText ~ ' - ' : '') ~ 'Forger',
        'description': block('description') is defined
            ? block('description')|metaText
            : 'Forger shows the issues of Forge and the reviews of Gerrit for the TYPO3 Core in one place:'
                ~ ' what waits for a review, what is new, and where you can help.',
        'url': request.schemeAndHttpHost ~ request.baseUrl ~ request.pathInfo,
        'image': request.schemeAndHttpHost ~ request.baseUrl ~ '/images/forger-share.png',
    } only %}
{% endblock %}

{# The layout of the template bundle has no block in the menu bar, the search dialog goes here #}
{% block subnavigation %}
    {% include '_partials/header_search.html.twig' %}
{% endblock %}

{#
 # Above the content and the messages: the trail of the block "breadcrumb" of a page, else the one of its item in the
 # menu, see App\Menu\Breadcrumb and _macros/breadcrumb.html.twig. It is a gray band of its own with a line below,
 # the same on every page: a frame of the template bundle, as wide as the menu above it, so it stays in its place
 # from page to page. Below it the block "page_title" of a page as its title on the gray of the page, see
 # _page-intro.scss, on its right the buttons of the block "page_actions", below it the line about the page of the
 # block "page_summary". Pages do not use the block "headline": the template bundle shows it in an orange band.
 #}
{% block header %}
    {# A page over the whole width ("wide") has its title there, too, else it would stand in from its content #}
    {% set wide = wide ?? false %}
    {% set container = wide ? 'container-fluid' : 'container' %}
    {% set trail = block('breadcrumb') is defined ? [] : menu_breadcrumb() %}
    {% if block('breadcrumb') is defined or trail is not empty %}
        {% frame with {'color': 'lighter', 'size': 'small', 'rulerAfter': true} %}
            {% if block('breadcrumb') is defined %}
                {{ block('breadcrumb') }}
            {% else %}
                {% import '_macros/breadcrumb.html.twig' as breadcrumb %}
                {{ breadcrumb.trail(trail) }}
            {% endif %}
        {% endframe %}
    {% endif %}
    {% if block('page_title') is defined %}
        <div class="page-intro-bar">
            <div class="{{ container }}">
                <header class="page-intro">
                    <h1 class="page-intro-title">{{ block('page_title') }}</h1>
                    {% if block('page_actions') is defined %}
                        <div class="page-intro-actions">{{ block('page_actions') }}</div>
                    {% endif %}
                    {% if block('page_summary') is defined %}
                        <p class="page-intro-summary">{{ block('page_summary') }}</p>
                    {% endif %}
                </header>
            </div>
        </div>
    {% endif %}
{% endblock %}

{% block javascripts %}
    {% include '_partials/refresh_form.html.twig' %}
    <script type="application/javascript" src="https://app.usercentrics.eu/latest/main.js" id="{{ usercentrics_id }}"></script>
{% endblock %}
