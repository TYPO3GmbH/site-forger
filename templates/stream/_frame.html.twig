{#
 # The frame of a page of the activity: <forger-activity> renders the filter and the view with the API, and keeps the
 # filter in the address, see assets/ts/activity/activity.ts. The stream is on /activity, the statistics are on
 # /statistics. A logged-in user can follow the person of the filter, see App\Controller\FollowController.
 # The statistics of one user in My Work give the keys of the accounts of the user, see
 # App\Controller\MyWorkController::statistics(): the board then counts their activity alone.
 # Expects: view ('stream' or 'statistics'), optional ownPeople (list of keys of people) and statisticsUrl
 #}
<forger-activity
    view="{{ view }}"
    stream-url="{{ path('activity_index') }}"
    statistics-url="{{ statisticsUrl ?? path('dashboard_statistics') }}"
    api-url="{{ path('api_v1_activity') }}"
    statistics-api-url="{{ path('api_v1_activity_statistics') }}"
    week-hours-api-url="{{ path('api_v1_activity_week_hours') }}"
    days-api-url="{{ path('api_v1_activity_days') }}"
    newcomers-api-url="{{ path('api_v1_activity_newcomers') }}"
    closed-years-api-url="{{ path('api_v1_activity_closed_years') }}"
    people-url="{{ path('activity_people') }}"
    {% if (ownPeople ?? []) is not empty %}
        own-person="{{ ownPeople|first }}"
        own-people="{{ ownPeople|join(',') }}"
        exchange-api-url="{{ path('api_v1_activity_exchange') }}"
        changes-url="{{ path('my_changes') }}"
    {% endif %}
    {% if is_granted('ROLE_USER') %}
        follow-url="{{ path('my_following_state') }}"
        follow-token="{{ csrf_token(constant('App\\Controller\\FollowController::CSRF_TOKEN_ID')) }}"
        followed-url="{{ path('my_following_people') }}"
        manage-url="{{ path('my_following') }}"
    {% endif %}
>
    <noscript>
        <p class="stream-empty">
            The activity needs JavaScript. The same data is in the
            <a href="{{ path('app.api_doc') }}">API</a>.
        </p>
    </noscript>
</forger-activity>
{% include 'stream/_definitions.html.twig' %}
