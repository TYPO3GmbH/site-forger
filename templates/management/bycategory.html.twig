{% extends 'base.html.twig' %}
{% block title %}Issues by Category{% endblock %}
{% block body %}

<div class="content-section bg-transparent">
    <div class="container">
        <h3>Issue Category View</h3>
        <table class="table-bordered table table-striped">
            <tr>
                <th>Category</th>
                <th>Bugs</th>
                <th>Features</th>
                <th>Tasks</th>
                <th>Stories</th>
                <th>Epics</th>
            </tr>
        {% for category, trackers in data %}
            <tr>
                <td>{{ category }}</td>
                {% for tracker,amount in trackers %}
                    <td>{{ (amount > 0) ? amount : '' }}</td>
                {% endfor %}
            </tr>
        {% endfor %}
        </table>
    </div>
</div>

{% endblock %}
