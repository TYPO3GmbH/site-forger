{% extends 'base.html.twig' %}
{% block title %}Issues by Category{% endblock %}
{% block headline %}Issue Category View{% endblock %}
{% block body %}

<div class="content-section bg-transparent">
    <div class="container">

        <div class="card">
            <div class="datatable">
                <table class="datatable-table">
                    <thead>
                        <tr>
                            <th scope="col">Category</th>
                            <th scope="col">Bugs</th>
                            <th scope="col">Features</th>
                            <th scope="col">Tasks</th>
                            <th scope="col">Stories</th>
                            <th scope="col">Epics</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for category, trackers in data %}
                            {% set categoryFilter = {(category|filterKey): 'true'} %}
                            <tr>
                                <th data-type="title">
                                    <a href="{{ path('search_search', {'filters': {'category': categoryFilter}}) }}" title="Show the open issues of {{ category }}">{{ category }}</a>
                                </th>
                                {% for tracker, amount in trackers %}
                                    <td>
                                        {% if amount > 0 %}
                                            <a href="{{ path('search_search', {'filters': {'category': categoryFilter, 'tracker': {(tracker|filterKey): 'true'}}}) }}" title="Show the open {{ tracker }} issues of {{ category }}">{{ amount }}</a>
                                        {% endif %}
                                    </td>
                                {% endfor %}
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>

{% endblock %}
