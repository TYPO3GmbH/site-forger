{% extends 'base.html.twig' %}
{% block title %}Interactions{% endblock %}
{% block headline %}Coreteam Review Activity{% endblock %}
{% block body %}

    <div class="content-section content-section-small">
        <div class="container-fluid">
            <div class="interactions">
                {% for monthKey, month in aggs %}
                    <div class="interactions-item">
                        <div class="datatable">
                            <table class="datatable-table datatable-table-compact">
                                <caption class="datatable-caption">{{ monthKey }}</caption>
                                <thead>
                                    <tr>
                                        <th scope="col">Name</th>
                                        <th scope="col"><i class="fas fa-fw fa-code" aria-hidden="true" data-toggle="tooltip" title="Added Patchset"></i><span class="sr-only">Added Patchset</span></th>
                                        <th scope="col"><i class="fas fa-fw fa-eye" aria-hidden="true" data-toggle="tooltip" title="Core Review"></i><span class="sr-only">Code Review</span></th>
                                        <th scope="col"><i class="fas fa-fw fa-thumbs-up" aria-hidden="true" data-toggle="tooltip" title="Verification"></i><span class="sr-only">Verification</span></th>
                                        <th scope="col"><i class="fas fa-fw fa-code-branch" aria-hidden="true" data-toggle="tooltip" title="Merge"></i><span class="sr-only">Merge</span></th>
                                        <th scope="col"><i class="fas fa-fw fa-trash" aria-hidden="true" data-toggle="tooltip" title="Abandon"></i><span class="sr-only">Abandon</span></th>
                                        <th scope="col"><i class="fas fa-fw fa-comment" aria-hidden="true" data-toggle="tooltip" title="Comment"></i><span class="sr-only">Comment</span></th>
                                    </tr>
                                </thead>
                                {% for committer, reviewTypes in month %}
                                    <tr>
                                        <th data-type="title">{{ committer }}</th>
                                        <td>{{ reviewTypes.core_review_patchset ?? '' }}</td>
                                        <td>{{ reviewTypes.core_review_codereview ?? '' }}</td>
                                        <td>{{ reviewTypes.core_review_testing ?? '' }}</td>
                                        <td>{{ reviewTypes.core_review_merge ?? '' }}</td>
                                        <td>{{ reviewTypes.core_review_abandon ?? '' }}</td>
                                        <td>{{ reviewTypes.core_review_comment ?? '' }}</td>
                                    </tr>
                                {% endfor %}
                            </table>
                        </div>
                    </div>
                {% endfor %}
            </div>

            <form class="mt-3" action="/management/interactions" method="get" id="contributorList">
                <div class="form-group">
                    <select multiple name="taggles[]" id="contributors" data-role="tagsinput">
                        {%  for member in coreTeamMergers %}
                            <option value="{{ member }}">{{ member }}</option>
                        {% endfor %}
                    </select>
                </div>
                <input type="submit" class="btn btn-primary" value="Show">
                <a class="btn btn-secondary" href="/management/interactions/">Reset</a>
            </form>
        </div>
    </div>

{% endblock %}
