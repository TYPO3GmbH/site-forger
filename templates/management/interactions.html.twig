{% extends 'base.html.twig' %}
{% block title %}Interactions{% endblock %}
{% block headline %}Coreteam Review Activity{% endblock %}
{% block body %}

    <div class="content-section content-section-small">
        <div class="container-fluid">
            <div class="interactions">
                {% for monthKey, month in aggs %}
                    <div class="interactions-item">
                        <div class="datatable">
                            <table class="datatable-table datatable-table-compact">
                                <caption class="datatable-caption">{{ monthKey }}</caption>
                                <thead>
                                    <tr>
                                        <th scope="col">Name</th>
                                        <th scope="col"><i class="fal fa-fw fa-code" aria-hidden="true" data-toggle="tooltip" title="Added Patchset"></i><span class="sr-only">Added Patchset</span></th>
                                        <th scope="col"><i class="fal fa-fw fa-eye" aria-hidden="true" data-toggle="tooltip" title="Core Review"></i><span class="sr-only">Code Review</span></th>
                                        <th scope="col"><i class="fal fa-fw fa-thumbs-up" aria-hidden="true" data-toggle="tooltip" title="Verification"></i><span class="sr-only">Verification</span></th>
                                        <th scope="col"><i class="fal fa-fw fa-code-branch" aria-hidden="true" data-toggle="tooltip" title="Merge"></i><span class="sr-only">Merge</span></th>
                                        <th scope="col"><i class="fal fa-fw fa-trash" aria-hidden="true" data-toggle="tooltip" title="Abandon"></i><span class="sr-only">Abandon</span></th>
                                        <th scope="col"><i class="fal fa-fw fa-comment" aria-hidden="true" data-toggle="tooltip" title="Comment"></i><span class="sr-only">Comment</span></th>
                                    </tr>
                                </thead>
                                {% for committer, reviewTypes in month %}
                                    <tr>
                                        <th data-type="title">{{ committer }}</th>
                                        <td data-type="number">{{ reviewTypes.Added_Patchset ?? '' }}</td>
                                        <td data-type="number">{{ reviewTypes.Code_Review ?? '' }}</td>
                                        <td data-type="number">{{ reviewTypes.Verification ?? '' }}</td>
                                        <td data-type="number">{{ reviewTypes.Merge ?? '' }}</td>
                                        <td data-type="number">{{ reviewTypes.Abandoned_Patch ?? '' }}</td>
                                        <td data-type="number">{{ reviewTypes.Comment ?? '' }}</td>
                                    </tr>
                                {% endfor %}
                            </table>
                        </div>
                    </div>
                {% endfor %}
            </div>
            <div class="card">
                <div class="card-heading">
                    <h3 class="panel-title">Contributors</h3>
                </div>
                <div class="card-body">
                    <form action="/management/interactions" method="get" id="contributorList">
                        <div>
                            <select multiple name="taggles[]" id="contributors" data-role="tagsinput">
                                {%  for member in coreTeamMergers %}
                                    <option value="{{ member }}">{{ member }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div style="margin-top:10px;">
                            <input type="submit" class="btn btn-success" value="Show"> <a class="btn btn-warning" href="/management/interactions/">Reset</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

{% endblock %}
