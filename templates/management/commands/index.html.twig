{% extends 'base.html.twig' %}
{% block title %}Command runs{% endblock %}
{% block page_title %}Command runs{% endblock %}

{#
 # What the cron jobs did, see App\Controller\CommandRunController.
 # Status colors come from the status pills in assets/css/module/_status.scss, the layout from _command-runs.scss.
 #}

{% macro duration(seconds) %}
    {%- if seconds < 60 -%}
        {{ seconds }} s
    {%- elseif seconds < 3600 -%}
        {{ (seconds / 60)|round(0, 'floor') }} min
    {%- elseif seconds < 172800 -%}
        {{ (seconds / 3600)|round(0, 'floor') }} h {{ ((seconds % 3600) / 60)|round(0, 'floor') }} min
    {%- else -%}
        {{ (seconds / 86400)|round(0, 'floor') }} days
    {%- endif -%}
{% endmacro %}

{% macro ago(date, now) %}
    {%- if date -%}
        <time datetime="{{ date|date('c') }}" title="{{ date|date('Y-m-d H:i:s') }}">{{ _self.duration(now.timestamp - date.timestamp) }} ago</time>
    {%- else -%}
        <span class="runs-muted">never</span>
    {%- endif -%}
{% endmacro %}

{% macro status(run, now) %}
    {% set state = run.status(now) %}
    <span class="status-pill status-pill-{{ state.severity }}">{{ state.label }}</span>
{% endmacro %}

{# A job of the schedule to run now, see CommandRunController::queue() #}
{# A job by what it does, its command below #}
{% macro job(job, labels) %}<span class="runs-job-label">{{ labels[job] ?? job }}</span><code class="runs-job-command">{{ job }}</code>{% endmacro %}

{# A button that posts a job (or none, for all) to an action of CommandRunController, once confirmed in the dialog below, see command-runs.js #}
{% macro action(route, label, job, token, title = null, style = null, parameters = {}, confirm = null) %}
    {% set actionIcon = {
        'management_command_runs_queue': 'actions-play',
        'management_command_runs_resume': 'actions-play',
        'management_command_runs_pause': 'actions-pause',
        'management_command_runs_cancel': 'actions-ban',
    }[route] ?? null %}
    <form class="runs-queue" method="post" action="{{ path(route, parameters) }}"
          data-runs-confirm="{{ confirm ?? (label ~ (job ? ': ' ~ job) ~ '?') }}"
          data-runs-confirm-detail="{{ title }}"
          data-runs-confirm-label="{{ label }}"
          data-runs-confirm-style="{{ style == 'danger' ? 'danger' : 'primary' }}">
        <input type="hidden" name="job" value="{{ job }}">
        <input type="hidden" name="_token" value="{{ csrf_token(token) }}">
        <button type="submit" class="runs-queue-button{{ style ? ' runs-queue-button-' ~ style }}"{% if title %} title="{{ title }}"{% endif %}>{% if actionIcon %}{{ icon(actionIcon) }}{% endif %}<span>{{ label }}</span></button>
    </form>
{% endmacro %}

{# What can be done with a job of the schedule now: run it, pause it, resume it #}
{% macro jobActions(job, state, token) %}
    {% set ownPause = state.pauses[job] ?? null %}
    <span class="runs-actions-group">
        {% if job in state.runningJobs %}
            <span class="runs-muted runs-nowrap">Running</span>
        {% elseif job in state.queuedJobs %}
            <span class="runs-muted runs-nowrap">Queued</span>
        {% elseif not state.pauseAll and not ownPause %}
            {{ _self.action('management_command_runs_queue', 'Run now', job, token, 'Starts ' ~ job ~ ' within a minute') }}
        {% endif %}
        {% if ownPause %}
            {{ _self.action('management_command_runs_resume', 'Resume', job, token, 'Paused ' ~ ownPause.reason) }}
        {% elseif not state.pauseAll %}
            {{ _self.action('management_command_runs_pause', 'Pause', job, token, job in state.runningJobs ? 'Stops the run, it starts again once resumed' : 'Starts nothing until resumed') }}
        {% endif %}
    </span>
{% endmacro %}

{# A skipped item: on Forge or Gerrit, where its error can be looked at, and in Forger #}
{% macro skippedItem(item) %}
    {%- if item.type == 'change' -%}
        <a href="{{ gerrit_change_url(item.id) }}" target="_blank" rel="noopener" title="The change on Gerrit">Change {{ item.id }}</a>
        <a class="runs-skipped-local" href="{{ change_path(item.id) }}">in Forger</a>
    {%- elseif item.id matches '/^\\d+$/' -%}
        <a href="{{ forge_issue_url(item.id) }}" target="_blank" rel="noopener" title="The issue on Forge">#{{ item.id }}</a>
        <a class="runs-skipped-local" href="{{ issue_path(item.id) }}">in Forger</a>
    {%- else -%}
        {{ item.id }}
    {%- endif -%}
{% endmacro %}

{# The log of a run, like a log file: what it noted, waited for, skipped and failed with, each with its details. The first entries, the others behind a click. #}
{% macro log(run) %}
    {% set entries = run.log %}
    {% if entries is not empty %}
        <div class="runs-log">
            <ol class="runs-log-entries">
                {% for entry in entries|slice(0, 12) %}{{ _self.logEntry(entry) }}{% endfor %}
            </ol>
            {% if entries|length > 12 %}
                <details class="runs-log-more">
                    <summary>{{ entries|length - 12 }} more {{ entries|length - 12 == 1 ? 'entry' : 'entries' }}</summary>
                    <ol class="runs-log-entries">
                        {% for entry in entries|slice(12) %}{{ _self.logEntry(entry) }}{% endfor %}
                    </ol>
                </details>
            {% endif %}
            {% if run.warningsNotLogged > 0 %}
                <p class="runs-log-truncated">and {{ run.warningsNotLogged|number_format(0, '.', ',') }} more warnings, not logged</p>
            {% endif %}
        </div>
    {% endif %}
{% endmacro %}

{% macro logEntry(entry) %}
    <li class="runs-log-entry is-{{ entry.level }}">
        <time class="runs-log-time" datetime="{{ entry.at }}" title="{{ entry.at|date('Y-m-d H:i:s') }}">{{ entry.at|date('H:i:s') }}</time>
        <span class="runs-log-level">{{ entry.level|upper }}</span>
        <div class="runs-log-body">
            <span class="runs-log-message">{{ entry.message }}</span>
            {% if entry.item is defined %}<span class="runs-log-item">{{ _self.skippedItem(entry.item) }}</span>{% endif %}
            {% if entry.step is defined %}<span class="runs-log-step">{{ entry.step }}</span>{% endif %}
            {% if entry.exception is defined %}
                <details class="runs-log-exception">
                    <summary><code>{{ entry.exception.class }}</code> in <code>{{ entry.exception.location }}</code></summary>
                    <pre>{{ _self.exception(entry.exception) }}</pre>
                </details>
            {% endif %}
        </div>
    </li>
{% endmacro %}

{# An exception as PHP prints it: its message, its stack trace, the exception it was thrown for #}
{% macro exception(exception) -%}
{{ exception.class }}: {{ exception.message }}
  at {{ exception.location }}
{% for frame in exception.trace %}  #{{ loop.index0 }} {{ frame }}
{% endfor %}{% if exception.previous is defined %}
Caused by {{ _self.exception(exception.previous) }}{% endif %}
{%- endmacro %}

{# How a run ended, beyond its status: why it stopped, its error, its notes, its warnings #}
{% macro message(run, now) %}
    {% set state = run.status(now) %}
    {% set parts = run.messageParts(now) %}
    {% set logged = run.log is not empty %}
    {% if (parts.error and not logged) or state.value == 'aborted' %}
        <div class="runs-error">
            <p class="runs-error-title">
                {% if parts.errorType %}<code class="runs-error-type">{{ parts.errorType }}</code>{% endif %}
                {{ state.value == 'aborted' ? 'No end recorded and no heartbeat for 15 minutes: killed, out of memory or a restart of the server.' : 'The run ended with an error.' }}
            </p>
            {% if parts.error %}
                {% if parts.error|length > 300 or '\n' in parts.error %}
                    <details class="runs-error-text">
                        {% set firstLine = parts.error|split("\n")|first %}
                        <summary>{{ firstLine|length > 300 ? firstLine|slice(0, 299) ~ '…' : firstLine }}</summary>
                        <pre>{{ parts.error }}</pre>
                    </details>
                {% else %}
                    <p class="runs-error-text">{{ parts.error }}</p>
                {% endif %}
            {% endif %}
        </div>
    {% endif %}
    {% if logged %}
        {{ _self.log(run) }}
    {% elseif parts.warnings is not empty %}
        {# A run from before the skipped items were recorded: its first warnings #}
        <div class="runs-warnings">
            <p class="runs-warnings-title">{{ (parts.warnings|length + parts.moreWarnings) }} {{ parts.warnings|length + parts.moreWarnings == 1 ? 'item was' : 'items were' }} skipped because of an error, the run went on</p>
            <ul>
                {% for warning in parts.warnings %}<li>{{ warning }}</li>{% endfor %}
            </ul>
            {% if parts.moreWarnings > 0 %}<p class="runs-muted">and {{ parts.moreWarnings }} more</p>{% endif %}
        </div>
    {% endif %}
{% endmacro %}

{# The progress of a running run in short, for the list of runs: the step it is in, of how many, and the bar of its steps #}
{% macro progress(run, declared, now) %}
    {% set steps = run.steps(declared, now) %}
    {% set current = null %}
    {% set number = 0 %}
    {% for step in steps %}
        {% if step.state == 'current' %}{% set current = step %}{% set number = loop.index %}{% endif %}
    {% endfor %}
    <div class="runs-progress">
        <div class="runs-progress-label">
            <span>
                {% if current and steps|length > 1 %}<span class="runs-progress-phase">Step {{ number }} of {{ steps|length }}</span>{% endif %}
                {{ current ? current.name : 'Starting' }}
            </span>
            <span class="runs-numeric">{{ _self.stepCount(current) }}</span>
        </div>
        {{ _self.segments(steps) }}
    </div>
{% endmacro %}

{# How far a step got: "7,500 of 17,840 · 42 %", or the count without a total #}
{% macro stepCount(step) %}
    {%- if step and step.percent is not null -%}
        {{ step.current|number_format(0, '.', ',') }} of {{ step.total|number_format(0, '.', ',') }} · {{ step.percent }} %
    {%- elseif step and step.current is not null -%}
        {{ step.current|number_format(0, '.', ',') }}
    {%- endif -%}
{% endmacro %}

{# The bar of a run, a segment for each step: full for the steps it went through, filled as far as the current one got, empty for those to come #}
{% macro segments(steps) %}
    {% set current = null %}
    {% set number = 0 %}
    {% for step in steps %}
        {% if step.state == 'current' %}{% set current = step %}{% set number = loop.index %}{% endif %}
    {% endfor %}
    <div class="runs-segments" role="progressbar" aria-label="Steps of the run"
         aria-valuetext="{{ current ? 'Step ' ~ number ~ ' of ' ~ steps|length ~ ', ' ~ current.name ~ (current.percent is not null ? ', ' ~ current.percent ~ ' %') : 'Starting' }}">
        {% for step in steps is empty ? [null] : steps %}
            {% set state = step ? step.state : 'current' %}
            {% set fill = state == 'done' ? 100 : (state in ['current', 'stopped'] ? (step ? step.percent : null) : 0) %}
            <span data-runs-key="{{ step ? step.name : 'start' }}" class="runs-segment is-{{ state }}{{ state == 'current' and fill is null ? ' is-indeterminate' }}"{% if step %} title="{{ step.name }}"{% endif %}>
                <span class="runs-segment-fill" style="width: {{ fill ?? 100 }}%"></span>
            </span>
        {% endfor %}
    </div>
{% endmacro %}

{# The steps of a running run: the bar of its steps, then each of them: those it went through, the one it is in with its speed, those still to come; with usual, the duration of its successful runs, also when the whole run ends #}
{% macro steps(run, declared, now, usual = null) %}
    <p class="runs-progress-run">
        <span class="runs-progress-run-label">Whole run</span>
        {% set stepEndsAt = run.phaseEndsAt %}
        {% if usual %}
            {% set usualEnd = run.startedAt.modify('+' ~ usual ~ ' seconds') %}
            {% if stepEndsAt and stepEndsAt > usualEnd %}
                {# The current step alone takes longer than the whole run usually does #}
                <span>not before <strong>{{ stepEndsAt|date('H:i') }}</strong>, longer than usual</span>
            {% else %}
                <span>expected to end around <strong>{{ usualEnd|date('H:i') }}</strong></span>
            {% endif %}
            <span class="runs-muted">usually takes {{ _self.duration(usual) }}</span>
        {% elseif stepEndsAt %}
            <span>not before <strong>{{ stepEndsAt|date('H:i') }}</strong></span>
            <span class="runs-muted">there was no successful run yet</span>
        {% else %}
            <span class="runs-muted">no estimate, there was no successful run yet</span>
        {% endif %}
    </p>
    {% set steps = run.steps(declared, now) %}
    {{ _self.segments(steps) }}
    {% if steps is not empty %}
        <ol class="runs-steps">
            {% for step in steps %}
                <li data-runs-key="{{ step.name }}" class="runs-step is-{{ step.state }}"{% if step.state == 'current' %} aria-current="step"{% endif %}>
                    <span class="runs-step-marker" aria-hidden="true">
                        {% if step.state == 'done' %}{{ icon('actions-check') }}
                        {% elseif step.state == 'stopped' %}{{ icon('actions-exclamation') }}
                        {% elseif step.state == 'skipped' %}{{ icon('actions-minus') }}
                        {% else %}{{ loop.index }}{% endif %}
                    </span>
                    <div class="runs-step-body">
                        <div class="runs-step-head">
                            <span class="runs-step-name">{{ step.name }}</span>
                            <span class="runs-step-meta runs-numeric">
                                {% if step.state == 'current' %}
                                    {{ _self.stepCount(step) }}
                                {% elseif step.state == 'done' %}
                                    {% if step.current is not null %}{{ step.current|number_format(0, '.', ',') }} · {% endif %}{{ _self.duration(step.seconds) }}
                                {% elseif step.state == 'stopped' %}
                                    stopped{% if step.current is not null %} at {{ _self.stepCount(step) }}{% endif %}
                                {% elseif step.state == 'skipped' %}
                                    not run
                                {% else %}
                                    to come
                                {% endif %}
                            </span>
                        </div>
                        {% if step.state == 'current' %}
                            {% if step.waiting %}
                                <div class="runs-step-waiting">{{ icon('actions-clock') }}<span>{{ step.waiting }}</span></div>
                            {% else %}
                                {# The speed of the step, and when it is done at that speed #}
                                {% set perMinute = run.progressPerMinute %}
                                {% if perMinute is not null %}
                                    {% set endsAt = run.phaseEndsAt %}
                                    <div class="runs-progress-eta runs-muted">
                                        <span>{{ perMinute >= 10 ? perMinute|number_format(0, '.', ',') : perMinute|number_format(1, '.', ',') }} per minute</span>
                                        {% if endsAt %}
                                            <span>about {{ _self.duration(max(0, endsAt.timestamp - run.heartbeatAt.timestamp)) }} left in this step, done around {{ endsAt|date('H:i') }}</span>
                                        {% elseif step.total is null %}
                                            <span>the end of this step is not known in advance</span>
                                        {% endif %}
                                    </div>
                                {% elseif step.current is not null %}
                                    <div class="runs-progress-eta runs-muted"><span>Measuring the speed of this step…</span></div>
                                {% endif %}
                            {% endif %}
                        {% endif %}
                    </div>
                </li>
            {% endfor %}
        </ol>
    {% endif %}
{% endmacro %}

{% block body %}
    {% import _self as runs %}

    {# Refreshed all the time, to see the jobs start, run and finish, unless switched off #}
    <div class="content-section content-section-small runs" data-runs-page data-runs-refresh="{{ refreshSeconds }}">
        <div class="container">

            <div class="runs-intro">
                <p>
                    The runs of the jobs of the schedule, of the last {{ retention }}
                    and at most {{ constant('App\\Service\\CommandRunRecorder::MAX_RUNS_PER_JOB') }} per job.
                    A job is overdue when a planned run did not start, or three planned runs in a row did not succeed.
                </p>
                <div class="runs-intro-actions">
                {% if not pauseAll %}
                    {{ runs.action('management_command_runs_pause', 'Pause all', '', jobsToken, 'Starts no job until resumed, running ones stop and start again then', 'pause') }}
                {% endif %}
                    <label class="runs-refresh" title="Reloads the runs every {{ refreshSeconds }} seconds">
                        <span class="runs-refresh-dot" aria-hidden="true"></span>
                        <span class="runs-refresh-text">Live <span class="runs-muted">· every {{ refreshSeconds }} s</span></span>
                        <input type="checkbox" class="runs-refresh-switch" role="switch" data-runs-refresh-toggle checked>
                    </label>
                </div>
            </div>

            {% if pauseAll %}
                <section class="runs-paused" role="status">
                    <span class="runs-paused-icon" aria-hidden="true">{{ icon('actions-pause') }}</span>
                    <div class="runs-paused-body">
                        <p class="runs-paused-title">All jobs are paused <span class="runs-muted">since {{ pauseAll.pausedAt|date('H:i') }}, {{ pauseAll.reason }}</span></p>
                        <p class="runs-muted">No job starts, planned ones wait in the queue. Interrupted jobs start again once resumed.</p>
                    </div>
                    {{ runs.action('management_command_runs_resume', 'Resume all', '', jobsToken, null, 'primary') }}
                </section>
            {% endif %}

            {# What starts next, below what runs now #}
            {% set nextRuns %}
            <section class="runs-section">
                <h2 class="runs-heading">Next runs</h2>
                <div class="runs-table-card">
                    <table class="runs-table">
                        <thead>
                        <tr>
                            <th scope="col">When</th>
                            <th scope="col">Job</th>
                            <th scope="col">Schedule</th>
                            <th scope="col"><span class="visually-hidden">Run now</span></th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for queuedJob in queued %}
                            <tr data-runs-key="queued-{{ queuedJob.job }}">
                                <td class="runs-nowrap">
                                    {% if pauseAll or pauses[queuedJob.job] is defined %}
                                        once resumed
                                    {% elseif blockedBy[queuedJob.job] is defined %}
                                        after “{{ labels[blockedBy[queuedJob.job]] }}”
                                    {% else %}
                                        within a minute
                                    {% endif %}
                                </td>
                                <td class="runs-job">{{ runs.job(queuedJob.job, labels) }}</td>
                                <td class="runs-muted">{{ queuedJob.queuedBy }}, {{ runs.ago(queuedJob.queuedAt, now) }}</td>
                                <td class="runs-actions">
                                    {% if pauses[queuedJob.job] is defined %}
                                        {{ runs.action('management_command_runs_resume', 'Resume', queuedJob.job, jobsToken, 'Paused ' ~ pauses[queuedJob.job].reason) }}
                                    {% elseif pauseAll %}
                                        <span class="runs-muted runs-nowrap">All paused</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                        {% for planned in next %}
                            <tr data-runs-key="next-{{ planned.job }}">
                                <td class="runs-nowrap">
                                    {{ planned.at ? planned.at|date('D H:i') : '–' }}
                                    {% if pauseAll or pauses[planned.job] is defined %}
                                        <span class="runs-muted d-block">paused</span>
                                    {% elseif blockedBy[planned.job] is defined %}
                                        <span class="runs-muted d-block">waits for “{{ labels[blockedBy[planned.job]] }}”</span>
                                    {% endif %}
                                </td>
                                <td class="runs-job">{{ runs.job(planned.job, labels) }}</td>
                                <td class="runs-muted">{{ planned.schedule }}</td>
                                <td class="runs-actions">{{ runs.jobActions(planned.job, {'runningJobs': runningJobs, 'queuedJobs': queuedJobs, 'pauses': pauses, 'pauseAll': pauseAll}, jobsToken) }}</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </section>
            {% endset %}

            {% if jobs is empty %}
                {% include '_partials/alert.html.twig' with {'title': 'No runs recorded', 'message': 'No job of the schedule ran in the last ' ~ retention ~ '. If cron should start the worker of the schedule, it does not.', 'style': 'danger'} %}
                {{ nextRuns }}
            {% else %}

                {% if overdue is not empty %}
                    <section class="runs-notice" role="alert">
                        <span class="runs-notice-icon" aria-hidden="true">!</span>
                        <div class="runs-notice-body">
                            <p class="runs-notice-title">
                                {{ overdue|length }} {{ overdue|length == 1 ? 'job is' : 'jobs are' }} overdue
                                <span class="runs-muted">The data {{ overdue|length == 1 ? 'it imports' : 'they import' }} may be out of date.</span>
                            </p>
                            <ul class="runs-notice-list">
                                {% for overview in overdue %}
                                    <li>
                                        <a class="runs-job" href="{{ path('management_command_runs', {'job': overview.job}) }}#runs" data-runs-link data-runs-reveal>{{ runs.job(overview.job, labels) }}</a>
                                        <span class="runs-muted">Last start {{ runs.ago(overview.lastRun.startedAt, now) }} · last success {{ runs.ago(overview.lastSuccess ? overview.lastSuccess.startedAt : null, now) }} · planned {{ overview.schedule }}</span>
                                    </li>
                                {% endfor %}
                            </ul>
                        </div>
                    </section>
                {% endif %}

                <div class="runs-stats">
                    <div class="runs-stat">
                        <span class="runs-stat-label">Jobs</span>
                        <span class="runs-stat-value">{{ jobs|length }}</span>
                        <span class="runs-stat-note">Ran in the last {{ retention }}</span>
                    </div>
                    <div class="runs-stat">
                        <span class="runs-stat-label">Running now</span>
                        <span class="runs-stat-value{{ running is not empty ? ' runs-tone-running' }}">{{ running|length }}</span>
                        <span class="runs-stat-note">With a heartbeat in the last {{ runs.duration(constant('App\\Entity\\CommandRun::HEARTBEAT_TIMEOUT')) }}</span>
                    </div>
                    <div class="runs-stat">
                        <span class="runs-stat-label">Overdue</span>
                        <span class="runs-stat-value{{ overdue is not empty ? ' runs-tone-danger' }}">{{ overdue|length }}</span>
                        <span class="runs-stat-note">Jobs without a recent successful run</span>
                    </div>
                    <div class="runs-stat">
                        <span class="runs-stat-label">Failed runs</span>
                        <span class="runs-stat-value{{ failedRuns > 0 ? ' runs-tone-warning' }}">{{ failedRuns }}</span>
                        <span class="runs-stat-note">Failed or aborted, last {{ retention }}</span>
                    </div>
                </div>

                {% if running is not empty %}
                    <section class="runs-section">
                        <h2 class="runs-heading">Running now</h2>
                        <div class="runs-running">
                            {% for run in running %}
                                <article data-runs-key="run-{{ run.id }}" class="runs-card runs-card-running">
                                    <header class="runs-card-header">
                                        <span class="runs-job">{{ runs.job(run.job, labels) }}</span>
                                        <span class="runs-card-badges">{{ runs.status(run, now) }}</span>
                                    </header>
                                    {{ runs.steps(run, steps[run.job] ?? [], now, usualDurations[run.job] ?? null) }}
                                    {{ runs.log(run) }}
                                    <dl class="runs-facts runs-facts-running">
                                        <div><dt>Started</dt><dd>{{ runs.ago(run.startedAt, now) }} <span class="runs-muted">at {{ run.startedAt|date('H:i') }}</span></dd></div>
                                        <div><dt>Heartbeat</dt><dd>{{ runs.ago(run.heartbeatAt, now) }}</dd></div>
                                        <div><dt>Documents</dt><dd class="runs-numeric">{% if run.documents > 0 %}{{ run.documents|number_format(0, '.', ',') }}{% else %}–<span class="runs-muted"> none written yet</span>{% endif %}</dd></div>
                                        <div><dt>Warnings</dt><dd class="runs-numeric">{{ run.warnings }}</dd></div>
                                    </dl>
                                    <footer class="runs-card-actions">
                                        {% if run.stopping %}
                                            <span class="runs-stopping" role="status">{{ icon('spinner-circle') }}<span>Stopping within seconds: {{ run.stopReason }}</span></span>
                                        {% else %}
                                            {{ runs.action('management_command_runs_pause', 'Pause', run.job, jobsToken, 'Stops the run, it starts again once resumed') }}
                                            {{ runs.action('management_command_runs_cancel', 'Cancel', '', jobsToken, 'Stops the run, it does not start again', 'danger', {'id': run.id}, 'Cancel: ' ~ run.job ~ ', run ' ~ run.id ~ '?') }}
                                        {% endif %}
                                    </footer>
                                </article>
                            {% endfor %}
                        </div>
                    </section>
                {% endif %}

                {{ nextRuns }}

                <section class="runs-section">
                    <h2 class="runs-heading">Jobs</h2>
                    <div class="runs-jobs">
                        {% for overview in jobs %}
                            {% set last = overview.lastRun %}
                            <article data-runs-key="job-{{ overview.job }}" class="runs-card{{ overview.needsAttention(now) ? ' is-overdue' }}{{ job == overview.job ? ' is-selected' }}">
                                <header class="runs-card-header">
                                    <a class="runs-job" href="{{ path('management_command_runs', {'job': overview.job}) }}#runs" data-runs-link data-runs-reveal>{{ runs.job(overview.job, labels) }}</a>
                                    {% if overview.overdue %}
                                        <span class="status-pill status-pill-run-failed">Overdue</span>
                                    {% else %}
                                        {{ runs.status(last, now) }}
                                    {% endif %}
                                </header>
                                <dl class="runs-facts">
                                    <div><dt>Last start</dt><dd>{{ runs.ago(last.startedAt, now) }}</dd></div>
                                    <div><dt>Last success</dt><dd>{{ runs.ago(overview.lastSuccess ? overview.lastSuccess.startedAt : null, now) }}</dd></div>
                                    <div><dt>Schedule</dt><dd>{{ overview.schedule }}<span class="runs-muted d-block">next {{ overview.nextRun ? overview.nextRun|date('D H:i') : '–' }}</span></dd></div>
                                    <div><dt>Failed</dt><dd class="runs-numeric">{{ overview.failures }} of {{ overview.runs|length }}</dd></div>
                                </dl>
                                <ol class="runs-history" aria-label="Latest runs, oldest first">
                                    {% for run in overview.history %}
                                        {% set state = run.status(now) %}
                                        <li class="runs-history-item status-pill-{{ state.severity }}" title="{{ run.startedAt|date('Y-m-d H:i') }}: {{ state.label }}, {{ run.documents|number_format(0, '.', ',') }} documents"><span class="visually-hidden">{{ run.startedAt|date('Y-m-d H:i') }}: {{ state.label }}</span></li>
                                    {% endfor %}
                                </ol>
                            </article>
                        {% endfor %}
                    </div>
                </section>

                <section class="runs-section" id="runs" data-runs-list>
                    <div class="runs-list-header">
                        <h2 class="runs-heading">
                            {% if job %}Runs of “{{ labels[job] ?? job }}”{% else %}Latest runs{% endif %}
                        </h2>
                        <nav class="runs-filters" aria-label="Filter the runs">
                            {% if job %}
                                <a class="runs-filter" href="{{ path('management_command_runs', {'problems': problemsOnly ? 1 : null}) }}#runs" data-runs-link>All jobs</a>
                            {% endif %}
                            <a class="runs-filter{{ not problemsOnly ? ' is-active' }}" href="{{ path('management_command_runs', {'job': job}) }}#runs" data-runs-link{% if not problemsOnly %} aria-current="true"{% endif %}>All runs</a>
                            <a class="runs-filter{{ problemsOnly ? ' is-active' }}" href="{{ path('management_command_runs', {'job': job, 'problems': 1}) }}#runs" data-runs-link{% if problemsOnly %} aria-current="true"{% endif %}>Problems only</a>
                        </nav>
                    </div>

                    {% if runs is empty %}
                        {% include '_partials/alert.html.twig' with {'message': problemsOnly ? 'No failed, aborted or warning runs.' : 'No runs.', 'style': 'success'} %}
                    {% else %}
                        <div class="runs-table-card">
                            <table class="runs-table">
                                <thead>
                                <tr>
                                    <th scope="col">Started</th>
                                    {% if not job %}<th scope="col">Job</th>{% endif %}
                                    <th scope="col">Status</th>
                                    <th scope="col" class="runs-numeric">Duration</th>
                                    <th scope="col" class="runs-numeric">Documents</th>
                                    <th scope="col" class="runs-numeric">Warnings</th>
                                </tr>
                                </thead>
                                {% for run in runs %}
                                    <tbody data-runs-key="run-{{ run.id }}" class="runs-row">
                                    <tr>
                                        <td class="runs-nowrap" title="{{ run.host }}, pid {{ run.pid }}">{{ run.startedAt|date('Y-m-d H:i:s') }}</td>
                                        {% if not job %}<td class="runs-job">{{ runs.job(run.job, labels) }}</td>{% endif %}
                                        <td class="runs-nowrap">
                                            {% set state = run.status(now) %}
                                            {{ runs.status(run, now) }}
                                            {% if state.stoppedOnPurpose %}
                                                {% set reason = run.messageParts(now).reason %}
                                                {% if reason %}<span class="runs-muted runs-reason">{{ reason|replace({'Interrupted: ': ''}) }}</span>{% endif %}
                                            {% elseif run.exitCode is not null and run.exitCode != 0 %}
                                                <span class="runs-muted">exit {{ run.exitCode }}</span>
                                            {% endif %}
                                        </td>
                                        <td class="runs-numeric runs-nowrap">{{ runs.duration(run.duration) }}</td>
                                        <td class="runs-numeric">{{ run.documents|number_format(0, '.', ',') }}</td>
                                        <td class="runs-numeric">{{ run.warnings }}</td>
                                    </tr>
                                    {% set parts = run.messageParts(now) %}
                                    {% if parts.error or parts.warnings is not empty or run.log is not empty or run.status(now).value in ['running', 'aborted'] %}
                                        <tr class="runs-detail">
                                            <td colspan="{{ job ? 5 : 6 }}">
                                                {% if run.status(now).value == 'running' %}
                                                    {{ runs.progress(run, steps[run.job] ?? [], now) }}
                                                {% endif %}
                                                {{ runs.message(run, now) }}
                                            </td>
                                        </tr>
                                    {% endif %}
                                    </tbody>
                                {% endfor %}
                            </table>
                        </div>
                        {% if runs|length >= limit and limit < maxLimit %}
                            <p class="runs-more"><a href="{{ path('management_command_runs', {'job': job, 'problems': problemsOnly ? 1 : null, 'limit': maxLimit}) }}#runs" data-runs-link>Show the latest {{ maxLimit }} runs</a></p>
                        {% endif %}
                    {% endif %}
                </section>
            {% endif %}
        </div>
    </div>

    {# Asks before an action on a job, outside the content the refresh replaces. The script fills in the action, the job and the token of the button. #}
    <dialog class="runs-confirm" id="runs-confirm" aria-labelledby="runs-confirm-title" aria-describedby="runs-confirm-detail">
        <form method="post" class="runs-confirm-form">
            <h2 class="runs-confirm-title" id="runs-confirm-title"></h2>
            <p class="runs-confirm-detail" id="runs-confirm-detail"></p>
            <div class="runs-confirm-fields"></div>
            <div class="runs-confirm-buttons">
                <button type="button" class="runs-queue-button runs-confirm-back" data-runs-confirm-close>Back</button>
                <button type="submit" class="runs-queue-button runs-confirm-submit"></button>
            </div>
        </form>
    </dialog>
{% endblock %}
