{% extends 'base.html.twig' %}
{% block title %}Issue Manager{% endblock %}
{% block headline %}Issue Management View{% endblock %}
{% block body %}

    <div class="content-section bg-transparent">
        <div class="container-fluid">
            <form action="{{ path(routeName) }}" method="get" class="form">
                <div class="form-row">
                    <div class="form-group form-check-inline">
                        {{ trackerCheckbox('epic')|raw }}
                        <label class="form-check-label">Exclude Epics</label>
                    </div>
                    <div class="form-group form-check-inline">
                        {{ trackerCheckbox('story')|raw }}
                        <label class="form-check-label">Exclude Stories</label>
                    </div>
                    <div class="form-group form-check-inline">
                        {{ trackerCheckbox('feature')|raw }}
                        <label class="form-check-label">Exclude Features</label>
                    </div>
                    <div class="form-group form-check-inline">
                        {{ trackerCheckbox('task')|raw }}
                        <label class="form-check-label">Exclude Tasks</label>
                    </div>
                    <div class="form-group form-check-inline">
                        {{ trackerCheckbox('bug')|raw }}
                        <label class="form-check-label">Exclude Bugs</label>
                    </div>
                    <div class="form-group">
                        <button type="submit" class="btn btn-success">Filter</button>
                    </div>
                </div>
            </form>
        </div>

        <div class="container-fluid">
            {% for year in aggs %}
                <div class="yearview">
                    <h4 class="yearview-headline">{{year.year}} ({{year.total}})</h4>
                    <div class="yearview-year">
                        {% for month in year.months %}
                            <div class="yearview-month">
                                {% if month.stati is defined %}
                                    <div class="listbox listbox-small">
                                        <div class="listbox-header">
                                            <span class="listbox-header-title">
                                                <a href="{{ forgeLink(year.year, month.month) }}">{{month.month}}</a>
                                            </span>
                                            <span class="listbox-header-count">{{ month.total }}</span>
                                        </div>
                                        <div class="listbox-entries">
                                            {% for status in month.stati %}
                                                {% set parameter = null %}
                                                {% set severity = null %}
                                                {% if status.name == 'New' %}
                                                    {% set parameter = 1 %}
                                                    {% set severity = 'new' %}
                                                {% elseif status.name == 'Accepted' %}
                                                    {% set parameter = 2 %}
                                                    {% set severity = 'accepted' %}
                                                {% elseif status.name == 'Under Review' %}
                                                    {% set parameter = 8 %}
                                                    {% set severity = 'underreview' %}
                                                {% elseif status.name == 'On Hold' %}
                                                    {% set parameter = 7 %}
                                                    {% set severity = 'onhold' %}
                                                {% elseif status.name == 'Needs Feedback' %}
                                                    {% set parameter = 4 %}
                                                    {% set severity = 'needsfeedback' %}
                                                {% elseif status.name == 'In Progress' %}
                                                    {% set parameter = 11 %}
                                                    {% set severity = 'inprogress' %}
                                                {% endif %}
                                                {% if parameter and severity %}
                                                    <div class="listbox-item">
                                                        <div class="listbox-item-name">
                                                            <a href="{{ forgeLink(year.year, month.month, parameter) }}">{{status.name}}</a>
                                                        </div>
                                                        <div class="listbox-item-badge">
                                                            <span class="badge status-{{ severity }}">{{status.total}}</span>
                                                        </div>
                                                    </div>
                                                {% endif %}
                                            {% endfor %}
                                        </div>
                                    </div>
                                {% endif %}
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>

{% endblock %}
