{% extends 'base.html.twig' %}
{% block title %}Issue Manager{% endblock %}
{% block headline %}Issue Management View{% endblock %}
{% block body %}

    <div class="content-section content-section-smallest bg-dark text-white">
        <div class="container">

            <form action="{{ path(routeName) }}" method="get" class="form">
                <div class="row justify-content-md-center align-items-center">
                    <div class="col">
                        {{ trackerCheckbox('epic', 'Exclude Epics') }}
                    </div>
                    <div class="col">
                        {{ trackerCheckbox('story', 'Exclude Stories') }}
                    </div>
                    <div class="col">
                        {{ trackerCheckbox('feature', 'Exclude Features') }}
                    </div>
                    <div class="col">
                        {{ trackerCheckbox('task', 'Exclude Tasks') }}
                    </div>
                    <div class="col">
                        {{ trackerCheckbox('bug', 'Exclude Bugs') }}
                    </div>
                    <div class="col">
                        <button type="submit" class="btn btn-primary">Filter</button>
                    </div>
                </div>
            </form>

        </div>
    </div>
    <div class="content-section content-section-small">
        <div class="container-fluid">
            {% for year in aggs %}
                <div class="yearview">
                    <h4 class="yearview-headline">{{year.year}} ({{year.total}})</h4>
                    <div class="yearview-year">
                        {% for month in year.months %}
                            <div class="yearview-month">
                                {% if month.stati is defined %}
                                    <div class="listbox listbox-small">
                                        <div class="listbox-header">
                                            <span class="listbox-header-title">
                                                <a href="{{ forgeLink(year.year, month.month) }}">{{month.month}}</a>
                                            </span>
                                            <span class="listbox-header-count">{{ month.total }}</span>
                                        </div>
                                        <div class="listbox-entries">
                                            {% for status in month.stati %}
                                                {# Label, Forge id and severity come from IssueStatusEnum, states Forge does not know are left out #}
                                                {% set state = issue_status(status.name) %}
                                                {% if state %}
                                                    <div class="listbox-item">
                                                        <div class="listbox-item-name">
                                                            <a href="{{ forgeLink(year.year, month.month, state.value) }}">{{ state.label }}</a>
                                                        </div>
                                                        <div class="listbox-item-badge">
                                                            <span class="status-pill status-pill-{{ state.severity }}">{{ status.total }}</span>
                                                        </div>
                                                    </div>
                                                {% endif %}
                                            {% endfor %}
                                        </div>
                                    </div>
                                {% endif %}
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>

{% endblock %}
