{% extends 'base.html.twig' %}
{% import '_macros/buttons.html.twig' as buttons %}
{% block title %}Sprints{% endblock %}
{% block headline %}Sprints{% endblock %}
{% block body %}

    <div class="content-section bg-transparent">
        <div class="container">

            <div class="row">
                <div class="col-md-12">
                    <div class="float-right">
                        {{ buttons.link(
                            path('sprint_create'),
                            'Create new',
                            'primary',
                            'actions-plus'
                        ) }}
                    </div>
                </div>
            </div>
            <br>
            <div class="row">
                <div class="col-md-12">
                    {% if items %}
                        <div class="card">
                            <div class="datatable">
                                <table class="datatable-table">
                                    <thead>
                                    <tr>
                                        <th scope="col">Name</th>
                                        <th scope="col">Category</th>
                                        <th scope="col">Actions</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    {% for item in items %}
                                        <tr>
                                            <th>
                                                <strong>{{ item.name }}</strong><br>
                                            </th>
                                            <td>{{ item.category.name }}</td>
                                            <td data-type="actions" data-label="Actions">
                                                <a class="datatable-action" title="View" href="{{ path('sprint', {'sprintId': item.id, 'category': item.category.identifier}) }}">
                                                    <span class="datatable-action-icon">{{ icon('actions-view') }}</span>
                                                    <span class="datatable-action-label datatable-visually-hidden">View</span>
                                                </a>
                                                <a class="datatable-action" title="Edit" href="{{ path('sprint_edit', {'sprintId': item.id}) }}">
                                                    <span class="datatable-action-icon">{{ icon('actions-open') }}</span>
                                                    <span class="datatable-action-label datatable-visually-hidden">Edit</span>
                                                </a>
                                                <a class="datatable-action" title="Delete" href="{{ path('sprint_delete', {'sprintId': item.id}) }}">
                                                    <span class="datatable-action-icon">{{ icon('actions-delete') }}</span>
                                                    <span class="datatable-action-label datatable-visually-hidden">Delete</span>
                                                </a>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    {% else %}
                        {% include '_partials/alert.html.twig' with {'message': 'There are currently no sprints!', 'style': 'info'} %}
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

{% endblock %}
