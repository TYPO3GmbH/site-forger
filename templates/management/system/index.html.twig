{% extends 'base.html.twig' %}
{% block title %}System{% endblock %}
{% block page_title %}System{% endblock %}

{#
 # What Forger runs on and whether its data is complete, see App\Controller\SystemController.
 # The layout comes from _command-runs.scss and _system.scss, the colors of the results from the status pills in _status.scss.
 #}

{% macro result(result) %}
    <span class="status-pill status-pill-{{ result.severity }}">{{ result.label }}</span>
{% endmacro %}

{#
 # A tile of the top row: the label, the result, the key figure and a note. With an anchor the tile links to its
 # section. A share from 0 to 1 adds a meter below the figure; the note says the same in words.
 #}
{% macro tile(label, result, value, note, anchor = null, share = null) %}
    {% set tag = anchor ? 'a' : 'div' %}
    <{{ tag }} class="runs-stat system-tile"{% if anchor %} href="#{{ anchor }}"{% endif %}>
        <span class="system-tile-head">
            <span class="runs-stat-label">{{ label }}</span>
            {{ _self.result(result) }}
        </span>
        {% if value is not null %}<span class="system-tile-value">{{ value }}</span>{% endif %}
        {% if share is not null %}
            <span class="system-tile-meter" aria-hidden="true">
                <span style="width: {{ (share * 100)|round(1) }}%"></span>
            </span>
        {% endif %}
        <span class="runs-stat-note">{{ note }}</span>
    </{{ tag }}>
{% endmacro %}

{% block body %}
    {% import _self as system %}
    {% import '_macros/format.html.twig' as format %}
    {% set configurationLabels = {
        'outdated': 'The configuration has changed. Run app:elasticsearch:setup to rebuild the index.',
        'unknown': 'Built before the configuration was stored. Run app:elasticsearch:setup to compare the mapping.',
        'missing': 'No index has this alias. Run app:elasticsearch:setup to create it.',
    } %}
    {% set waiting = pending|filter(check => check.result != constant('App\\Enum\\SystemCheckEnum::OK')) %}
    {% set outdated = 0 %}
    {% for check in waiting %}{% set outdated = outdated + check.matches %}{% endfor %}
    {# Of the outdated documents, those the backfill lifts without a request #}
    {% set liftable = 0 %}
    {% for check in pending %}
        {% for row in check.versions|default([])|filter(row => row.state == 'backfill') %}
            {% set liftable = liftable + row.documents %}
        {% endfor %}
    {% endfor %}
    {% set documents = 0 %}
    {% set bytes = 0 %}
    {% for index in indices %}
        {% set documents = documents + (index.documents ?? 0) %}
        {% set bytes = bytes + (index.bytes ?? 0) %}
    {% endfor %}
    {% set problems = setup|filter(setting => setting.result != constant('App\\Enum\\SystemCheckEnum::OK'))|length %}

    <div class="content-section content-section-small runs system">
        <div class="container">

            <div class="runs-intro">
                <p>
                    This page shows what Forger runs on and whether its data is complete.
                    It only reads data and changes nothing.
                </p>
            </div>

            {% if not elasticsearch.reachable %}
                <section class="runs-notice" role="alert">
                    <span class="runs-notice-icon" aria-hidden="true">!</span>
                    <div class="runs-notice-body">
                        <p class="runs-notice-title">
                            Elasticsearch is not reachable.
                            <span class="runs-muted">Lists, search and imports do not work.</span>
                        </p>
                        <pre class="system-error">{{ elasticsearch.error }}</pre>
                    </div>
                </section>
            {% endif %}

            {# One tile per section: its result and its key figure. A tile leads to its section. #}
            <div class="system-tiles">
                {{ system.tile(
                    'Overall',
                    overall,
                    notOk is empty ? 'All OK' : notOk|length ~ ' of ' ~ checks|length,
                    notOk is empty ? checks|length ~ ' sections' : 'Look at: ' ~ notOk|join(', '),
                ) }}
                {{ system.tile(
                    'Setup',
                    checks['Setup'],
                    problems == 0 ? 'All set' : problems ~ ' of ' ~ setup|length,
                    problems == 0 ? setup|length ~ ' settings' : 'settings need a look',
                    'system-setup',
                ) }}
                {% if elasticsearch.reachable %}
                    {{ system.tile(
                        'Elasticsearch',
                        checks['Elasticsearch'],
                        elasticsearch.version,
                        elasticsearch.health|capitalize ~ ' · ' ~ elasticsearch.nodes
                            ~ (elasticsearch.nodes == 1 ? ' node' : ' nodes'),
                        'system-elasticsearch',
                    ) }}
                    {{ system.tile(
                        'Indices',
                        checks['Indices'],
                        documents|number_format(0, '.', ','),
                        'documents in ' ~ indices|length ~ ' indices · ' ~ format.bytes(bytes),
                        'system-indices',
                    ) }}
                    {{ system.tile(
                        'Outdated documents',
                        checks['Outdated documents'],
                        outdated|number_format(0, '.', ','),
                        outdated == 0
                            ? 'All documents are current'
                            : (outdated - liftable)|number_format(0, '.', ',') ~ ' wait for the imports · '
                                ~ liftable|number_format(0, '.', ',') ~ ' for the backfill',
                        'system-outdated',
                    ) }}
                    {% if userStatistics is not null and userStatistics.total > 0 %}
                        {% set share = userStatistics.withLogin / userStatistics.total %}
                        {{ system.tile(
                            'Users with a TYPO3 login',
                            checks['Users'],
                            (share * 100)|round(0, 'floor') ~ ' %',
                            userStatistics.withLogin|number_format(0, '.', ',') ~ ' of '
                                ~ userStatistics.total|number_format(0, '.', ',') ~ ' people',
                            'system-users',
                            share,
                        ) }}
                    {% endif %}
                {% else %}
                    {{ system.tile(
                        'Elasticsearch',
                        checks['Elasticsearch'],
                        'Not reachable',
                        'See the message above',
                    ) }}
                {% endif %}
            </div>

            <div class="system-panels">
            <section class="system-panel" id="system-setup">
                <header class="system-panel-header">
                    <h2 class="runs-heading">Setup</h2>
                    {{ system.result(checks['Setup']) }}
                </header>
                <ul class="runs-table-card system-list">
                    {% for setting in setup %}
                        <li class="system-list-item">
                            <div class="system-list-text">
                                <code class="system-list-name">{{ setting.name }}</code>
                                <span class="system-list-meta">{{ setting.usedFor }}</span>
                                {% if setting.detail %}
                                    <span class="system-list-detail">{{ setting.detail }}</span>
                                {% endif %}
                                {% if setting.problem %}
                                    <span class="system-list-problem">{{ setting.problem }}</span>
                                {% endif %}
                                {% if setting.action %}
                                    <span class="system-list-action">
                                        <a
                                            class="btn btn-sm btn-default"
                                            href="{{ setting.action.url }}"
                                            target="_blank"
                                            rel="noopener"
                                        >
                                            {{- icon('actions-window-open') }} {{ setting.action.label -}}
                                        </a>
                                    </span>
                                {% endif %}
                            </div>
                            {{ system.result(setting.result) }}
                        </li>
                    {% endfor %}
                </ul>
            </section>

            {% if elasticsearch.reachable %}
                <section class="system-panel" id="system-elasticsearch">
                    <header class="system-panel-header">
                        <h2 class="runs-heading">Elasticsearch</h2>
                        {{ system.result(checks['Elasticsearch']) }}
                    </header>
                    <ul class="runs-table-card system-list">
                        <li class="system-list-item">
                            <div class="system-list-text">
                                <span class="system-list-title">Version {{ elasticsearch.version }}</span>
                                <span class="system-list-meta">
                                    The people filters need version {{ minimumVersion }} or newer to search
                                    without regard to case.
                                </span>
                            </div>
                            {{ system.result(elasticsearch.versionResult) }}
                        </li>
                        <li class="system-list-item">
                            <div class="system-list-text">
                                <span class="system-list-title">Cluster <code>{{ elasticsearch.cluster }}</code></span>
                                <span class="system-list-meta">
                                    {{- elasticsearch.health|capitalize }}
                                    · {{ elasticsearch.nodes }} {{ elasticsearch.nodes == 1 ? 'node' : 'nodes' }}
                                    · {{ elasticsearch.unassignedShards }} unassigned
                                    {{ elasticsearch.unassignedShards == 1 ? 'shard' : 'shards' -}}
                                </span>
                                {% if elasticsearch.health == 'yellow' and elasticsearch.nodes == 1 %}
                                    <span class="system-list-detail">
                                        A single node is always "yellow", because it has no second node for the
                                        replicas. The data is complete.
                                    </span>
                                {% endif %}
                            </div>
                            {{ system.result(elasticsearch.healthResult) }}
                        </li>
                    </ul>
                </section>

                <section class="system-panel" id="system-indices">
                    <header class="system-panel-header">
                        <h2 class="runs-heading">Indices</h2>
                        {{ system.result(checks['Indices']) }}
                    </header>
                    <ul class="runs-table-card system-list">
                        {% for index in indices %}
                            <li class="system-list-item">
                                <div class="system-list-text">
                                    <code class="system-list-name">{{ index.alias }}</code>
                                    <span class="system-list-meta">
                                        {%- if index.index -%}
                                            Index <code>{{ index.index }}</code>
                                            · {{ index.documents is null
                                                ? '–'
                                                : index.documents|number_format(0, '.', ',') }} documents
                                            · <span class="runs-nowrap">{{ format.bytes(index.bytes) }}</span>
                                        {%- else -%}
                                            No index
                                        {%- endif -%}
                                    </span>
                                    {% if index.result != constant('App\\Enum\\SystemCheckEnum::OK') %}
                                        <span class="system-list-detail">
                                            {{- configurationLabels[index.configuration] -}}
                                        </span>
                                    {% endif %}
                                </div>
                                {{ system.result(index.result) }}
                            </li>
                        {% endfor %}
                    </ul>
                </section>

                <section class="system-panel" id="system-outdated">
                    <header class="system-panel-header">
                        <h2 class="runs-heading">Outdated documents</h2>
                        {{ system.result(checks['Outdated documents']) }}
                    </header>
                    <ul class="runs-table-card system-list">
                        {% for check in pending %}
                            <li class="system-list-item">
                                <div class="system-list-text">
                                    <span class="system-list-title">{{ check.label }}</span>
                                    <span class="system-list-meta">
                                        {{- check.matches|number_format(0, '.', ',') }}
                                        of {{ check.documents|number_format(0, '.', ',') }}
                                        {{ check.index == 'issue' ? 'issues' : 'changes' }}
                                        come from an import before version {{ check.version -}}
                                    </span>
                                    {% if check.result != constant('App\\Enum\\SystemCheckEnum::OK') %}
                                        <span class="system-list-detail">{{ check.description }}</span>
                                    {% endif %}
                                    {# Where the documents stand: the version that wrote them and what lifts it #}
                                    {% set versions = check.versions|default([]) %}
                                    {% if versions and check.documents > 0 %}
                                        <span class="system-versions" aria-hidden="true">
                                            {% for row in versions %}
                                                <span
                                                    class="system-version is-{{ row.state }}"
                                                    style="width: {{ (row.documents / check.documents * 100)|round(2) }}%"
                                                    title="Version {{ row.version }}"
                                                ></span>
                                            {% endfor %}
                                        </span>
                                    {% endif %}
                                    {% for row in versions %}
                                        <span class="system-list-meta system-version-row">
                                            <span class="system-version-key is-{{ row.state }}"></span>
                                            Version {{ row.version }}:
                                            {{ row.documents|number_format(0, '.', ',') }}
                                            {%- if row.state == 'current' %}, current
                                            {%- elseif row.state == 'backfill' %}, the backfill lifts them from the
                                                stored data
                                            {%- else %}, the import loads them again
                                            {%- endif %}
                                        </span>
                                    {% endfor %}
                                    {# Where their events stand: the version of StreamEvents that wrote them #}
                                    {% set streamVersions = check.streamVersions|default([]) %}
                                    {% if streamVersions and check.documents > 0 %}
                                        <span class="system-versions" aria-hidden="true">
                                            {% for row in streamVersions %}
                                                {% set share = (row.documents / check.documents * 100)|round(2) %}
                                                <span
                                                    class="system-version is-{{ row.state }}"
                                                    style="width: {{ share }}%"
                                                    title="Events of version {{ row.version }}"
                                                ></span>
                                            {% endfor %}
                                        </span>
                                    {% endif %}
                                    {% for row in streamVersions %}
                                        <span class="system-list-meta system-version-row">
                                            <span class="system-version-key is-{{ row.state }}"></span>
                                            {% if row.version == 0 -%}
                                                Events not written yet:
                                            {%- else -%}
                                                Events of version {{ row.version }}:
                                            {%- endif %}
                                            {{ row.documents|number_format(0, '.', ',') }}
                                            {%- if row.state == 'current' %}, current
                                            {%- else %}, the backfill writes their events again
                                            {%- endif %}
                                        </span>
                                    {% endfor %}
                                </div>
                                {{ system.result(check.result) }}
                            </li>
                        {% endfor %}
                        {% if sweep is not null %}
                            {% set round = sweep.round %}
                            <li class="system-list-item">
                                <div class="system-list-text">
                                    <span class="system-list-title">Changes compared with Gerrit</span>
                                    <span class="system-list-meta">
                                        {%- if round.until is null -%}
                                            The next run of "Update Gerrit changes" starts a round at the newest change
                                        {%- else -%}
                                            This round started {{ round.started|date('j M Y H:i') }}
                                            and compared about {{ (sweep.share * 100)|round(0, 'floor') }} % of the
                                            changes, those updated since {{ round.until|date('j M Y H:i') }}.
                                            So far {{ round.added|number_format(0, '.', ',') }} were missing,
                                            {{ round.removed|number_format(0, '.', ',') }} removed
                                        {%- endif -%}
                                    </span>
                                    {% if round.until is not null %}
                                        <span class="system-versions" aria-hidden="true">
                                            <span
                                                class="system-version is-current"
                                                style="width: {{ (sweep.share * 100)|round(2) }}%"
                                            ></span>
                                        </span>
                                    {% endif %}
                                    <span class="system-list-meta">
                                        {%- if round.lastFinished is null -%}
                                            No round has finished yet
                                        {%- else -%}
                                            The last round ran from {{ round.lastStarted|date('j M Y H:i') }}
                                            to {{ round.lastFinished|date('j M Y H:i') }}:
                                            {{ round.lastAdded|number_format(0, '.', ',') }} changes were missing,
                                            {{ round.lastRemoved|number_format(0, '.', ',') }} removed
                                        {%- endif -%}
                                    </span>
                                    {% if sweep.result != constant('App\\Enum\\SystemCheckEnum::OK') %}
                                        <span class="system-list-detail">
                                            Each run of "Update Gerrit changes" compares up to 10,000 changes with
                                            Gerrit, from the newest to the oldest. It loads those the index lacks and
                                            removes those Gerrit does not show. A round takes half an hour when the
                                            index is complete. The check is fine once a round found nothing to add or
                                            remove.
                                        </span>
                                    {% endif %}
                                </div>
                                {{ system.result(sweep.result) }}
                            </li>
                        {% endif %}
                    </ul>
                </section>

                {% if users is not null %}
                    <section class="system-panel system-panel-wide" id="system-users">
                        <header class="system-panel-header">
                            <h2 class="runs-heading">Users</h2>
                            {{ system.result(checks['Users']) }}
                        </header>
                        <div class="runs-table-card">
                            <div class="system-list-item">
                                <div class="system-list-text">
                                    <span class="system-list-title">{{ users.summary }}</span>
                                    {% if users.reasons %}
                                        <span class="system-list-meta">{{ users.reasons }}</span>
                                    {% endif %}
                                    {% if users.emails %}
                                        <span class="system-list-meta">{{ users.emails }}</span>
                                    {% endif %}
                                    {% if users.hint %}
                                        <span class="system-list-detail">{{ users.hint }}</span>
                                    {% endif %}
                                </div>
                                {{ system.result(users.result) }}
                            </div>
                            {% if withoutUsernameCount > 0 %}
                                <div class="system-list-item">
                                    <a class="system-list-title"
                                       href="{{ path('management_people', {'view': 'no-username'}) }}">
                                        {{- withoutUsernameCount|number_format(0, '.', ',') }}
                                        {{ withoutUsernameCount == 1 ? 'account' : 'accounts' }} of Forge and Gerrit
                                        without a username: ask their source or link them under People
                                    </a>
                                </div>
                            {% endif %}
                        </div>
                    </section>
                {% endif %}
            {% endif %}

            <section class="system-panel system-panel-wide" id="system-application">
                <header class="system-panel-header">
                    <h2 class="runs-heading">Application</h2>
                </header>
                <article class="runs-card">
                    <dl class="runs-facts">
                        <div><dt>PHP</dt><dd class="runs-numeric">{{ application.php }}</dd></div>
                        <div><dt>Symfony</dt><dd class="runs-numeric">{{ application.symfony }}</dd></div>
                        <div><dt>Environment</dt><dd><code>{{ application.environment }}</code>{% if application.debug %} <span class="runs-muted">with debug</span>{% endif %}</dd></div>
                        <div><dt>Imports</dt><dd><a href="{{ path('management_command_runs') }}">Command runs</a></dd></div>
                    </dl>
                </article>
            </section>
            </div>

        </div>
    </div>
{% endblock %}
