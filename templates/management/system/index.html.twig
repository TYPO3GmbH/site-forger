{% extends 'base.html.twig' %}
{% block title %}System{% endblock %}
{% block page_title %}System{% endblock %}

{#
 # What Forger runs on and whether its data is complete, see App\Controller\SystemController.
 # The layout comes from _command-runs.scss and _system.scss, the colors of the results from the status pills in _status.scss.
 #}

{% macro result(result) %}
    <span class="status-pill status-pill-{{ result.severity }}">{{ result.label }}</span>
{% endmacro %}

{# The answer of Forge for a person it does not know, see UserHealth::answers(); the login for the others #}
{% macro unmappedDetail(user) %}
    {%- if not user.gone -%}
        {{ user.username ? 'login ' ~ user.username : 'no login' }}
    {%- elseif user.goneStatus is null -%}
        answer not stored
    {%- else -%}
        {{ user.goneStatus == 403 ? 'refused' : 'not found' }} ({{ user.goneStatus }})
    {%- endif -%}
{% endmacro %}

{% macro bytes(bytes) %}
    {%- if bytes is null -%}
        –
    {%- elseif bytes >= 1073741824 -%}
        {{ (bytes / 1073741824)|number_format(1, '.', ',') }} GB
    {%- elseif bytes >= 1048576 -%}
        {{ (bytes / 1048576)|number_format(1, '.', ',') }} MB
    {%- else -%}
        {{ (bytes / 1024)|number_format(0, '.', ',') }} KB
    {%- endif -%}
{% endmacro %}

{% block body %}
    {% import _self as system %}
    {% set configurationLabels = {
        'current': 'Built from the configuration as it is',
        'outdated': 'The configuration changed since, app:elasticsearch:setup builds it again',
        'unknown': 'Built before the configuration was stored with it, app:elasticsearch:setup compares the mapping',
        'missing': 'No index has this alias, app:elasticsearch:setup creates it',
    } %}
    {% set waiting = pending|filter(check => check.result != constant('App\\Enum\\SystemCheckEnum::OK')) %}
    {% set outdated = 0 %}
    {% for check in waiting %}{% set outdated = outdated + check.matches %}{% endfor %}

    <div class="content-section content-section-small runs system">
        <div class="container">

            <div class="runs-intro">
                <p>
                    What Forger runs on and whether its data is complete. The page only reads, it changes nothing.
                    Documents an older version of the import wrote get the newer data by themselves: the deltas load
                    some of them again in every run.
                </p>
            </div>

            {% if not elasticsearch.reachable %}
                <section class="runs-notice" role="alert">
                    <span class="runs-notice-icon" aria-hidden="true">!</span>
                    <div class="runs-notice-body">
                        <p class="runs-notice-title">Elasticsearch cannot be reached <span class="runs-muted">Lists, search and imports do not work.</span></p>
                        <pre class="system-error">{{ elasticsearch.error }}</pre>
                    </div>
                </section>
            {% elseif waiting is not empty %}
                <section class="runs-notice system-notice-attention" role="status">
                    <span class="runs-notice-icon" aria-hidden="true">!</span>
                    <div class="runs-notice-body">
                        <p class="runs-notice-title">
                            {{ outdated|number_format(0, '.', ',') }} {{ outdated == 1 ? 'document' : 'documents' }} of an older import
                            <span class="runs-muted">Everything works, they show without the newer data until the deltas load them again.</span>
                        </p>
                    </div>
                </section>
            {% endif %}

            <div class="runs-stats">
                <div class="runs-stat">
                    <span class="runs-stat-label">Overall</span>
                    <span class="runs-stat-value">{{ system.result(overall) }}</span>
                    <span class="runs-stat-note">The worst of the checks below</span>
                </div>
                <div class="runs-stat">
                    <span class="runs-stat-label">Elasticsearch</span>
                    <span class="runs-stat-value runs-numeric">{{ elasticsearch.version ?? '–' }}</span>
                    <span class="runs-stat-note">{{ system.result(elasticsearch.versionResult) }} needs {{ minimumVersion }} or newer 7.x</span>
                </div>
                <div class="runs-stat">
                    <span class="runs-stat-label">Cluster</span>
                    <span class="runs-stat-value">{{ elasticsearch.health ?? '–' }}</span>
                    <span class="runs-stat-note">{{ system.result(elasticsearch.healthResult) }}{% if elasticsearch.reachable %} {{ elasticsearch.nodes }} {{ elasticsearch.nodes == 1 ? 'node' : 'nodes' }}{% endif %}</span>
                </div>
                <div class="runs-stat">
                    <span class="runs-stat-label">Of an older import</span>
                    <span class="runs-stat-value runs-numeric{{ outdated > 0 ? ' runs-tone-warning' }}">{{ outdated|number_format(0, '.', ',') }}</span>
                    <span class="runs-stat-note">Documents the deltas load again</span>
                </div>
            </div>

            {% if elasticsearch.reachable %}
                <section class="runs-section">
                    <h2 class="runs-heading">Elasticsearch</h2>
                    <article class="runs-card">
                        <dl class="runs-facts">
                            <div><dt>Version</dt><dd class="runs-numeric">{{ elasticsearch.version }}</dd></div>
                            <div><dt>Cluster</dt><dd>{{ elasticsearch.cluster }}</dd></div>
                            <div><dt>Health</dt><dd>{{ elasticsearch.health }}</dd></div>
                            <div><dt>Nodes</dt><dd class="runs-numeric">{{ elasticsearch.nodes }}</dd></div>
                            <div><dt>Unassigned shards</dt><dd class="runs-numeric">{{ elasticsearch.unassignedShards }}</dd></div>
                        </dl>
                        <p class="system-note runs-muted">
                            The search in the filters of people needs {{ minimumVersion }}: before, the wildcard query cannot ignore the case.
                            {% if elasticsearch.health == 'yellow' and elasticsearch.nodes == 1 %}
                                "Yellow" on a single node is fine: it has no second node for the replicas, the data is complete.
                            {% endif %}
                        </p>
                    </article>
                </section>

                <section class="runs-section">
                    <h2 class="runs-heading">Indices</h2>
                    <div class="runs-table-card">
                        <table class="runs-table">
                            <thead>
                                <tr>
                                    <th scope="col">Alias</th>
                                    <th scope="col">Index</th>
                                    <th scope="col" class="runs-numeric">Documents</th>
                                    <th scope="col" class="runs-numeric">Size</th>
                                    <th scope="col">Configuration</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for index in indices %}
                                    <tr>
                                        <td><code>{{ index.alias }}</code></td>
                                        <td>{% if index.index %}<code>{{ index.index }}</code>{% else %}<span class="runs-muted">none</span>{% endif %}</td>
                                        <td class="runs-numeric">{{ index.documents is null ? '–' : index.documents|number_format(0, '.', ',') }}</td>
                                        <td class="runs-numeric runs-nowrap">{{ system.bytes(index.bytes) }}</td>
                                        <td>
                                            {{ system.result(index.result) }}
                                            <span class="runs-muted system-detail">{{ configurationLabels[index.configuration] }}</span>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </section>

                <section class="runs-section">
                    <h2 class="runs-heading">Versions of the import</h2>
                    <div class="system-checks">
                        {% for check in pending %}
                            <article class="runs-card">
                                <header class="runs-card-header">
                                    <span class="system-check-label">{{ check.label }}</span>
                                    {{ system.result(check.result) }}
                                </header>
                                <p class="system-check-count">
                                    <strong class="runs-numeric">{{ check.matches|number_format(0, '.', ',') }}</strong>
                                    of {{ check.documents|number_format(0, '.', ',') }} {{ check.index == 'issue' ? 'issues' : 'changes' }} older than version {{ check.version }}
                                </p>
                                <p class="runs-muted system-check-description">{{ check.description }}</p>
                            </article>
                        {% endfor %}
                    </div>
                </section>

                {% if users is not null %}
                    <section class="runs-section">
                        <h2 class="runs-heading">Users</h2>
                        <article class="runs-card">
                            <header class="runs-card-header">
                                <span class="system-check-label">{{ users.summary }}</span>
                                {{ system.result(users.result) }}
                            </header>
                            {% if users.reasons %}<p class="system-users-reasons">{{ users.reasons }}</p>{% endif %}
                            {% if users.hint %}<p class="runs-muted system-check-description">{{ users.hint }}</p>{% endif %}
                            {% if unmappedUsers is not empty %}
                                <details class="system-unmapped">
                                    <summary>
                                        <span class="system-unmapped-title">
                                            {{- unmapped|number_format(0, '.', ',') }} {{ unmapped == 1 ? 'person' : 'people' -}}
                                            {{ ' ' }}Forge was asked for, without an email
                                        </span>
                                        <span class="system-unmapped-icon">{{ icon('actions-chevron-down') }}</span>
                                    </summary>
                                    <div class="system-unmapped-list">
                                        <table class="system-unmapped-table">
                                            <thead>
                                                <tr>
                                                    <th scope="col">Name</th>
                                                    <th scope="col">On Forge</th>
                                                    <th scope="col">Detail</th>
                                                    <th scope="col">Asked on</th>
                                                </tr>
                                            </thead>
                                            {% for group in [
                                                {'label': 'Unknown to Forge', 'users': unmappedUsers|filter(user => user.gone)},
                                                {'label': 'No email on Forge', 'users': unmappedUsers|filter(user => not user.gone)},
                                            ] %}
                                                {% set count = group.users|length %}
                                                {% if count > 0 %}
                                                    <tbody>
                                                        <tr class="system-unmapped-group">
                                                            <th scope="rowgroup" colspan="4">
                                                                {{ group.label }} <span>{{ count|number_format(0, '.', ',') }}</span>
                                                            </th>
                                                        </tr>
                                                        {% for user in group.users %}
                                                            <tr>
                                                                <td class="system-unmapped-name">{{ user.name ?: '–' }}</td>
                                                                <td class="system-unmapped-forge">
                                                                    {%- if user.forgeId is not null -%}
                                                                        <a href="{{ forge_user_url(user.forgeId) }}" target="_blank" rel="noopener">
                                                                            {{- '#' ~ user.forgeId -}}
                                                                        </a>
                                                                    {%- endif -%}
                                                                </td>
                                                                <td class="system-unmapped-detail">{{ _self.unmappedDetail(user) }}</td>
                                                                <td class="system-unmapped-date">
                                                                    {{- user.fetchedOn ? user.fetchedOn|date('j M Y, H:i', 'UTC') ~ ' UTC' -}}
                                                                </td>
                                                            </tr>
                                                        {% endfor %}
                                                    </tbody>
                                                {% endif %}
                                            {% endfor %}
                                        </table>
                                    </div>
                                </details>
                            {% endif %}
                        </article>
                    </section>
                {% endif %}
            {% endif %}

            <section class="runs-section">
                <h2 class="runs-heading">Application</h2>
                <article class="runs-card">
                    <dl class="runs-facts">
                        <div><dt>PHP</dt><dd class="runs-numeric">{{ application.php }}</dd></div>
                        <div><dt>Symfony</dt><dd class="runs-numeric">{{ application.symfony }}</dd></div>
                        <div><dt>Environment</dt><dd><code>{{ application.environment }}</code>{% if application.debug %} <span class="runs-muted">with debug</span>{% endif %}</dd></div>
                        <div><dt>Imports</dt><dd><a href="{{ path('management_command_runs') }}">Command runs</a></dd></div>
                    </dl>
                </article>
            </section>

        </div>
    </div>
{% endblock %}
