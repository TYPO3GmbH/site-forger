{% extends 'base.html.twig' %}

{% block title %}Backports{% endblock %}

{% block body %}

    <div class="content-section bg-transparent">
        <div class="container">
            <h1>{{sum}} backports to do</h1>
            <table class="table table-striped boardcolumn">
                <tr>
                    <th>master</th>
                    <th>9.5</th>
                    <th>8.7</th>
                </tr>
                {% for backport in backports %}
                    <tr>
                        <td>
                            <div class="cards">
                                {% include '/_partials/ReviewCard.html.twig' with {'card': backport.releases.t3_master, 'mode': 'backport'} only %}
                            </div>
                        </td>
                        <td>
                            {% if backport.releases.t3_95 == 'missing' %}
                                <div class="cards">
                                    {% include '/_partials/ReviewCard.html.twig' with  {'mode': 'backport'} only %}
                                </div>
                            {% endif %}
                            {% if backport.releases.t3_95.id is defined %}
                                <div class="cards">
                                    {% include '/_partials/ReviewCard.html.twig' with  {'card': backport.releases.t3_95, 'mode': 'backport'} only %}
                                </div>
                            {% endif %}
                        </td>
                        <td>
                            {% if backport.releases.t3_87 == 'missing' %}
                                <div class="cards">
                                    {% include '/_partials/ReviewCard.html.twig' with  {'mode': 'backport'} only %}
                                </div>
                            {% endif %}
                            {% if backport.releases.t3_87.id is defined %}
                                <div class="cards">
                                    {% include '/_partials/ReviewCard.html.twig' with  {'card': backport.releases.t3_87, 'mode': 'backport'} only %}
                                </div>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </table>
        </div>
    </div>
{% endblock %}
