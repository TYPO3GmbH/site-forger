{% extends 'base.html.twig' %}
{% block title %}Stale Issues{% endblock %}
{% block body %}

<div class="content-section bg-transparent">
    <div class="container">
        <h1>Stale issues</h1>
        {% if issues %}
            {% include '_partials/alert.html.twig' with {'message': '<strong>Stale issues found!</strong> Oops, I have found ' ~ issues|length ~ ' stale issues', 'style': 'warning'} %}
            <table class="table table-striped table-bordered">
                <tr>
                    <th>Link</th>
                    <th>Title</th>
                </tr>
                {% for issue in issues %}
                    <tr>
                        <td>{{ issue.id }}</td>
                        <td><a href="https://forge.typo3.org/issues/{{ issue.id }}" target="_blank">{{ issue.subject }}</a></td>
                    </tr>
                {% endfor %}
            </table>
        {% else %}
            {% include '_partials/alert.html.twig' with {'message': '<strong>No stale issues!</strong> Good job, I couldn\'t find any stale issue!', 'style': 'success'} %}
        {% endif %}
    </div>
</div>

{% endblock %}
