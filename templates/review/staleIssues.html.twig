{% extends 'base.html.twig' %}

{% block title %}Stale Issues{% endblock %}

{% block body %}

<div class="content-section bg-transparent">
    <div class="container">
        <h1>Stale issues</h1>
        {% if issues %}
            <div class="alert alert-warning" role="alert">
                <strong>Stale issues found!</strong> Oops, I have found {{ issues|length }} stale issues
            </div>
            <table class="table table-striped table-bordered">
                <tr>
                    <th>Link</th>
                    <th>Title</th>
                </tr>
                {% for issue in issues %}
                    <tr>
                        <td>{{ issue.id }}</td>
                        <td><a href="https://forge.typo3.org/issues/{{ issue.id }}" target="_blank">{{ issue.subject }}</a></td>
                    </tr>
                {% endfor %}
            </table>
        {% else %}
            <div class="alert alert-success" role="alert">
                <strong>No stale issues!</strong> Good job, I couldn't find any stale issue!
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
