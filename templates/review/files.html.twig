{% extends 'base.html.twig' %}
{% block title %}Find by file{% endblock %}
{% block body %}

    {% include '_partials/searchbar.html.twig' with {'searchRouteName': routeName} %}
    <div class="content-section bg-transparent">
        <div class="container">
            {% if results is defined and results|length > 0 %}
                {% include '_partials/review_view.html.twig' %}
            {% else %}
                {% include '_partials/alert.html.twig' with {'message': 'We couldn\'t find any review matching your query. Please try searching for a full path name.'} %}
            {% endif %}
        </div>
    </div>

{% endblock %}
