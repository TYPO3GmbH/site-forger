{% extends 'base.html.twig' %}
{% block title %}Stale Issues{% endblock %}
{% block headline %}Stale Issues{% endblock %}
{% block body %}

    <div class="content-section bg-transparent">
        <div class="container">

            {% if issues %}
                <div class="card">
                    <div class="datatable">
                        <table class="datatable-table">
                            <thead>
                                <tr>
                                    <th scope="col" colspan="4">Issue</th>
                                    <th scope="col">Author</th>
                                    <th scope="col">Created</th>
                                    <th scope="col">Updated</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for issue in issues %}
                                    <tr>
                                        <th data-type="icon"><a href="https://forge.typo3.org/issues/{{ issue.id }}" class="datatable-link-highlight" rel="noopener" target="_blank"><i class="fas fa-fw fa-search-plus"></i></a></th>
                                        <th data-type="id">{{ issue.id }}</th>
                                        <th data-type="title">
                                            <strong>{{ issue.subject }}</strong><br>
                                            <small>{% if issue.category.name is defined %}Category: {{ issue.category.name }}{% endif %}</small>
                                        </th>
                                        <th data-type="badge"><span class="badge badge-secondary">{{ issue.status.name }}</span></th>
                                        <td>{{ issue.author.name }}</td>
                                        <td>
                                            {{ relativetime(to_datetime(issue.created_on)) }}<br>
                                            <small>{{ localtime(to_datetime(issue.created_on)) }}</small>
                                        </td>
                                        <td>
                                            {{ relativetime(to_datetime(issue.updated_on)) }}<br>
                                            <small>{{ localtime(to_datetime(issue.updated_on)) }}</small>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            {% else %}
                {% include '_partials/alert.html.twig' with {'message': '<strong>No stale issues!</strong> Good job, I couldn\'t find any stale issue!', 'style': 'success'} %}
            {% endif %}
        </div>
    </div>

{% endblock %}
