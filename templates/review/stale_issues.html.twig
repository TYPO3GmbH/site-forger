{% extends 'base.html.twig' %}
{% block title %}Stale issues{% endblock %}
{#
 # The open issues nobody works on, the stages "Stale" and "Orphaned" of App\Enum\ActivityEnum, see
 # App\Report\StaleIssues: by default the ones lying still the longest first, in an order of IssueSortEnum, a page at
 # a time. Each row names its changes in Gerrit and their states; an issue "Under Review" without any change says so.
 # No orange band: the title stands on the gray of the page, below the breadcrumb.
 # Expects: issues (StaleIssue objects, see StaleIssues::page()), stages (the ActivityEnum cases of the list),
 #          totalResults, startingAtItem, endingAtItem, pagesToLinkTo, currentPage, sort, sortOptions, sortParameter
 #          (the order in links, empty for the default)
 #}
{% block body %}
    {% import '_macros/sort.html.twig' as sorting %}
    {% set since = stages|first.minimumDays %}
    <div class="content-section content-section-small">
        <div class="container">
            <header class="page-intro">
                <h1 class="page-intro-title">Stale issues</h1>
                <p class="page-intro-summary">
                    {% if totalResults == 0 %}
                        Every open issue had activity within the last {{ since }} days.
                    {% else %}
                        <strong>{{ totalResults }}</strong> open issues without activity for {{ since }} days or more: {{ stages|map(stage => stage.label|lower ~ ' (' ~ stage.description|lower|replace({'no activity for ': ''}) ~ ')')|join(' or ') }}.
                    {% endif %}
                </p>
            </header>

            {% if issues is not empty %}
                <div class="results-toolbar">
                    {% include '_partials/pagination.html.twig' with {
                        'resultsTotal': totalResults,
                        'resultsFrom': startingAtItem,
                        'resultsTo': endingAtItem,
                    } only %}
                    {{ sorting.select(path('issues_stale'), sort, sortOptions, {}) }}
                </div>
                <ul class="row-list row-list-panel">
                    {% for item in issues %}
                        {% set note %}
                            {%- if item.changes is not empty -%}
                                {{ item.changes|length == 1 ? 'Change' : 'Changes' }}: {{ item.changes|map(change => change.id ~ ' ' ~ (change.state is null ? 'not in Forger' : change.state.label|lower))|join(' · ') }}
                            {%- elseif (item.issue.status.name ?? null) == constant('App\\Enum\\IssueStatusEnum::UNDER_REVIEW').label -%}
                                Under review, but no change linked
                            {%- endif -%}
                        {% endset %}
                        <li>{% include '_partials/row/issue.html.twig' with {'issue': item.issue, 'size': 'l', 'note': note} only %}</li>
                    {% endfor %}
                </ul>
                {% include '_partials/pagination.html.twig' with {
                    'pages': pagesToLinkTo,
                    'current': currentPage,
                    'last': lastPage ?? null,
                    'routeName': 'issues_stale',
                    'arguments': sortParameter,
                } only %}
            {% endif %}
        </div>
    </div>
{% endblock %}
