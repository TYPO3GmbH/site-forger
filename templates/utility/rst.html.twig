{% extends 'base.html.twig' %}
{% block title %}ReST helper{% endblock %}
{% block page_title %}ReST helper{% endblock %}
{% block body %}

    {% set types = {breaking: 'Breaking', deprecation: 'Deprecation', feature: 'Feature', important: 'Important'} %}
    {# The hints follow "File content" in Changelog/Howto.rst of the core #}
    {% set sections = [
        {id: 'description', label: 'Description', types: 'breaking deprecation feature important', hint: 'A short summary of the change and which part of the Core it affects.'},
        {id: 'impact', label: 'Impact', types: 'breaking deprecation feature', hint: 'What the change means, e.g. "Frontend output may change" or "Configuration of xy is easier".'},
        {id: 'affected', label: 'Affected installations', types: 'breaking deprecation', hint: 'When an installation is affected, e.g. "Extension xy is in use" or "TypoScript functionality xy is used".'},
        {id: 'migration', label: 'Migration', types: 'breaking deprecation', hint: 'How to cope with the change, ideally with code examples before and after.'},
    ] %}

    <div class="content-section rst-editor-section">
        <div class="container">
            <div class="flashmessage-container"></div>
            <form class="rst-editor form-rst-helper" autocomplete="off">

                {# The result, always in view #}
                <section class="rst-panel rst-result" aria-label="File">
                    <div class="rst-result-status" data-container="status" aria-live="polite">
                        <span class="rst-status-summary" data-output="status-summary"></span>
                        <ul class="rst-status-items" data-container="status-items"></ul>
                    </div>
                    <div class="rst-file-actions">
                        <button type="button" class="rst-button" data-action="copy" data-copy="content">
                            {{ icon('actions-clipboard') }} <span>Copy content</span>
                        </button>
                        <a class="rst-button rst-button-primary" data-action="download" href="#">
                            {{ icon('actions-download') }} <span>Download</span>
                        </a>
                    </div>
                    <div class="rst-result-file">
                        <code class="rst-filename" data-output="filename"></code>
                        <div class="rst-paths" data-container="changelog-paths"></div>
                    </div>
                </section>

                <div class="rst-workspace">
                    {# What the file is about #}
                    <aside class="rst-panel rst-meta">
                        <div class="rst-panel-title">
                            <h2>Details</h2>
                            <span class="rst-draft-state" data-output="draft-state"></span>
                            <button type="button" class="rst-link-button" data-action="reset" title="Discard the draft and start a new file">Start over</button>
                        </div>
                        <div class="rst-panel-scroll">
                            <div class="rst-field">
                                <label class="rst-label" for="ticketid">Ticket</label>
                                <div class="rst-ticket">
                                    <span class="rst-ticket-prefix">#</span>
                                    <input type="text" class="rst-input" id="ticketid" placeholder="99999" inputmode="numeric">
                                    <button class="rst-icon-button" type="button" data-action="fetch-ticket" title="Take the title from Forge" aria-label="Take the title from Forge">
                                        {{ icon('actions-search') }}
                                    </button>
                                </div>
                            </div>
                            <div class="rst-field">
                                <label class="rst-label" for="title">Title</label>
                                <textarea class="rst-input" id="title" rows="2"></textarea>
                            </div>
                            <div class="rst-field">
                                <span class="rst-label" id="type-label">Type</span>
                                <div class="rst-segmented" role="radiogroup" aria-labelledby="type-label">
                                    {% for value, label in types %}
                                        <input type="radio" id="classification-{{ value }}" name="classification" value="{{ value }}" data-title="{{ label }}"{% if loop.first %} checked{% endif %}>
                                        <label for="classification-{{ value }}">{{ label }}</label>
                                    {% endfor %}
                                </div>
                            </div>
                            <div class="rst-field">
                                <label class="rst-label" for="target">Target</label>
                                <select class="rst-input" id="target" name="target">
                                    {% for target in changelogTargets %}
                                        <option value="{{ target.directories|join(' ') }}">{{ target.label }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="rst-field">
                                <span class="rst-label" id="tags-label">Tags</span>
                                <div class="rst-chips" role="group" aria-labelledby="tags-label">
                                    {% for tag in tags %}
                                        <input type="checkbox" name="tag[]" value="{{ tag }}" id="tag-{{ loop.index }}" data-tag="topic">
                                        <label for="tag-{{ loop.index }}">{{ tag }}</label>
                                    {% endfor %}
                                </div>
                            </div>
                            <div class="rst-field">
                                <label class="rst-label" for="extensionTag">Core extension</label>
                                <select name="tag[]" id="extensionTag" class="rst-input">
                                    <option value="">Select …</option>
                                    {% for extensionKey in extensionKeys %}
                                        <option value="ext:{{ extensionKey }}">{{ extensionKey }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="rst-field" data-classified-as="breaking deprecation">
                                <label class="rst-label" for="scannerTag">
                                    ExtensionScanner
                                    <a href="https://docs.typo3.org/typo3cms/CoreApiReference/ApiOverview/ExtensionScanner/Index.html#connection-to-changelog-rst-files" target="_blank" rel="noopener">What is this?</a>
                                </label>
                                <select name="tag[]" id="scannerTag" class="rst-input">
                                    <option value="NotScanned">Not scanned</option>
                                    <option value="PartiallyScanned">Partially scanned</option>
                                    <option value="FullyScanned">Fully scanned</option>
                                </select>
                            </div>
                        </div>
                    </aside>

                    {# The sections of the type in the order of the file, or the file itself #}
                    <section class="rst-panel rst-main">
                        <div class="rst-main-head">
                            <div class="rst-switch" role="tablist" aria-label="View">
                                <button type="button" class="is-active" role="tab" aria-selected="true" data-view="write">Write</button>
                                <button type="button" role="tab" aria-selected="false" data-view="preview">Preview</button>
                            </div>
                            <div class="rst-toolbar" role="toolbar" aria-label="Insert ReST into the current section" data-view-only="write">
                                <div class="rst-tool-group">
                                    <button type="button" class="rst-tool" data-insert="wrap" data-before="**" data-after="**" title="Bold (Ctrl+B)"><strong>B</strong></button>
                                    <button type="button" class="rst-tool" data-insert="wrap" data-before="*" data-after="*" title="Italic (Ctrl+I)"><em>I</em></button>
                                    <button type="button" class="rst-tool rst-tool-code" data-insert="wrap" data-before="`" data-after="`" title="Inline code">``</button>
                                </div>
                                <div class="rst-tool-group">
                                    <button type="button" class="rst-tool rst-tool-code" data-insert="role" title="Inline code with a role, the selection becomes its content">:role:</button>
                                    <select class="rst-tool-select" data-role aria-label="Role of the inline code">
                                        {% for role in ['php', 'file', 'typoscript', 'yaml', 'js', 'html', 'guilabel', 'ref'] %}
                                            <option>{{ role }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                                <div class="rst-tool-group">
                                    <button type="button" class="rst-tool" data-insert="link" title="Link, the selection becomes its text">Link</button>
                                    <button type="button" class="rst-tool" data-insert="list" title="Bullet list, every selected line becomes an item">List</button>
                                </div>
                                <div class="rst-tool-group">
                                    <button type="button" class="rst-tool" data-insert="code-block" title="Code block, the selection becomes its content">Code block</button>
                                    <select class="rst-tool-select" data-code-language aria-label="Language of the code block">
                                        {% for language in ['php', 'typoscript', 'yaml', 'html', 'javascript', 'shell', 'xml', 'sql', 'none'] %}
                                            <option>{{ language }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="rst-panel-scroll rst-sections" data-view-only="write">
                            {% for section in sections %}
                                <div class="rst-section" data-section="{{ section.id }}" data-label="{{ section.label }}" data-classified-as="{{ section.types }}">
                                    <div class="rst-section-head">
                                        <span class="rst-section-title" id="section-{{ section.id }}-label">{{ section.label }}</span>
                                        <span class="rst-section-hint">{{ section.hint }}</span>
                                    </div>
                                    <div class="rst-section-editor" data-editor-container aria-labelledby="section-{{ section.id }}-label"></div>
                                </div>
                            {% endfor %}
                        </div>
                        <div class="rst-preview" data-preview-container data-view-only="preview" hidden></div>
                    </section>
                </div>

            </form>
            <template data-template="changelog-path">
                <div class="rst-path">
                    <code data-output="directory"></code>
                    <button type="button" class="rst-link-button" data-action="copy"><span>Copy path</span></button>
                </div>
            </template>
        </div>
    </div>

{% endblock %}
