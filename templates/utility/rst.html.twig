{% extends 'base.html.twig' %}
{% import '_macros/buttons.html.twig' as macros %}
{% block title %}ReST Helper{% endblock %}
{% block headline %}ReST Helper{% endblock %}
{% block body %}

    <div class="content-section content-section-grow">
        <div class="container">
            <div class="flashmessage-container"></div>
            <form class="form-rst-helper" autocomplete="off">

                <div class="row">
                    <div class="col-md-4">

                        <div class="card">
                            <div class="card-body">
                                <label for="ticketid">Ticket ID</label>
                                <div class="input-group">
                                    <input type="text" class="form-control" id="ticketid" placeholder="99999" autocomplete="off" required>
                                    <button class="btn btn-secondary" type="button" data-action="fetch-ticket"><i class="fas fa-search"></i></button>
                                </div>
                            </div>
                            <div class="card-body">
                                <div class="form-group">
                                    <label>Type</label>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" id="classification-breaking" name="classification" autocomplete="off" value="breaking" checked>
                                        <label class="form-check-label" for="classification-breaking">Breaking</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" id="classification-deprecation"name="classification" autocomplete="off" value="deprecation">
                                        <label class="form-check-label" for="classification-deprecation">Deprecation</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" id="classification-feature" name="classification" autocomplete="off" value="feature">
                                        <label class="form-check-label" for="classification-feature">Feature</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" id="classification-important" name="classification" autocomplete="off" value="important">
                                        <label class="form-check-label" for="classification-important">Important</label>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                    <div class="col-md-8">
                        <div class="card">
                            <div class="card-body" data-classified-as="breaking deprecation feature important">
                                <label for="title">Title</label>
                                <input type="text" class="form-control text-monospace" id="title" autocomplete="off" required disabled>
                            </div>
                            <div hidden class="card-body" data-classified-as="breaking deprecation feature important">
                                <label for="description">Description</label>
                                <textarea class="form-control text-monospace" rows="5" id="description" title="Description" required disabled></textarea>
                            </div>
                            <div hidden class="card-body" data-classified-as="breaking deprecation feature">
                                <label for="impact">Impact</label>
                                <textarea class="form-control text-monospace" rows="5" id="impact" title="Impact" required disabled></textarea>
                            </div>
                            <div hidden class="card-body" data-classified-as="breaking deprecation">
                                <label for="affected">Affected Installations</label>
                                <textarea class="form-control text-monospace" rows="5" id="affected" title="Affected installations" required disabled></textarea>
                            </div>
                            <div hidden class="card-body" data-classified-as="breaking deprecation">
                                <label for="migration">Migration</label>
                                <textarea class="form-control text-monospace" rows="5" id="migration" title="Migration" required disabled></textarea>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card">
                    <div hidden class="card-body" data-classified-as="breaking deprecation feature important">
                        <label>Tags</label>
                        <div class="form-row">
                            {% for tag in tags %}
                                <div class="col-sm-3">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="tag[]" value="{{ tag }}" id="tag-{{ loop.index }}">
                                        <label class="form-check-label" for="tag-{{ loop.index }}">{{ tag }}</label>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                    <div hidden class="card-body" data-classified-as="breaking deprecation feature important">
                        <label for="extensionTag">Core Extension</label>
                        <select name="tag[]" id="extensionTag" class="form-select" required>
                            <option value=""></option>
                            {% for extensionKey in extensionKeys %}
                                <option value="ext:{{ extensionKey }}">{{ extensionKey }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div hidden class="card-body" data-classified-as="breaking deprecation">
                        <label>ExtensionScanner Tags</label>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" id="tag-not-scanned" name="tag[]" autocomplete="off" value="NotScanned" checked>
                            <label class="form-check-label" for="tag-not-scanned">Not scanned</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" id="tag-partially-scanned" name="tag[]" autocomplete="off" value="PartiallyScanned" checked>
                            <label class="form-check-label" for="tag-partially-scanned">Partially scanned</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" id="tag-fully-scanned" name="tag[]" autocomplete="off" value="FullyScanned" checked>
                            <label class="form-check-label" for="tag-fully-scanned">Fully scanned</label>
                        </div>
                        <small class="form-text text-muted"><a href="https://docs.typo3.org/typo3cms/CoreApiReference/ApiOverview/ExtensionScanner/Index.html#connection-to-changelog-rst-files" target="_blank" rel="noopener">More information about this tags</a></small>
                    </div>
                </div>


                <div hidden class="form-group" data-classified-as="breaking deprecation feature important">
                    {{ macros.submit('Create ReST manual', 'primary', '', {toggle: 'modal', target: '#changelogModal'}) }}
                </div>
            </form>
        </div>
    </div>

    <div class="modal fade" id="changelogModal" tabindex="-1" role="dialog" aria-labelledby="changelogModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-xl" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="changelogModalLabel"></h5>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <textarea class="form-control" rows="20" style="font-family:monospace;" readonly></textarea>
                </div>
            </div>
        </div>
    </div>

    <div class="content-section content-section-small bg-shaded">
        <div class="container">
            {% include '_partials/utility/rst_snippets.html.twig' %}
        </div>
    </div>

{% endblock %}
