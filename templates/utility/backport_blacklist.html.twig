{% extends 'base.html.twig' %}
{% import '_macros/buttons.html.twig' as buttons %}
{% block title %}Backport exclusions{% endblock %}
{% block page_title %}Backport exclusions{% endblock %}
{# Beside the title, on its right #}
{% block page_actions %}{{ buttons.link(path('utilities_backport_create'), 'Create new', 'primary', 'actions-plus') }}{% endblock %}
{% block body %}
    {% set deleteToken = csrf_token(constant('App\\Controller\\UtilityController::DELETE_TOKEN_ID')) %}

    <div class="content-section bg-transparent">
        <div class="container">
            <div class="row">
                <div class="col-md-12">
                    {% if items %}
                        <div class="card">
                            <div class="datatable">
                                <table class="datatable-table">
                                    <thead>
                                    <tr>
                                        <th scope="col">Change ID</th>
                                        <th scope="col">Actions</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    {% for item in items %}
                                        <tr>
                                            <th>
                                                <strong>{{ item.changeId }}</strong><br>
                                                <small>{{ item.comment }}</small>
                                            </th>
                                            <td>
                                                {% set delete = path(
                                                    'utilities_backport_delete',
                                                    {'changeId': item.changeId},
                                                ) %}
                                                <form
                                                    method="post"
                                                    action="{{ delete }}"
                                                    data-confirm-title="Remove the exclusion of {{ item.changeId }}?"
                                                    data-confirm="The backports list the change again."
                                                    data-confirm-button="Remove"
                                                >
                                                    <input type="hidden" name="_token" value="{{ deleteToken }}">
                                                    <button type="submit" class="btn btn-danger">
                                                        {{- icon('actions-delete') }} Delete
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    {% else %}
                        {% include '_partials/alert.html.twig' with {'message': 'No changes are excluded from backports.', 'style': 'info'} %}
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

{% endblock %}
