{% extends 'base.html.twig' %}
{% import '_macros/buttons.html.twig' as buttons %}
{% block title %}Backport Blacklist{% endblock %}
{% block headline %}Backport Blacklist{% endblock %}
{% block body %}

    <div class="content-section bg-transparent">
        <div class="container">

            <div class="row">
                <div class="col-md-12">
                    <div class="float-right">
                        {{ buttons.link(
                            path('utilities_backport_create'),
                            'Create new',
                            'primary',
                            'plus'
                        ) }}
                    </div>
                </div>
            </div>
            <br>
            <div class="row">
                <div class="col-md-12">
                    {% if items %}
                        <div class="card">
                            <div class="datatable">
                                <table class="datatable-table">
                                    <thead>
                                    <tr>
                                        <th scope="col">Change ID</th>
                                        <th scope="col">Actions</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    {% for item in items %}
                                        <tr>
                                            <th>
                                                <strong>{{ item.changeId }}</strong><br>
                                                <small>{{ item.comment }}</small>
                                            </th>
                                            <td>
                                                {{ buttons.link(
                                                    path('utilities_backport_delete', {'changeId': item.changeId}),
                                                    'Delete',
                                                    'danger',
                                                    'trash'
                                                ) }}
                                            </td>
                                        </tr>
                                    {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    {% else %}
                        {% include '_partials/alert.html.twig' with {'message': '<strong>No blacklist items!</strong>', 'style': 'info'} %}
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

{% endblock %}
