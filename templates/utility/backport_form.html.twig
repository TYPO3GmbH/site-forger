{% extends 'base.html.twig' %}
{% block title %}Backport exclusions{% endblock %}
{% block page_title %}Backport exclusions{% endblock %}
{% block breadcrumb %}
    {% import '_macros/breadcrumb.html.twig' as breadcrumb %}
    {{ breadcrumb.trail([{'label': 'Tools'}, {'label': 'Backport exclusions', 'url': path('utilities_backport_index')}, {'label': edit is defined ? 'Edit exclusion' : 'New exclusion'}]) }}
{% endblock %}
{% block body %}

    <div class="content-section">
        <div class="container">
            <h2>
                {% if edit is defined %}
                    Edit a backport exclusion
                {% else %}
                    Exclude a change from backports
                {% endif %}
            </h2>
            <div class="row">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-body">
                            {{ form_start(form) }}
                            {{ form_widget(form) }}
                            {{ form_end(form) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

{% endblock %}
