{% extends 'base.html.twig' %}
{% block title %}Backports{% endblock %}
{% block body %}
    {% set versions = ['main', '14.3', '13.4'] %}
    <div class="content-section bg-transparent">
        <div class="container-fluid">
            <h1>{{ sum ?? 0 }} backports to do</h1>
            <table class="table table-striped">
                <colgroup>
                    {% for version in versions %}
                        <col style="width: calc(100% / {{ versions|length }})">
                    {% endfor %}
                </colgroup>
                <tr>
                    {% for version in versions %}
                        <th>{{ version }}</th>
                    {% endfor %}
                </tr>
                {% for backport in backports %}
                    <tr>
                        {% for version in versions %}
                            {% set normalizedVersion = version|replace({'.': ''}) %}
                            {% set key = 't3_' ~ normalizedVersion %}
                            <td>
                                {% if backport.releases.(key) is defined and backport.releases.(key) == 'missing' %}
                                    {% include '_partials/review_card.html.twig' with {'card': null, 'mode': 'backport'} only %}
                                {% elseif backport.releases.(key).id is defined %}
                                    {% include '_partials/review_card.html.twig' with {'card': backport.releases.(key), 'mode': 'backport'} only %}
                                {% endif %}
                            </td>
                        {% endfor %}
                    </tr>
                {% endfor %}
            </table>
        </div>
    </div>

{% endblock %}
