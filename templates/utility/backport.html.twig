{% extends 'base.html.twig' %}
{% block title %}Backports{% endblock %}
{% block body %}

    <div class="content-section bg-transparent">
        <div class="container-fluid">
            <h1>{{ sum ?? 0 }} backports to do</h1>
            <table class="table table-striped">
                <tr>
                    <th>master</th>
                    <th>10.4</th>
                    <th>9.5</th>
                </tr>
                {% for backport in backports %}
                    <tr>
                        <td>
                            {% include '_partials/review_card.html.twig' with {'card': backport.releases.t3_master, 'mode': 'backport'} only %}
                        </td>
                        <td>
                            {% if backport.releases.t3_104 == 'missing' %}
                                {% include '_partials/review_card.html.twig' with {'card': null, 'mode': 'backport'} only %}
                            {% elseif backport.releases.t3_104.id is defined %}
                                {% include '_partials/review_card.html.twig' with {'card': backport.releases.t3_104, 'mode': 'backport'} only %}
                            {% endif %}
                        </td>
                        <td>
                            {% if backport.releases.t3_95 == 'missing' %}
                                {% include '_partials/review_card.html.twig' with {'card': null, 'mode': 'backport'} only %}
                            {% elseif backport.releases.t3_95.id is defined %}
                                {% include '_partials/review_card.html.twig' with {'card': backport.releases.t3_95, 'mode': 'backport'} only %}
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </table>
        </div>
    </div>

{% endblock %}
