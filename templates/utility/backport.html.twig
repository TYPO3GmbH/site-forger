{% extends 'base.html.twig' %}
{% block title %}Backports{% endblock %}
{% block body %}

    <div class="content-section bg-transparent">
        <div class="container-fluid">
            <h1>{{ sum ?? 0 }} backports to do</h1>
            <table class="table table-striped">
                <colgroup>
                    <col style="width: calc(100% / 3)">
                    <col style="width: calc(100% / 3)">
                    <col style="width: calc(100% / 3)">
                </colgroup>
                <tr>
                    <th>main</th>
                    <th>11.5</th>
                    <th>10.4</th>
                </tr>
                {% for backport in backports %}
                    <tr>
                        <td>
                            {% if backport.releases.t3_main == 'missing' %}
                                {% include '_partials/review_card.html.twig' with {'card': null, 'mode': 'backport'} only %}
                            {% elseif backport.releases.t3_main.id is defined %}
                                {% include '_partials/review_card.html.twig' with {'card': backport.releases.t3_main, 'mode': 'backport'} only %}
                            {% endif %}
                        </td>
                        <td>
                            {% if backport.releases.t3_115 == 'missing' %}
                                {% include '_partials/review_card.html.twig' with {'card': null, 'mode': 'backport'} only %}
                            {% elseif backport.releases.t3_115.id is defined %}
                                {% include '_partials/review_card.html.twig' with {'card': backport.releases.t3_115, 'mode': 'backport'} only %}
                            {% endif %}
                        </td>
                        <td>
                            {% if backport.releases.t3_104 == 'missing' %}
                                {% include '_partials/review_card.html.twig' with {'card': null, 'mode': 'backport'} only %}
                            {% elseif backport.releases.t3_104.id is defined %}
                                {% include '_partials/review_card.html.twig' with {'card': backport.releases.t3_104, 'mode': 'backport'} only %}
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </table>
        </div>
    </div>

{% endblock %}
