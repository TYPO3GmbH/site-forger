{% extends 'base.html.twig' %}
{% block title %}Statistics{% endblock %}
{#
 # The statistics: the board of the activity in a time window, see templates/stream/_frame.html.twig. At its end,
 # what was closed over the years. For a look now and then, the dashboard shows where work waits.
 #}
{% block page_title %}Statistics{% endblock %}
{% block page_summary %}
    What is open, what got done on Forge and in Gerrit, and how long work waits. Days and hours count in your time
    zone.
{% endblock %}
{% block body %}
    <div class="content-section content-section-small overview">
        <div class="container">
            {% include 'stream/_frame.html.twig' with {'view': 'statistics'} only %}
        </div>
    </div>
{% endblock %}
