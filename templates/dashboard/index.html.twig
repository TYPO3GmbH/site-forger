{% extends 'base.html.twig' %}
{% block title %}Dashboard{% endblock %}

{#
 # A chart card. The template bundle draws the canvas with Chart.js and the options given here.
 # The table shows the same data in the same place, for screen readers and the colors that are hard to tell apart.
 #}
{% macro chart(title, subtitle, type, source, options, categoryLabel) %}
    <figure class="overview-chart" data-chart-card>
        <figcaption class="overview-chart-header">
            <span>
                <span class="overview-chart-title">{{ title }}</span>
                <span class="overview-chart-subtitle">{{ subtitle }}</span>
            </span>
            <span class="overview-view-toggle" role="group" aria-label="View of {{ title }}">
                <button type="button" class="is-active" aria-pressed="true" data-chart-view="chart">Chart</button>
                <button type="button" aria-pressed="false" data-chart-view="table">Table</button>
            </span>
        </figcaption>
        <div class="overview-chart-body">
            <div class="overview-chart-canvas" data-chart-pane="chart">
                <canvas class="js-chart" role="img" aria-label="{{ title }}, {{ subtitle }}" data-chart-type="{{ type }}" data-src="{{ source }}" data-options="{{ options|json_encode }}"></canvas>
            </div>
            <div class="overview-chart-table" data-chart-pane="table" data-chart-table="{{ source }}" data-category-label="{{ categoryLabel }}" tabindex="0" hidden></div>
        </div>
    </figure>
{% endmacro %}

{% block body %}
    {% import _self as dashboard %}

    {% include '_partials/searchbar.html.twig' %}

    <div class="content-section content-section-small overview">
        <div class="container">

            <div class="overview-stats">
                <a class="overview-stat" href="{{ path('search_search') }}">
                    <span class="overview-stat-label">Open issues</span>
                    <span class="overview-stat-value overview-tone-issues">{{ openIssues }}</span>
                    <span class="overview-stat-note">+{{ openedIssues }} opened, {{ closedIssues }} closed in 30 days</span>
                </a>

                <a class="overview-stat overview-stat-wide" href="{{ path('gerrit_index') }}">
                    <span class="overview-stat-label">Open Gerrit changes</span>
                    <span class="overview-stat-value overview-tone-changes">{{ changesTotal }}</span>
                    {% if changesTotal > 0 %}
                        <span class="overview-segments" aria-hidden="true">
                            {% for state, count in changes|filter(count => count > 0) %}
                                <span class="overview-segment overview-segment-{{ state }}" style="flex-grow: {{ count }}"></span>
                            {% endfor %}
                        </span>
                    {% endif %}
                    <span class="overview-legend">
                        {% for state, count in changes %}
                            <span class="overview-legend-item"><span class="overview-legend-swatch overview-segment-{{ state }}"></span>{{ changeLabels[state] }} <strong>{{ count }}</strong></span>
                        {% endfor %}
                    </span>
                </a>

                <a class="overview-stat" href="{{ path('gerrit_index') }}">
                    <span class="overview-stat-label">Waiting over a month</span>
                    <span class="overview-stat-value{{ waitingChanges > 0 ? ' overview-tone-warning' }}">{{ waitingChanges }}</span>
                    <span class="overview-stat-note">Changes ready for review without activity for 30 days</span>
                </a>
            </div>

            <div class="overview-charts">
                {{ dashboard.chart('Issues opened and closed', 'Per week, the last 12 weeks', 'bar', path('chart', {'chartName': 'opened_closed'}), chartOptionsWithLegend, 'Week') }}
                {{ dashboard.chart('Changes waiting for review', 'Open changes by their last activity, without work in progress', 'bar', path('chart', {'chartName': 'open_reviews'}), chartOptionsHorizontal, 'Last activity') }}
                {{ dashboard.chart('Open issues', 'At the end of each month, the last 3 years', 'line', path('chart', {'chartName': 'tickets_over_time'}), chartOptions, 'Month') }}
                {{ dashboard.chart('Open changes', 'At the end of each month, the last 3 years, without work in progress', 'line', path('chart', {'chartName': 'reviews_over_time'}), chartOptions, 'Month') }}
                {{ dashboard.chart('Closed issues per year', 'Summed up month by month', 'line', path('chart', {'chartName': 'ticket_progress'}), chartOptionsWithLegend, 'Month') }}
                {{ dashboard.chart('Closed changes per year', 'Merged or abandoned, summed up month by month', 'line', path('chart', {'chartName': 'review_progress'}), chartOptionsWithLegend, 'Month') }}
            </div>

        </div>
    </div>
{% endblock %}
