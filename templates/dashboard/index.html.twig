{% extends 'base.html.twig' %}
{% block title %}Dashboard{% endblock %}
{% block body %}

    {% include '_partials/searchbar.html.twig' %}

    <div class="content-section content-section-small">
        <div class="container container-dashboard">
            {% set mergeableOptions = {
                scales: {
                    xAxes: [{
                        gridLines: {
                            display: false,
                            drawBorder: false
                        }
                    }],
                    yAxes: [{
                        gridLines: {
                            display: false,
                            drawBorder: false
                        }
                    }]
                }
            } %}

            {% set trackerOptions = {
                scales: {
                    xAxes: [{
                        stacked: true
                    }],
                    yAxes: [{
                        stacked: true
                    }]
                }
            } %}

            {% set dashboard = {
                0: {
                    identifier: 'quickstats',
                    classes: 'dashboard-span-base-12 dashboard-span-sm-6 dashboard-span-md-4 dashboard-start-md-1 dashboard-rowstart-md-1',
                    title: 'Quick Stats',
                    content: '<div class="js-stats" data-src="/quick_stats">
                        <div class="row">
                            <div class="col">Open Issues:</div>
                            <div class="col"><span data-value="forge"><span class="text-muted">~</span></span></div>
                            <div class="w-100"></div>
                            <div class="col">Open Reviews:</div>
                            <div class="col"><span data-value="gerrit"><span class="text-muted">~</span></span></div>
                        </div>
                    </div>'
                },
                1: {
                    identifier: 'mergeable',
                    classes: 'dashboard-span-base-12 dashboard-span-sm-6 dashboard-span-md-4 dashboard-start-md-1 dashboard-rowstart-md-2',
                    title: 'Mergeable',
                    content: '<canvas class="js-chart" data-chart-type="doughnut" data-src="/chart/mergeable"></canvas>'
                },
                2: {
                    identifier: 'openreviews',
                    classes: 'dashboard-span-base-12 dashboard-span-md-4 dashboard-start-md-5 dashboard-rowstart-md-1 dashboard-rowspan-md-2',
                    title: 'Open Reviews',
                    content: '<canvas class="js-chart" data-chart-type="line" data-src="/chart/open_reviews"></canvas>'
                },
                3: {
                    identifier: 'openclosed',
                    classes: 'dashboard-span-base-12 dashboard-span-md-4 dashboard-start-md-9 dashboard-rowstart-md-1 dashboard-rowspan-md-2',
                    title: 'Opened vs. Closed',
                    content: '<canvas class="js-chart" data-chart-type="line" data-src="/chart/opened_closed"></canvas>'
                },
                4: {
                    identifier: 'openticketsovertime',
                    classes: 'dashboard-span-base-12 dashboard-span-md-6',
                    title: 'Open Tickets over time',
                    content: '<canvas class="js-chart" data-chart-type="line" data-src="/chart/tickets_over_time"></canvas>'
                },
                5: {
                    identifier: 'openreviewsovertime',
                    classes: 'dashboard-span-base-12 dashboard-span-md-6',
                    title: 'Open Reviews over time',
                    content: '<canvas class="js-chart" data-chart-type="line" data-options="" data-src="/chart/reviews_over_time"></canvas>'
                },
                11: {
                    identifier: 'reviewprogress',
                    classes: 'dashboard-span-base-12 dashboard-span-md-6',
                    title: 'Review Progress Comparison',
                    content: '<canvas class="js-chart" data-chart-type="line" data-src="/chart/review_progress"></canvas>'
                },
                12: {
                    identifier: 'ticketprogress',
                    classes: 'dashboard-span-base-12 dashboard-span-md-6',
                    title: 'Ticket Progress Comparison',
                    content: '<canvas class="js-chart" data-chart-type="line" data-src="/chart/ticket_progress"></canvas>'
                }
            } %}
            <div class="dashboard">
                {% for item in dashboard %}
                    <div class="dashboard-item {{ item.classes }}">
                        <h5 class="dashboard-item-title">{{ item.title }}</h5>
                        <div class="dashboard-item-body">{{ item.content|raw }}</div>
                    </div>
                {% endfor %}
            </div>

        </div>
    </div>

{% endblock %}
