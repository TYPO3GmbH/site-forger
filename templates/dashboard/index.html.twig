{% extends 'base.html.twig' %}
{% block title %}Dashboard{% endblock %}
{% block body %}

    {% include '_partials/searchbar.html.twig' %}

    <div class="content-section content-section-small">
        <div class="container-fluid">
            <h1>Dashboard</h1>

            <div class="card-deck">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Mergeable</h5>
                        <canvas class="js-chart" data-chart-type="doughnut" data-src="/chart/mergeable"></canvas>
                    </div>
                </div>
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Open Reviews</h5>
                        <canvas class="js-chart" data-chart-type="line" data-src="/chart/open_reviews"></canvas>
                    </div>
                </div>
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Opened vs. Closed</h5>
                        <canvas class="js-chart" data-chart-type="line" data-src="/chart/opened_closed"></canvas>
                    </div>
                </div>
            </div>

            <div class="card-deck mt-4">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Open Tickets over time</h5>
                    </div>
                </div>
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Open Reviews over time</h5>
                    </div>
                </div>
            </div>

            <div class="card-deck mt-4">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Gerrit overview</h5>
                    </div>
                </div>
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Gerrit activity</h5>
                    </div>
                </div>
            </div>

            <div class="card-deck mt-4">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Gerrit velocity</h5>
                    </div>
                </div>
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Forge velocity</h5>
                    </div>
                </div>
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Tracker Types</h5>
                    </div>
                </div>
            </div>

            <div class="card-deck mt-4">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Review Progress Comparison</h5>
                    </div>
                </div>
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Ticket Progress Comparison</h5>
                    </div>
                </div>
            </div>

        </div>
    </div>

{% endblock %}
