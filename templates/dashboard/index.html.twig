{% extends 'base.html.twig' %}
{% block title %}Dashboard{% endblock %}

{% block body %}
    {% import '_macros/search.html.twig' as search %}
    {% import '_macros/section.html.twig' as section %}
    {% set list = '_partials/short_list.html.twig' %}
    {% set regressionSearch = {'filters': {'marked_as': {'Regression': 'true'}}, 'sort': 'updated'} %}

    {# The bands of the page are frames of the template bundle. The class "overview" in each sets the colors of
       the cards, see assets/css/module/_dashboard.scss #}
    {% frame %}
        <div class="overview">
            <h1 class="sr-only">Dashboard</h1>
            {{ search.field(path('search_search'), '', {
                'id': 'dashboard-search',
                'closed': {'title': 'Also merged and abandoned changes, and resolved, closed and rejected issues'},
            }) }}

            <div class="overview-figures">
                {{ section.heading(
                    'Key figures',
                    'overview-figures-title',
                    null,
                    {'url': path('dashboard_statistics', {'range': statisticsRange}), 'label': 'Statistics'},
                ) }}
            </div>
            <div class="overview-stats">
                <a class="overview-stat" href="{{ path('search_search') }}">
                    <span class="overview-stat-label">Open issues</span>
                    <span class="overview-stat-value overview-tone-issues">{{ openIssues }}</span>
                    <span class="overview-stat-note">
                        +{{ openedIssues }} opened, {{ resolvedIssues }} resolved in 30 days
                    </span>
                </a>

                {# All open changes, work in progress too, as the search without search words shows them #}
                <a class="overview-stat overview-stat-wide" href="{{ path('search_changes') }}">
                    <span class="overview-stat-label">Open Gerrit changes</span>
                    <span class="overview-stat-value overview-tone-changes">{{ changesTotal }}</span>
                    {% if changesTotal > 0 %}
                        <span class="overview-segments" aria-hidden="true">
                            {% for state, count in changes|filter(count => count > 0) %}
                                <span class="overview-segment overview-segment-{{ state }}" style="flex-grow: {{ count }}"></span>
                            {% endfor %}
                        </span>
                    {% endif %}
                    <span class="overview-legend">
                        {% for state, count in changes %}
                            <span class="overview-legend-item"><span class="overview-legend-swatch overview-segment-{{ state }}"></span>{{ changeLabels[state] }} <strong>{{ count }}</strong></span>
                        {% endfor %}
                    </span>
                </a>

                {# The list with the filter the number counts by, in its own order #}
                <a class="overview-stat" href="{{ path('reviews_ready', {'filters': waitingFilter}) }}">
                    <span class="overview-stat-label">Waiting over a month</span>
                    {% set waiting = waitingChanges.total %}
                    <span class="overview-stat-value{{ waiting > 0 ? ' overview-tone-warning' }}">{{ waiting }}</span>
                    <span class="overview-stat-note">Changes ready for review without activity for 30 days</span>
                </a>
            </div>
        </div>
    {% endframe %}

    {# The merges right below the figures, as thanks and as a spur: what the people of the Core got done, and the
       invitation to be next #}
    {% frame with {'color': 'white'} %}
        <div class="overview">
            {% include 'dashboard/_recently_merged.html.twig' with {'changes': recentlyMerged} only %}
        </div>
    {% endframe %}

    {# Who started to contribute, to welcome them and to help where they wait, beside the latest events #}
    {% frame %}
        <div class="overview">
            {{ section.heading(
                'Happening now',
                'overview-now-title',
                'New people, and the latest on Forge and in Gerrit.',
            ) }}
            <div class="overview-lists">
                {% include 'dashboard/_newcomers.html.twig' %}
                {% include 'dashboard/_activity.html.twig' %}
            </div>
        </div>
    {% endframe %}

    {% frame %}
        <div class="overview">
            {# Where work waits: for the mergers first, then for every reviewer and triager #}
            {{ section.heading('What needs attention', 'overview-attention-title') }}
            <div class="overview-lists">
                {% include 'dashboard/_ready_to_merge.html.twig' with {'changes': readyToMerge} only %}
                {% include list with {
                    'id': 'overview-waiting',
                    'title': 'Waiting over a month',
                    'url': path('reviews_ready', {'filters': waitingFilter, 'sort': 'least-updated'}),
                    'items': waitingChanges,
                    'kind': 'change',
                    'empty': 'No change ready for review waits for a month.',
                } only %}
                {% include list with {
                    'id': 'overview-regressions',
                    'title': 'Open regressions',
                    'url': path('search_search', regressionSearch),
                    'items': regressions,
                    'known': ['regression'],
                    'kind': 'issue',
                    'empty': 'There is no open regression.',
                } only %}
                {% include 'dashboard/_new_issues.html.twig' with {'issues': newIssues} only %}
            </div>
        </div>
    {% endframe %}
    {# What the elements of the activity take from the server, once for the page. Below the frames: two frames of
       the same color in a row share the room between them #}
    {% include 'stream/_definitions.html.twig' %}
{% endblock %}
