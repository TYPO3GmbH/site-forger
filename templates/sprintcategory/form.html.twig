{% extends 'base.html.twig' %}
{% block title %}Sprint Categories{% endblock %}
{% block page_title %}Sprint Categories{% endblock %}
{% block breadcrumb %}
    {% import '_macros/breadcrumb.html.twig' as breadcrumb %}
    {{ breadcrumb.trail([{'label': 'Sprints', 'url': path('sprint_overview')}, {'label': 'Categories', 'url': path('sprintcategory_index')}, {'label': edit is defined ? 'Edit category' : 'New category'}]) }}
{% endblock %}
{% block body %}

    <div class="content-section">
        <div class="container">
            <h2>
                {% if edit is defined %}
                    Edit a Sprint Category
                {% else %}
                    Add a Sprint Category
                {% endif %}
            </h2>
            <div class="row">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-body">
                            {{ form_start(form) }}
                            {{ form_widget(form) }}
                            {{ form_end(form) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

{% endblock %}
