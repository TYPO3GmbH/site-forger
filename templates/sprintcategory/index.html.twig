{% extends 'base.html.twig' %}
{% import '_macros/buttons.html.twig' as buttons %}
{% block title %}Sprint categories{% endblock %}
{% block page_title %}Sprint categories{% endblock %}
{# Beside the title, on its right #}
{% block page_actions %}{{ buttons.link(path('sprintcategory_create'), 'Create new', 'primary', 'actions-plus') }}{% endblock %}
{% block body %}

    <div class="content-section bg-transparent">
        <div class="container">
            <div class="row">
                <div class="col-md-12">
                    {% if items %}
                        <div class="alert alert-danger">
                            Keep in mind that deleting a sprint category will also delete all underlying sprints!
                        </div>
                        <div class="card">
                            <div class="datatable">
                                <table class="datatable-table">
                                    <thead>
                                    <tr>
                                        <th scope="col">Name</th>
                                        <th scope="col">Sprints</th>
                                        <th scope="col">Actions</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    {% for item in items %}
                                        <tr>
                                            <th>
                                                {{ icon(item.icon) }} <strong>{{ item.name }}</strong>
                                            </th>
                                            <td>
                                                {% if item.sprintBoards|length > 0 %}
                                                    <ul style="margin-bottom: 0;">
                                                        {% for sprint in item.sprintBoards %}
                                                            <li>{{ sprint }}</li>
                                                        {% endfor %}
                                                    </ul>
                                                {% else %}
                                                    <i>This category has no sprints yet</i>
                                                {% endif %}
                                            </td>
                                            <td data-type="actions" data-label="Actions">
                                                <a class="datatable-action" title="Edit" href="{{ path('sprintcategory_edit', {'categoryId': item.id}) }}">
                                                    <span class="datatable-action-icon">{{ icon('actions-open') }}</span>
                                                    <span class="datatable-action-label datatable-visually-hidden">Edit</span>
                                                </a>
                                                <a class="datatable-action" title="Delete" href="{{ path('sprintcategory_delete', {'categoryId': item.id}) }}">
                                                    <span class="datatable-action-icon">{{ icon('actions-delete') }}</span>
                                                    <span class="datatable-action-label datatable-visually-hidden">Delete</span>
                                                </a>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    {% else %}
                        {% include '_partials/alert.html.twig' with {'message': 'There are currently no sprint categories!', 'style': 'info'} %}
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

{% endblock %}
