{#
 # A Gerrit change in one row of a list, in one of four sizes. Each size has its template in
 # _partials/row/change/:
 #   xs two lines that never wrap, for narrow cards like the tasks of "Get involved": the subject, below it the
 #      owner, the lines and how it stands;
 #   s  two lines, for the cards of the dashboard: the subject, below it the owner, the targets and how it
 #      stands;
 #   m  three lines, for the lists of a detail page: the subject, the owner with targets and size, how it stands;
 #   l  for the review lists, the content of their pages: the whole subject, more facts, a column on the right.
 # In each line, what every row has comes first and in the same order. What only some rows have follows it, so it
 # never moves the rest.
 # A list that is about one fact names it in "known", so its rows do not repeat it: "owner" or "votes".
 # Expects: change, an App\Document\Change
 # Optional: size, "xs", "s", "m" or "l", "m" without;
 #           known, what every row of the list has in common, left out of the rows;
 #           relation, for "m": how it belongs to the page, like "Resolves this issue".
 #}
{% import '_macros/status.html.twig' as status %}
{% import '_macros/user.html.twig' as user %}
{% set size = size ?? 'm' %}
{% set releases = (change.releases ?? [])|filter(release => release != (change.branch ?? '') and release != 'omitted') %}
{% set conflict = change.conflict %}
{% set lines %}
    {% if change.insertions is not null and change.deletions is not null %}
        <span class="overview-list-size" title="Lines added and removed"><span class="is-added">+{{ change.insertions }}</span> <span class="is-removed">&minus;{{ change.deletions }}</span></span>
    {% endif %}
{% endset %}
{% set pills %}
    {% if conflict %}<span class="status-pill status-pill-conflict" title="Gerrit cannot merge it, it needs a rebase">Merge conflict</span>{% endif %}
    {{ status.unresolved(change) }}
{% endset %}
{# The avatar beside the name, so it is clear whom it shows #}
{% set known = known ?? [] %}
{% set owner %}{% if 'owner' not in known %}{{ user.inline(change.ownerPerson, role: 'Owner') }}{% endif %}{% endset %}
{# The branch and the releases together as the targets. A branch other than main stands out: it is a backport #}
{% set targets -%}
    <span title="Branch{{ releases is not empty ? ' and target releases' }}">→ {% if (change.branch ?? 'main') != 'main' -%}
        <span class="tag-label is-backport">{{ change.branch }}</span>
    {%- else -%}
        main
    {%- endif -%}
    {{- releases is not empty ? ', ' ~ releases|join(', ') }}</span>
{%- endset %}
{% set date %}<time class="overview-list-item-date" datetime="{{ to_datetime(change.updatedOn)|date('c') }}" title="Updated {{ change.updatedOn }}{{ change.createdOn is not null ? ', created ' ~ change.createdOn }}">{{ relativetime(to_datetime(change.updatedOn)) }}</time>{% endset %}
{% set title %}<span class="overview-list-item-title"><span class="overview-list-item-id" title="Review">{{ icon('actions-code-pull-request') }}{{ change.id }}</span>{{ change.subject }}</span>{% endset %}
{# How it stands: the votes every row has, then the state unless ready, a merge conflict, the unresolved comments #}
{% set standing %}
    {% if 'votes' not in known %}{{ status.votes(change) }}{% endif %}
    {% if change.state.isNoteworthy %}{{ status.review(change) }}{% endif %}
    {{ pills }}
{% endset %}
{% include '_partials/row/change/' ~ size ~ '.html.twig' %}
