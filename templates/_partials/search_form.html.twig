{#
 # The head of the search pages, above their tabs: the search field of _macros/search.html.twig, with whether
 # closed ones count, too. A new search starts without the filters and the order of a tab.
 # The title only for screen readers: the field says what the page is. The same words on both tabs, so the head
 # does not move between them; which ones are closed says the title of the checkbox.
 # Expects: route (search_search or search_changes), query; optional searchClosed
 #}
{% import '_macros/search.html.twig' as search %}
<h1 class="sr-only">Search</h1>
{{ search.field(path(route), query ?? '', {
    'id': 'search-form-query',
    'closed': {'checked': searchClosed ?? null, 'title': 'Also merged and abandoned changes, and resolved, closed and rejected issues'},
}) }}
