{#
    Search in the "Owner" filter of the review lists. The filter shows the owners with the most changes only,
    the search finds the others of the list and filters by the one picked, like their checkbox would.
    The suggestions are loaded while typing, see assets/js/owner-search.js and ReviewController::owners().
#}
<div class="owner-search js-owner-search" data-filter="owner" data-url="{{ path('gerrit_owners', {'list': list}) }}">
    <label class="sr-only" for="owner-search">Find an owner</label>
    <div class="owner-search-field">
        <span class="owner-search-icon" aria-hidden="true">{{ icon('actions-search') }}</span>
        <input type="search" id="owner-search" class="form-control form-control-sm owner-search-input" placeholder="Find an owner" autocomplete="off" spellcheck="false"
               role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="owner-search-results">
    </div>
    <ul class="owner-search-results" id="owner-search-results" role="listbox" aria-label="Owners" hidden></ul>
    <p class="owner-search-message" aria-live="polite" hidden></p>
</div>
