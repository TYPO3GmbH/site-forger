{% if card is not defined %}
    {% set card = {
        'id' : 0,
        'negative_reviews' : 0,
        'positive_reviews' : 0,
        'negative_verifications' : 0,
        'positive_verifications' : 0,
        '_redmine_issue_id' : 0,
        'reviewstatus': false,
        'branch': '',
        'subject': '',
        'owner': '',
        'ownerEmail': '',
        'updated_on': '',
        'affected_files': '',
        'patchsets': '',
        'mergeable': '',
    } %}
{% endif %}
<div class="card card-status-{{card.negative_reviews}}" id="review-{{card.id}}">
    <div class="card-body">
        {% if mode == 'backport' %}
            {% if not card.reviewstatus %}
                <div class="ribbon ribbonOrange" data-ribbon="MISSING"></div>
            {% elseif card.reviewstatus == 'MERGED' %}
                <div class="ribbon ribbonGreen" data-ribbon="MERGED"></div>
            {% elseif card.reviewstatus == 'ABANDONED' %}
                <div class="ribbon ribbonBlue" data-ribbon="ABANDONED"></div>
            {% endif %}
        {% else %}
            {% if card.branch == 'TYPO3_6-2' %}
                <div class="ribbon ribbonOrange" data-ribbon="6.2"></div>
            {% elseif card.branch == 'TYPO3_7-6' %}
                <div class="ribbon ribbonOrange" data-ribbon="7.6"></div>
            {% elseif card.branch == 'TYPO3_8_7' %}
                <div class="ribbon ribbonOrange" data-ribbon="8.7"></div>
            {% elseif card.branch == 'TYPO3_9-5' %}
                <div class="ribbon ribbonBlue" data-ribbon="8.7"></div>
            {% endif %}
        {% endif %}
        <h6 class="card-title"  {{ (card.reviewstatus) ? '' : 'style="opacity: 0.3"' }}>
            <div class="media">
                <div class="media-body">
                    <a href="https://review.typo3.org/#/c/{{card.id}}/" target="_blank">{{card.subject}}</a>
                </div>
                <div class="media-right">{{ avatar(card.ownerEmail) }}</div>
            </div>
        </h6>
    </div>
{% if card.mergeable is defined and card.mergeable == 'no' %}
    <div class="card-status">
        <span class="badge badge-danger">CAN'T MERGE</span>
    </div>
{% endif %}
<div class="card-body" {{ (card.reviewstatus) ? '' : 'style="opacity: 0.3"' }}>
<div class="row">
    <div class="col-sm-12">
        <i class="fal fa-user"></i> {{card.owner}} <span class="float-right"><time is="time-ago" datetime="{{card.updated_on}}">{{card.updated_on}}</time></span>
    </div>
</div>
<div class="row">
    <div class="col-md-6">Files: <span class="badge badge-secondary float-right">{{card.affected_files}}</span></div>
    <div class="col-md-6">Patches: <span class="badge badge-secondary float-right">{{card.patchsets}}</span></div>
</div>
<div class="row status">
    <div class="col-md-6">Review:
        {% if card.positive_reviews > 0 %}
            <span class="badge badge-success float-right"><i class="fal fa-check fa-fw"></i></span>
        {% endif %}
        {% if card.negative_reviews == '2' %}
            <span class="badge badge-danger float-right"><i class="fal fa-times fa-fw"></i></span>
        {% elseif card.negative_reviews == '1' %}
            <span class="badge badge-danger float-right"><i class="fal fa-minus fa-fw"></i></span>
        {% endif %}
    </div>
    <div class="col-md-6">Tested:
        {% if card.positive_verifications > 0 %}
            <span class="badge badge-success float-right"><i class="fal fa-check fa-fw"></i></span>
        {% endif %}
        {% if card.negative_verifications == '2' %}
            <span class="badge badge-danger float-right"><i class="fal fa-times fa-fw"></i></span>
        {% elseif card.negative_verifications == '1' %}

        {% endif %}
    </div>
    <div class="col-md-12">
        <div class="float-right">
            <a href="{{ path('backport_delete', {'changeId': card.id}) }}">
                <span class="badge badge-danger float-right" title="Delete"><i class="fal fa-trash-alt fa-fw"></i></span>
            </a>
        </div>
    </div>
</div>
</div>
</div>
