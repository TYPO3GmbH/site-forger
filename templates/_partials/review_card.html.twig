{#
 # A Gerrit change as a card, on the sprint boards and the review board.
 # Expects: card, a document of the review index
 #}
{% import '_macros/user.html.twig' as user %}
{% import '_macros/status.html.twig' as status %}
{% if card is defined and card is not null %}

    {% set reviewTags = card.reviewtags ?? [] %}
    {# The color of the type comes from ReviewTypeEnum #}
    {% set reviewTypeClass = review_type(card).severity ?? 'default' %}
    <div class="review review-card review-type-{{ reviewTypeClass }}">
        {% if card.mergeable is defined and card.mergeable == 'no' and (card.reviewstatus ?? 'NEW') == 'NEW' %}
            <div class="review-note review-note-danger">Merge conflict</div>
        {% endif %}
        <div class="review-header">
            <div class="review-issue">
                #{{card.id}}
            </div>
            <div class="review-title">
                <a href="{{ change_path(card.id) }}">{{card.subject}}</a>
            </div>
            <div class="review-status">
                {{ status.review(card) }}
                {{ status.activity(card) }}
                {{ status.size(card) }}
            </div>
            {% if '!!!' in reviewTags %}
                <div class="review-breaking">
                    <span class="badge badge-danger" title="Breaking change">!!!</span>
                </div>
            {% endif %}
            {% if card.branch != 'main' %}
                <div class="review-branch">
                    <span class="badge badge-danger">{{ card.branch }}</span>
                </div>
            {% endif %}
        </div>
        <div class="review-data">
            <div class="review-data-item">
                <span class="review-data-item-label">Author</span>
                <span class="review-data-item-value">{{ user.inline(change_owner(card), 20) }}</span>
            </div>
            <div class="review-data-item">
                <span class="review-data-item-label">Updated</span>
                <span class="review-data-item-value">{{ relativetime(to_datetime(card.updated_on)) }}</span>
            </div>
            <div class="review-data-item">
                <span class="review-data-item-label">Affected Files</span>
                <span class="review-data-item-value">{{ card.affected_files }}</span>
            </div>
            <div class="review-data-item">
                <span class="review-data-item-label">Patchsets</span>
                <span class="review-data-item-value">{{ card.patchsets }}</span>
            </div>
            <div class="review-data-item">
                <span class="review-data-item-label">Votes</span>
                <span class="review-data-item-value">{{ status.votes(card) }}</span>
            </div>
        </div>
    </div>
{% endif %}
