<div class="aggregations" id="aggregations" role="tablist" aria-multiselectable="true">
    {% for title, buckets in aggregations %}
        <div class="card">
            <div class="card-header" role="tab" id="heading-{{ loop.index }}">
                <h5 class="card-title" >
                    <a data-toggle="collapse" data-parent="#accordion" href="#collapse-{{ loop.index }}" aria-expanded="true" aria-controls="collapse-{{ loop.index }}" style="display:block;">
                        {{title}} {{ bucketCounter(title, buckets.buckets)|raw }}
                    </a>
                </h5>
            </div>
            <div id="collapse-{{ loop.index }}" class="collapse show" role="tabpanel" aria-labelledby="heading-{{ loop.index }}">
                <div class="card-body">
                    {% for index, bucket in buckets.buckets %}
                        {% if bucket.doc_count > 0 %}
                            <div class="form-check">
                                {{ aggregationBucket(title, index, bucket)|raw }}
                            </div>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
        </div>
    {% endfor %}
</div>
