<input type="checkbox" id="toggleAggregations" class="aggregations-checkbox">
<label for="toggleAggregations" class="aggregations-toggle">
    <span class="aggregations-toggle-icon">{{ icon('actions-filter') }}</span>
    <span class="aggregations-toggle-text">
        <span class="aggregations-toggle-text-inactive">Show</span>
        <span class="sr-only">/</span>
        <span class="aggregations-toggle-text-active">Hide</span>
        Filter
    </span>
</label>
{#
 # The filters of a list. The template bundle remembers which of them are open, by the id of their panel in
 # the localStorage "aggregations". The ids name the filter and the kind of list ("issues", "changes"), so a
 # filter opened in one list does not open another one at the same place in the next list.
 # Expects: aggregations (the filters by title, each a collection of Bucket objects, see SearchResult::facets()),
 #          facetScope; personSearch (optional);
 #          textFilters (optional): filters of a value typed in, after the others: filter key => title, value (the
 #          parameters of the filter), placeholder. The paths of the filter, separated by commas, are sent as
 #          filters[<key>][path]. <forger-path-filter> shows each as a chip and adds those typed in, see
 #          assets/ts/filter/path-filter.ts. With "match", the filter asks whether a change touches all paths or any
 #          of them, sent as filters[<key>][match] = "any";
 #          dateFilters (optional): the filters of dates, last in the list: filter key => title, and value (the
 #          parameters of the filter). Each is the calendar of <forger-days-filter>, which sends the first day as
 #          filters[<key>][from] and the last as filters[<key>][to], see assets/ts/filter/days-filter.ts and
 #          MonthOverview::days()
 #}
{% import '_macros/user.html.twig' as user %}
{# The icons and the first year of the calendar #}
{% if dateFilters ?? {} is not empty %}{% include 'stream/_definitions.html.twig' %}{% endif %}
<div class="aggregations" id="aggregations" role="tablist">
    {% for title, buckets in aggregations %}
        {% set panelId = 'facet-' ~ facetScope ~ '-' ~ (title|filterKey|lower) %}
        {# A filter with selected values is always open #}
        {% set active = activeFilterCount(title, buckets) > 0 %}
        <div class="aggregation">
            <div class="aggregation-title" id="{{ panelId }}-title">
                <a class="aggregation-title-link{{ active ? '' : ' collapsed' }}" data-bs-toggle="collapse" href="#{{ panelId }}" aria-expanded="{{ active ? 'true' : 'false' }}" aria-controls="{{ panelId }}">
                    <span class="aggregation-title-text">{{title}}</span>
                    <span class="aggregation-title-badge">{{ bucketCounter(title, buckets) }}</span>
                </a>
            </div>
            <div id="{{ panelId }}" class="collapse{{ active ? ' show' }}" role="tabpanel" aria-labelledby="{{ panelId }}-title" data-bs-parent="#aggregations"{% if active %} data-facet-active{% endif %}>
                <div class="aggregation-body">
                    {% if personSearch[title] is defined %}
                        {% include '_partials/person_search.html.twig' with personSearch[title]|merge({'id': 'person-search-' ~ loop.index}) only %}
                    {% endif %}
                    {% for index, bucket in buckets %}
                        {% if bucket.count > 0 %}
                            {# A person as everywhere, with the avatar, see PeopleFacet #}
                            {% set person = facet_person(title, bucket) %}
                            {{ aggregationBucket(title, index, bucket, person is null ? null : user.inline(person, 32)) }}
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
        </div>
    {% endfor %}
    {% for key, textFilter in textFilters ?? {} %}
        {% set paths = ((textFilter.value ?? {}).path ?? '')|file_paths %}
        {% set panelId = 'facet-' ~ facetScope ~ '-' ~ key %}
        {% set active = paths is not empty %}
        <div class="aggregation">
            <div class="aggregation-title" id="{{ panelId }}-title">
                <a class="aggregation-title-link{{ active ? '' : ' collapsed' }}" data-bs-toggle="collapse" href="#{{ panelId }}" aria-expanded="{{ active ? 'true' : 'false' }}" aria-controls="{{ panelId }}">
                    <span class="aggregation-title-text">{{ textFilter.title }}</span>
                </a>
            </div>
            <div id="{{ panelId }}" class="collapse{{ active ? ' show' }}" role="tabpanel" aria-labelledby="{{ panelId }}-title" data-bs-parent="#aggregations"{% if active %} data-facet-active{% endif %}>
                <div class="aggregation-body aggregation-range">
                    <label class="sr-only" for="{{ panelId }}-value">Add to {{ textFilter.title }}</label>
                    <forger-path-filter name="filters[{{ key }}][path]" paths="{{ paths|join(', ') }}" input-id="{{ panelId }}-value" placeholder="{{ textFilter.placeholder ?? '' }}">
                        <template>{{ icon('actions-close') }}</template>
                    </forger-path-filter>
                    {% if textFilter.match ?? false %}
                        {% set any = ((textFilter.value ?? {}).match ?? '') == 'any' %}
                        <fieldset class="aggregation-match">
                            <legend class="aggregation-match-legend">Changes touch</legend>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" id="{{ panelId }}-all"
                                       name="filters[{{ key }}][match]" value=""{{ any ? '' : ' checked' }}>
                                <label class="form-check-label" for="{{ panelId }}-all">all paths</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" id="{{ panelId }}-any"
                                       name="filters[{{ key }}][match]" value="any"{{ any ? ' checked' }}>
                                <label class="form-check-label" for="{{ panelId }}-any">any path</label>
                            </div>
                        </fieldset>
                    {% endif %}
                    <div class="aggregation-range-actions">
                        <button type="submit" class="btn btn-sm btn-default">Apply</button>
                        {% if active %}
                            <button type="submit" class="btn btn-sm btn-link" onclick="this.form.querySelectorAll('[name^=&quot;filters[{{ key }}]&quot;]').forEach(function (field) { field.value = ''; })">Clear</button>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    {% endfor %}
    {% for key, dateFilter in dateFilters ?? {} %}
        {% set value = dateFilter.value ?? {} %}
        {% set panelId = 'facet-' ~ facetScope ~ '-' ~ key %}
        {% set active = (value.range ?? '') is not empty or (value.from ?? '') is not empty or (value.to ?? '') is not empty %}
        <div class="aggregation">
            <div class="aggregation-title" id="{{ panelId }}-title">
                <a class="aggregation-title-link{{ active ? '' : ' collapsed' }}" data-bs-toggle="collapse" href="#{{ panelId }}" aria-expanded="{{ active ? 'true' : 'false' }}" aria-controls="{{ panelId }}">
                    <span class="aggregation-title-text">{{ dateFilter.title }}</span>
                </a>
            </div>
            <div id="{{ panelId }}" class="collapse{{ active ? ' show' }}" role="tabpanel" aria-labelledby="{{ panelId }}-title" data-bs-parent="#aggregations"{% if active %} data-facet-active{% endif %}>
                <div class="aggregation-body aggregation-range">
                    {# A link shared before has the days in one value, "2026-11-01 to 2026-11-20", or one day alone #}
                    {% set days = (value.range ?? '')|split(' to ', 2)|map(day => day|trim) %}
                    {% set from = (value.range ?? '') is not empty ? days[0] : (value.from ?? '') %}
                    {% set to = (value.range ?? '') is not empty ? (days[1] ?? days[0]) : (value.to ?? '') %}
                    <forger-days-filter
                        name="filters[{{ key }}]"
                        from="{{ from }}"
                        to="{{ to }}"
                        aria-label="{{ dateFilter.title }} from and to"
                    ></forger-days-filter>
                    {% if active %}
                        <div class="aggregation-range-actions">
                            <button
                                type="submit"
                                class="btn btn-sm btn-link"
                                onclick="this.form.querySelectorAll('[name^=&quot;filters[{{ key }}]&quot;]').forEach(function (field) { field.value = ''; })"
                            >Clear</button>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    {% endfor %}
</div>
{#
 # Opens the remembered filters before the page shows, without the animation the template bundle opens them
 # with once the page loaded: it finds them open then. A filter with selected values stays open, so it is
 # remembered as open. The entries of the old ids by position ("collapse-4") are removed.
 #}
<script>
    (function () {
        var prefix = 'aggregation.visible.';
        var stored = {};
        try {
            stored = JSON.parse(window.localStorage.getItem('aggregations') || '{}') || {};
        } catch (e) {
            stored = {};
        }
        Object.keys(stored).forEach(function (key) {
            if (key.indexOf(prefix + 'collapse-') === 0) {
                delete stored[key];
            }
        });
        document.querySelectorAll('#aggregations > .aggregation > .collapse').forEach(function (panel) {
            var key = prefix + panel.id;
            if (panel.hasAttribute('data-facet-active')) {
                stored[key] = true;
            }
            if (stored[key] !== true) {
                return;
            }
            panel.classList.add('show');
            var link = document.querySelector('#aggregations a[href="#' + panel.id + '"]');
            if (link) {
                link.classList.remove('collapsed');
                link.setAttribute('aria-expanded', 'true');
            }
        });
        try {
            window.localStorage.setItem('aggregations', JSON.stringify(stored));
        } catch (e) {
        }
    })();
</script>
