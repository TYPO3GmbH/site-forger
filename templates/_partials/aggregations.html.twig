<div class="aggregations" id="aggregations" role="tablist" aria-multiselectable="true">
    {% for title, buckets in aggregations %}
        <div class="aggregation">
            <div class="aggregation-title" id="aggregation-title-{{ loop.index }}">
                <a class="aggregation-title-link" data-toggle="collapse" data-parent="#aggregations" href="#collapse-{{ loop.index }}" aria-expanded="true" aria-controls="collapse-{{ loop.index }}">
                    <span class="aggregation-title-text">{{title}}</span>
                    <span class="aggregation-title-badge">{{ bucketCounter(title, buckets.buckets) }}</span>
                </a>
            </div>
            <div id="collapse-{{ loop.index }}" class="collapse show" role="tabpanel" aria-labelledby="aggregation-title-{{ loop.index }}">
                <div class="aggregation-body">
                    {% for index, bucket in buckets.buckets %}
                        {% if bucket.doc_count > 0 %}
                            {{ aggregationBucket(title, index, bucket) }}
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
        </div>
    {% endfor %}
</div>
