<table class="table table-sm table-bordered">
    <thead>
        <tr
                {% if review._source.reviewtags.0 == 'FEATURE' %}
                    class="table-success"
                {% elseif review._source.reviewtags.0 == 'TASK' %}
                    class="table-info"
                {% elseif review._source.reviewtags.0 == 'BUGFIX' %}
                    class="table-warning"
                {% endif %}
        >
            <th colspan="4">
                {% if review._source.branch != 'master' %}
                <span class="badge badge-danger">{{review._source.branch}}</span>
                {% endif %}
                {{review._source.subject}}
            </th>
        </tr>
    </thead>
    <tr>
        <td>Topic</td>
        <td><span class="badge badge-default">{{review._source.topic}}</span></td>
        <td>Target Release</td>
        <td>
            {% for release in review._source.releases %}
                {% if release == 'master' %}
                    <span class="badge badge-success">master</span>
                {% elseif release == '9.5' %}
                    <span class="badge badge-info">{{release}}</span>
                {% elseif release == '8.7' %}
                    <span class="badge badge-warning">{{release}}</span>
                {% else %}
                    <span class="badge badge-danger">{{release}}</span>
                {% endif %}
            {% endfor %}
        </td>
    </tr>
    <tr>
        <td>Affected Files:</td>
        <td><span class="label label-default">{{review._source.affected_files}}</span></td>
        <td>Patchsets: </td>
        <td><span class="label label-default">{{review._source.patchsets}}</span></td>
    </tr>
    <tr>
        <td>Created:</td>
        <td><strong><time is="time-ago" datetime="{{review._source.created_on}}">{{review._source.created_on}}</time></strong></td>
        <td>Updated:</td>
        <td><strong><time is="time-ago" datetime="{{review._source.updated_on}}">{{review._source.updated_on}}</time></strong></td>
    </tr>
    <tr>
        <td>
            Reviews
            {% if review._source.positive_reviews %}
                <span class="badge badge-success float-right">{{review._source.positive_reviews}}</span>
            {% endif %}
            {% if review._source.negative_reviews %}
                <span class="badge badge-danger float-right">{{review._source.negative_reviews}}</span>
            {% endif %}
        </td>
        <td>
            Verifies
            {% if review._source.positive_verifications %}
                <span class="badge badge-success float-right">{{review._source.positive_verifications}}</span>
            {% endif %}
            {% if review._source.negative_verifications %}
                <span class="badge badge-danger float-right">{{review._source.negative_verifications}}</span>
            {% endif %}
        </td>
        <td>
            {% if review._source.mergeable == 'no' %}
                <span class="badge badge-danger">CODE CANNOT BE MERGED</span>
            {% endif %}
        </td>
        <td>
            <a href="https://review.typo3.org/#/c/{{review._source.id}}/" target="gerrit{}{review._source.id}}"><span class="btn btn-info btn-sm"><i class="fal fa-external-link"></i> Open in Gerrit</span></a>
        </td>
    </tr>
</table>