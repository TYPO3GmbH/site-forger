<div class="card" id="issue-{{ card.id }}">
    <div class="card-heading">
        <div class="media">
            <div class="media-left">
                <span class="tracker-icon">
                    {% if card.tracker.name == 'Bug' %}
                        <span class="fa-stack" title="Bug"><i class="fal fa-square fa-stack-2x"></i><i class="fal fa-bug fa-stack-1x fa-inverse"></i></span>
                    {% elseif card.tracker.name == 'Feature' %}
                        <span class="fa-stack" title="Feature"><i class="fal fa-square fa-stack-2x"></i><i class="fal fa-heart fa-stack-1x fa-inverse"></i></span>
                    {% elseif card.tracker.name == 'Task' %}
                        <span class="fa-stack" title="Task"><i class="fal fa-square fa-stack-2x"></i><i class="fal fa-tasks fa-stack-1x fa-inverse"></i></span>
                    {% elseif card.tracker.name == 'Story' %}
                        <span class="fa-stack" title="Story"><i class="fal fa-square fa-stack-2x"></i><i class="fal fa-film fa-stack-1x fa-inverse"></i></span>
                    {% elseif card.tracker.name == 'Epic' %}
                        <span class="fa-stack" title="Epic"><i class="fal fa-square fa-stack-2x"></i><i class="fal fa-book fa-stack-1x fa-inverse"></i></span>
                    {% else %}
                        <span class="label label-default">{{ card.tracker.name }}</span>
                    {% endif %}
                </span>
                <a href="#" class="jq-button btn btn-link btn-xs" data-issue="{{ card.id }}" data-subject="{{ card.subject }}" data-description="{{ card.description }}" data-tracker="{{ card.tracker.id }}" data-card="{{ card.id }}"><i class="fal fa-ticket"></i></a>
            </div>
            <div class="media-body">
                <a href="https://forge.typo3.org/issues/{{ card.id }}" target="_blank" title="#{{ card.id }} {{ card.subject }}">#{{ card.id }} {{ card.subject }}</a>
            </div>
            {% if card.avatar is defined %}
                <div class="media-right">
                    avatar(card.avatar.username)
                </div>
            {% endif %}
        </div>
    </div>


        <div class="card-body">
            <div class="row">
                <div class="col-sm-12">
                    <i class="fal fa-bullhorn fa-fw" title="Added by"></i> {{ card.author.name }} <span class="pull-right"> <time is="time-ago" datetime="{{ card.created_on }}">{{ card.created_on }}</time></span>
                </div>
                {% if card.lastComment is defined %}
                    <div class="col-sm-12">
                        <i class="fal fa-comment fa-fw" title="Last Updated by"></i> {{ card.lastComment.user.name }} <span class="pull-right"><time is="time-ago" datetime="{{ card.lastComment.created_on }}">{{ card.lastComment.created_on }}</time></span>
                    </div>
                {% endif %}
                {% if card.assigned_to.name is defined %}
                    <div class="col-sm-12">
                        <i class="fal fa-hand-o-right fa-fw" title="Assigned to"></i> {{ card.assigned_to.name }}
                    </div>
                {% endif %}
            </div>
            <div class="row">
                <div class="col-md-6"><p>Status:<br/>
                        {% if card.status.name == 'Under Review' %}
                            <span class="label status-Review">{{ card.status.name }}</span>
                        {% elseif card.status.name == 'On Hold' %}
                            <span class="label status-OnHold">{{ card.status.name }}</span>
                        {% elseif card.status.name == 'Needs Feedback' %}
                            <span class="label status-BLOCKED">{{ card.status.name }}</span>
                        {% elseif card.status.name == 'In Progress' %}
                            <span class="label status-WIP">{{ card.status.name }}</span>
                        {% else %}
                            <span class="label status-{{ card.status.name }}">{{ card.status.name }}</span>
                        {% endif %}
                    </p>
                </div>
                <div class="col-md-6">
                    {% for customfield in card.custom_fields %}
                        {% if customfield.name is defined %}
                            {% if customfield.value == 'easy' %}
                                Complexity:<br/> <span class="label label-success">{{ customfield.value }}</span>
                            {% elseif customfield.value == 'no-brainer' %}
                                Complexity:<br/> <span class="label label-success">{{ customfield.value }}</span>
                            {% elseif customfield.value == 'medium' %}
                                Complexity:<br/> <span class="label status-Accepted">{{ customfield.value }}</span>
                            {% elseif customfield.value == 'hard' %}
                                Complexity:<br/> <span class="label status-New">{{ customfield.value }}</span>
                            {% elseif customfield.value == 'nightmare' %}
                                Complexity:<br/> <span class="label label-danger">{{ customfield.value }}</span>
                            {% endif %}
                        {% endif %}
                    {% endfor %}
                </div>
                {% if card.tags is defined %}
                    <div class="col-md-12">
                        <p>Tags:<br/>
                            {% for tag in card.tags %}
                                <span class="label label-default">{{ tag }}</span>
                            {% endfor %}
                        </p>
                    </div>
                {% endif %}
            </div>
        </div>
</div>


