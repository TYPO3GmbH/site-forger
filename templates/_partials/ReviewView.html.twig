<f:if condition="{aggregations}">
    <div class="col-sm-3">
        <h4>Aggregations</h4>

        <button type="submit" class="btn btn-success"><i class="fa fa-filter"></i> Filter</button>

        <f:render partial="Accordion" arguments="{aggregations: aggregations, query: query}" />

        <button type="submit" class="btn btn-success"><i class="fa fa-filter"></i> Filter</button>
    </div>
</f:if>
<div class="{f:if(condition: aggregations, then: 'col-sm-9', else: 'col-sm-12')}">
    <h4>Showing hits <strong>{{ startingAtItem }} </strong>to <strong>{{ endingAtItem }}</strong> of <strong>{{ totalResults }}</strong></h4>
    <f:if condition="{results}">
        {{ block('paginator') }}
    </f:if>
    <f:for each="{results}" as="result">
        <f:render partial="Review" arguments="{review: result.hit}" />
    </f:for>
    <f:if condition="{results}">
        {{ block('paginator') }}
    </f:if>
</div>

{% block paginator %}
<nav aria-label="Page navigation example">
    <ul class="pagination">
        {% for pageDesc, page in pagesToLinkTo %}
            {% if currentPage == page %}
                <li class="page-item active"><a class="page-link" href="#">{{ page }}</a></li>
            {% else %}
                <li class="page-item"><a class="page-link" href="#">{{ page }}</a></li>
            {% endif %}
        {% endfor %}
    {#    <li><fl:link.action action="{action}" arguments="{query: query, page: page, filters: filters}">{page}</fl:link.action></li>#}
    </ul>
</nav>
{% endblock %}

