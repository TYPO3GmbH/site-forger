<table class="table table-bordered table-striped table-issue">
    <thead>
    <tr
            {% if issue._source.tracker.name == 'Feature' %}
                class="table-success"
            {% elseif issue._source.tracker.name == 'Task' %}
                class="table-info"
            {% elseif issue._source.tracker.name == 'Bug' %}
                class="table-warning"
            {% endif %}
    >
        <th colspan="2">
            <a href="http://forge.typo3.org/issues/{{issue._source.id}}" target="issue{{issue._source.id}}">{{ issue._source.subject }}</a>
        </th>
    </tr>
    </thead>
    <tr>
        <th colspan="2">
            {% if issue._source.status.name == 'New' %}
                <span class="badge badge-danger">NEW</span>
            {% else %}
                <span class="badge badge-default">{{ issue._source.status.name }}</span>
            {% endif %}
            {% if issue._source.tracker.name == 'Bug' %}
                <span class="badge badge-danger">BUG</span>
            {% elseif issue._source.tracker.name == 'Feature' %}
                <span class="badge badge-success">FEATURE</span>
            {% elseif issue._source.tracker.name == 'Task' %}
                <span class="badge badge-primary">TASK</span>
            {% else %}
                <span class="badge badge-default">{{issue._source.tracker.name}}</span>
            {% endif %}
            <a href="http://forge.typo3.org/issues/{{issue._source.id}}"
               target="forgeWindow">#{{issue._source.id}}</a>
            {% if (issue._source.category.name is defined) %}
                in <span class="badge badge-default">{{issue._source.category.name}}</span>
            {% endif %}
            {% if (issue._source.typo3_version is defined) %}
                for <span class="badge badge-default">TYPO3 CMS {{issue._source.typo3_version}}</span>
            {% endif %}
            {% if (issue.score is defined) %}
                <span class="pull-right"><b>Score:</b> {issue.score}}</span>
            {% endif %}
        </th>
    </tr>
    <tr>
        <td colspan="2">
            <div class="expandable">
                {{ textile(issue._source.description)|raw }}
            </div>
            <span class="badge badge-success moreBtn">more...</span>
        </td>
    </tr>
    <tr>
        <td>Author: <strong>{{issue._source.author.name}}</strong></td>
        <td>
            Created: <strong>
                <time is="time-ago" datetime="{{issue._source.created_on}}">{{issue._source.created_on}}</time>
            </strong> -
            Updated: <strong>
                <time is="time-ago" datetime="{{issue._source.updated_on}}">{{issue._source.updated_on}}</time>
            </strong>
        </td>
    </tr>
</table>