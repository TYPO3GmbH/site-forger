<div class="accordion" id="snippet">
    <div class="card">
        <div class="card-header" id="snippet-code-block-heading">
            <h2 class="mb-0">
                <button class="btn btn-link collapsed" type="button" data-toggle="collapse" data-target="#snippet-code-block-collapse" aria-expanded="false" aria-controls="snippet-code-block-collapse">
                    Code Block
                </button>
            </h2>
        </div>
        <div id="snippet-code-block-collapse" class="collapse" aria-labelledby="snippet-code-block-heading" data-parent="#snippet">
            <div class="card-body">
                {% include '_partials/utility/code_snippet.html.twig' with {'identifier': 'code-block', 'code': '&#13;&#10;.. code-block:: php|html|typoscript|javascript&#13;&#10;&#13;&#10;&nbsp;&nbsp;&nbsp;Your code indented by three spaces.'} %}
            </div>
        </div>
    </div>
    <div class="card">
        <div class="card-header" id="snippet-inline-code-heading">
            <h2 class="mb-0">
                <button class="btn btn-link collapsed" type="button" data-toggle="collapse" data-target="#snippet-inline-code-collapse" aria-expanded="false" aria-controls="snippet-inline-code-collapse">
                    Inline Code
                </button>
            </h2>
        </div>
        <div id="snippet-inline-code-collapse" class="collapse" aria-labelledby="snippet-inline-code-heading" data-parent="#snippet">
            <div class="card-body">
                {% include '_partials/utility/code_snippet.html.twig' with {'identifier': 'inline-code-generic', 'code': '`Your code wrapped in ticks.`'} %}
                <hr>
                {% include '_partials/utility/code_snippet.html.twig' with {'identifier': 'inline-code-file', 'code': ':file:`filename`'} %}
                <hr>
                {% include '_partials/utility/code_snippet.html.twig' with {'identifier': 'inline-code-php', 'code': ':php:`$result = $a + 23;`'} %}
                <hr>
                {% include '_partials/utility/code_snippet.html.twig' with {'identifier': 'inline-code-js', 'code': ':js:`var f = function () {return 1;}`'} %}
                <hr>
                {% include '_partials/utility/code_snippet.html.twig' with {'identifier': 'inline-code-typoscript', 'code': ':ts:`lib.hello.value = Hello World!`'} %}
            </div>
        </div>
    </div>
    <div class="card">
        <div class="card-header" id="snippet-links-heading">
            <h2 class="mb-0">
                <button class="btn btn-link collapsed" type="button" data-toggle="collapse" data-target="#snippet-links-collapse" aria-expanded="false" aria-controls="snippet-links-collapse">
                    Links
                </button>
            </h2>
        </div>
        <div id="snippet-links-collapse" class="collapse" aria-labelledby="snippet-links-heading" data-parent="#snippet">
            <div class="card-body">
                {% include '_partials/utility/code_snippet.html.twig' with {'identifier': 'links', 'code': 'Some linked_ text&#13;&#10;&#13;&#10;.. _linked: https://typo3.org'} %}
            </div>
        </div>
    </div>
</div>
