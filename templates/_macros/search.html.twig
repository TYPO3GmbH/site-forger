{#
 # The one search field of Forger, on every page with a search: the search words, whether closed ones count, too, as a
 # part of the field before the button, and the button. In the head of a page (the search, the dashboard, "Find by
 # file") and, small, in the toolbar of a list beside its sort field (the review lists, My Work). See _search.scss.
 # The dialog of the header (Ctrl+K) is a control of its own, see _partials/header_search.html.twig.
 #
 # Options:
 #   id, label (for screen readers), placeholder, title (of the button)
 #   small: in the toolbar of a list, as high as the sort field beside it
 #   hidden: the parameters a new search keeps, like the filters and the order, see _macros/sort.html.twig
 #   closed: the checkbox whether closed ones count, too: {checked, title; name and value, by default searchClosed=1}
 #}
{% macro field(action, query, options = {}) %}
    {% import '_macros/sort.html.twig' as sorting %}
    {% set id = options.id ?? 'search-field' %}
    {% set small = options.small ?? false %}
    {% set closed = options.closed ?? null %}
    <form class="search-field{{ small ? ' search-field-small' }}" action="{{ action }}" method="get" role="search">
        {% for name, value in options.hidden ?? {} %}
            {{ sorting.hidden(name, value) }}
        {% endfor %}
        <label class="sr-only" for="{{ id }}">{{ options.label ?? 'Search words' }}</label>
        <div class="input-group{{ small ? ' input-group-sm' }}">
            <input type="search" id="{{ id }}" name="query" value="{{ query ?? '' }}" class="form-control" placeholder="{{ options.placeholder ?? 'Issue or change number, or search words' }}">
            {% if closed %}
                <label class="input-group-text search-field-closed"{% if closed.title is defined %} title="{{ closed.title }}"{% endif %}>
                    <input class="form-check-input" type="checkbox" name="{{ closed.name ?? 'searchClosed' }}" value="{{ closed.value ?? '1' }}"{{ (closed.checked ?? false) ? ' checked' }} onchange="this.form.submit()">
                    Include closed
                </label>
            {% endif %}
            <button type="submit" class="btn btn-default{{ small ? ' btn-sm' }}" title="{{ options.title ?? 'Search' }}">{{ icon('actions-search') }}</button>
        </div>
    </form>
{% endmacro %}
