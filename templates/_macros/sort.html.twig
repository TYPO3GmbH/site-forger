{#
 # The sort field of an issue or review list, the orders come from IssueSortEnum or ReviewSortEnum.
 # It sends the parameters of the list again, so sorting keeps the search words and filters, and starts on page 1.
 #}

{% macro select(action, sort, options, parameters, id = 'list-sort') %}
    <form class="list-sort" action="{{ action }}" method="get">
        {% for name, value in parameters %}
            {{ _self.hidden(name, value) }}
        {% endfor %}
        <label class="list-sort-label" for="{{ id }}">Sort by</label>
        <select id="{{ id }}" name="sort" class="form-select form-select-sm list-sort-select" onchange="this.form.submit()">
            {% for option in options %}
                <option value="{{ option.value }}"{{ option == sort ? ' selected' }}>{{ option.label }}</option>
            {% endfor %}
        </select>
        <noscript><button type="submit" class="btn btn-sm btn-default">Sort</button></noscript>
    </form>
{% endmacro %}

{#
 # A parameter as hidden fields, nested ones such as filters[tracker][Bug] as one field per value.
 #}
{% macro hidden(name, value) %}
    {% if value is iterable %}
        {% for key, item in value %}
            {{ _self.hidden(name ~ '[' ~ key ~ ']', item) }}
        {% endfor %}
    {% elseif value is not null %}
        <input type="hidden" name="{{ name }}" value="{{ value }}">
    {% endif %}
{% endmacro %}
