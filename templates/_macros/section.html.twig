{#
 # The head of a part of a page: its title, a line below it. The same on the dashboard and on "Get involved", see
 # assets/css/module/_section-heading.scss.
 #}
{% macro heading(title, id, lead = null) %}
    <header class="section-heading">
        <h2 class="section-title" id="{{ id }}">{{ title }}</h2>
        {% if lead is not null %}<p class="section-lead">{{ lead }}</p>{% endif %}
    </header>
{% endmacro %}
