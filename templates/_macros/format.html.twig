{#
 # Values in the form people read them.
 #}

{# A size in bytes as B, KB, MB or GB, "–" when it is not known #}
{% macro bytes(bytes) %}
    {%- if bytes is null -%}
        –
    {%- elseif bytes >= 1073741824 -%}
        {{ (bytes / 1073741824)|number_format(1, '.', ',') }} GB
    {%- elseif bytes >= 1048576 -%}
        {{ (bytes / 1048576)|number_format(1, '.', ',') }} MB
    {%- elseif bytes >= 1024 -%}
        {{ (bytes / 1024)|number_format(0, '.', ',') }} KB
    {%- else -%}
        {{ bytes }} B
    {%- endif -%}
{% endmacro %}
