{% extends 'base.html.twig' %}
{% import '_macros/buttons.html.twig' as buttons %}
{% block title %}Company Employment{% endblock %}
{% block headline %}Company Employment{% endblock %}
{% block body %}

    <div class="content-section bg-transparent">
        <div class="container">
            <div class="row">
                <div class="col-md-12">
                    <div class="float-right">
                        {{ buttons.link(
                            path('user_employment_manage'),
                            'Create new',
                            'primary',
                            'actions-plus'
                        ) }}
                    </div>
                </div>
            </div>
            <br>
            <div class="row">
                <div class="col-md-12">
                    {% if employmentTimes %}
                        <div class="card">
                            <div class="datatable">
                                <table class="datatable-table">
                                    <thead>
                                    <tr>
                                        <th scope="col">Company</th>
                                        <th scope="col">Dates</th>
                                        <th scope="col">Actions</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    {% for employmentTime in employmentTimes %}
                                        <tr>
                                            <th class="{{ employmentTime.employedTo ? 'text-muted' : '' }}">
                                                <strong>{{ employmentTime.company.name }}</strong>
                                            </th>
                                            <td class="{{ employmentTime.employedTo ? 'text-muted' : '' }}">
                                                {% if employmentTime.employedTo %}
                                                    {{ icon('actions-login') }} {{ employmentTime.employedFrom|date('Y-m-d') }}</small><br>
                                                    {{ icon('actions-logout') }} {{ employmentTime.employedTo|date('Y-m-d') }}
                                                {% else %}
                                                    {{ icon('actions-login') }} {{ employmentTime.employedFrom|date('Y-m-d') }}
                                                {% endif %}
                                            </td>
                                            <td data-type="actions" data-label="Actions">
                                                <a class="datatable-action" title="Edit" href="{{ path('user_employment_manage', {'id': employmentTime.id}) }}">
                                                    <span class="datatable-action-icon">{{ icon('actions-open') }}</span>
                                                    <span class="datatable-action-label datatable-visually-hidden">Edit</span>
                                                </a>
                                                <a class="datatable-action" title="Delete" href="{{ path('user_employment_delete', {'id': employmentTime.id}) }}">
                                                    <span class="datatable-action-icon">{{ icon('actions-delete') }}</span>
                                                    <span class="datatable-action-label datatable-visually-hidden">Delete</span>
                                                </a>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    {% else %}
                        {% include '_partials/alert.html.twig' with {'message': 'No employment yet', 'style': 'info'} %}
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

{% endblock %}
