{% extends 'base.html.twig' %}
{% block title %}Help{% endblock %}
{% block page_title %}Help{% endblock %}

{#
 # A tile linking to a page of Forger.
 #}
{% macro tile(route, icon, title, description) %}
    {% import '_macros/tiles.html.twig' as tiles %}
    {{ tiles.tile(path(route), icon, title, description) }}
{% endmacro %}

{% block body %}
    {% import _self as help %}
    {% import '_macros/status.html.twig' as status %}

    {% set sections = [
        {id: 'data', icon: 'actions-database', title: 'Where the data comes from'},
        {id: 'activity', icon: 'actions-clock', title: 'Activity'},
        {id: 'reviews', icon: 'actions-code-pull-request', title: 'Reviews'},
        {id: 'issues', icon: 'actions-list', title: 'Issues'},
        {id: 'dashboard', icon: 'actions-viewmode-tiles', title: 'Dashboard'},
        {id: 'my-work', icon: 'actions-user', title: 'My Work'},
        {id: 'sprints', icon: 'actions-line-columns', title: 'Sprints'},
        {id: 'tools', icon: 'actions-briefcase', title: 'Tools'},
        {id: 'filters', icon: 'actions-filter', title: 'Filters and search'},
    ] %}

    <div class="content-section bg-transparent">
        <div class="container help">
            <nav class="help-toc" aria-label="Contents">
                <div class="help-toc-title">On this page</div>
                <ul>
                    {% for section in sections %}
                        <li><a href="#{{ section.id }}">{{ icon(section.icon) }}<span>{{ section.title }}</span></a></li>
                    {% endfor %}
                </ul>
            </nav>

            <div class="help-content">
                <div class="help-intro">
                    <p>
                        Forger shows the work on the TYPO3 Core in one place: the issues of Forge and the changes on Gerrit,
                        sorted into lists that answer <em>what needs a review?</em>, <em>what can be merged?</em>
                        and <em>what has nobody touched for months?</em>
                    </p>
                </div>

                {# Where the data comes from #}
                <section id="data" class="help-section">
                    <header class="help-section-header">
                        <span class="help-section-icon">{{ icon('actions-database') }}</span>
                        <h2>Where the data comes from</h2>
                    </header>
                    <div class="help-sources">
                        <div class="help-source">
                            <div class="help-source-title">Forge</div>
                            <p>The issues of the project <a href="https://forge.typo3.org/projects/typo3cms-core" target="_blank" rel="noopener">TYPO3 Core</a>, without subprojects, private issues and private notes.</p>
                        </div>
                        <div class="help-source">
                            <div class="help-source-title">Gerrit</div>
                            <p>The changes of <a href="https://review.typo3.org/q/project:Packages/TYPO3.CMS" target="_blank" rel="noopener">Packages/TYPO3.CMS</a> with their votes, patch sets and files.</p>
                        </div>
                        <div class="help-source">
                            <div class="help-source-title">GitHub</div>
                            <p>Activity in the repositories of the community, for the team reports of the admins only.</p>
                        </div>
                    </div>
                    <p class="help-muted">
                        Forger copies the data in regular imports, so a change shows up after the next one has run.
                        Every issue and change links to its original.
                    </p>
                </section>

                {# Activity #}
                <section id="activity" class="help-section">
                    <header class="help-section-header">
                        <span class="help-section-icon">{{ icon('actions-clock') }}</span>
                        <h2>Activity</h2>
                    </header>
                    <p>
                        Open changes and issues show how long ago they were last updated: a comment, a vote, a new patch set or a new status.
                        Bots on Gerrit only vote on uploaded patch sets, so they do not make a change look busy.
                    </p>
                    <div class="help-stages">
                        {% for stage in enum_cases('App\\Enum\\ActivityEnum') %}
                            <div class="help-stage">
                                {{ status.activityPill(stage, {}) }}
                                <span class="help-stage-range">
                                    {% if stage.maximumDays is null %}
                                        over {{ stage.minimumDays }} days
                                    {% elseif stage.minimumDays == 0 %}
                                        up to {{ stage.maximumDays }} days
                                    {% else %}
                                        {{ stage.minimumDays }}–{{ stage.maximumDays }} days
                                    {% endif %}
                                </span>
                            </div>
                        {% endfor %}
                    </div>
                    <ul class="help-points">
                        <li>Merged, abandoned, resolved, closed and rejected ones have no stage, and the "Activity" filter never counts them.</li>
                        <li>Issues "On Hold" or "Postponed" are open, so they get a stage like any other.</li>
                    </ul>
                    <div class="help-callout">
                        <strong>Not the same as "Stale issues".</strong>
                        The stage is about time only. The list <a href="#stale-issues">Stale issues</a> shows issues under review without an open change.
                    </div>
                </section>

                {# Reviews #}
                <section id="reviews" class="help-section">
                    <header class="help-section-header">
                        <span class="help-section-icon">{{ icon('actions-code-pull-request') }}</span>
                        <h2>Reviews</h2>
                    </header>
                    <p>
                        The lists show open changes, the ones updated last first. Each list can be sorted and searched by subject, commit message, number, Change-Id, topic and owner.
                        Work in progress only appears in its own list, in "Find by file" and in the search.
                        Votes count when a person gave them, not the CI bot.
                    </p>
                    <div class="link-tiles">
                        {{ help.tile('gerrit_index', 'actions-code-pull-request', 'Ready for review', 'Every open change that is not work in progress.') }}
                        {{ help.tile('gerrit_wip', 'actions-code-pull-request-draft', 'Work in progress', 'Marked as work in progress in Gerrit or with [WIP] or [POC] in the subject, the oldest first.') }}
                        {{ help.tile('gerrit_missesreview', 'actions-comment', 'Needs review', 'Verified, but no positive code review yet.') }}
                        {{ help.tile('gerrit_missesverifications', 'actions-check-circle', 'Needs verification', 'A positive code review, but not verified yet.') }}
                        {{ help.tile('gerrit_rebase', 'actions-refresh', 'Needs rebase', 'Gerrit cannot merge them because of a conflict.') }}
                        {{ help.tile('gerrit_negative_vote_cleanup', 'actions-minus-circle', 'Negative votes', 'At least one negative review or verification.') }}
                        {{ help.tile('gerrit_hasverifications', 'actions-check-badge', 'Reviewed and verified', 'A positive review and verification, whatever else they have.') }}
                        {{ help.tile('gerrit_coreteam_merge', 'actions-code-merge', 'Ready to merge', 'Reviewed and verified, no negative vote, no conflict.') }}
                        {{ help.tile('gerrit_files', 'actions-file-search', 'Find by file', 'Changes touching a file, by its full path in the repository.') }}
                        {{ help.tile('search_changes', 'actions-search', 'Search', 'Words find open changes, also work in progress. The subject leads to a page with the commit message, the issues and the files of a change.') }}
                    </div>
                    <p id="change-sizes">
                        The size of a change tells how long its review takes, like the difficulty of a game: the lines it adds and removes together, as Gerrit counts them.
                        The filter "Size" of the lists shows the changes of one or more sizes, "Smallest first" in their sort field puts the quick reviews on top.
                    </p>
                    <div class="help-stages help-stages-sizes">
                        {% for size in enum_cases('App\\Enum\\ReviewSizeEnum') %}
                            <div class="help-stage">
                                {{ status.sizePill(size, size.description) }}
                                <span class="help-stage-range">
                                    {% if size.maximum is null %}
                                        over {{ size.minimum - 1 }} lines
                                    {% elseif size.minimum == 0 %}
                                        up to {{ size.maximum }} lines
                                    {% else %}
                                        {{ size.minimum }}–{{ size.maximum }} lines
                                    {% endif %}
                                </span>
                            </div>
                        {% endfor %}
                    </div>
                </section>

                {# Issues #}
                <section id="issues" class="help-section">
                    <header class="help-section-header">
                        <span class="help-section-icon">{{ icon('actions-list') }}</span>
                        <h2>Issues</h2>
                    </header>
                    <div class="link-tiles">
                        {{ help.tile('search_search', 'actions-search', 'Search', 'Words find open issues and reviews, each in a tab. A number shows the issue and the change with it, and finds the changes that resolve the issue. The page of an issue shows its changes and finds its possible duplicates.') }}
                        <div id="stale-issues" class="link-tile-anchor">
                            {{ help.tile('gerrit_stale_issues', 'actions-clock', 'Stale issues', 'Open issues without activity for 60 days or more, the stages "Stale" and "Orphaned". Each says which changes it has, linked in the comments or resolving or naming the issue in their commit message.') }}
                        </div>
                        {{ help.tile('management_bycategory', 'actions-tag', 'By category', 'Open issues per category and tracker, the categories with the most first.') }}
                        {{ help.tile('management_index', 'actions-calendar', 'By month', 'Open issues by the month they were created: how old the open issues are.') }}
                    </div>
                    <p class="help-muted">Tick "Include closed" in the search to include resolved, closed and rejected issues, or merged and abandoned changes. Admins refresh an issue or a change from its page.</p>
                </section>

                {# Dashboard #}
                <section id="dashboard" class="help-section">
                    <header class="help-section-header">
                        <span class="help-section-icon">{{ icon('actions-viewmode-tiles') }}</span>
                        <h2>Dashboard</h2>
                    </header>
                    <dl class="help-facts">
                        <div><dt>Open issues</dt><dd>with those opened and closed in the last 30 days</dd></div>
                        <div><dt>Open Gerrit changes</dt><dd>mergeable, with a conflict or work in progress</dd></div>
                        <div><dt>Waiting over a month</dt><dd>ready for review, no update for 30 days</dd></div>
                    </dl>
                    <p>
                        The charts show the issues opened and closed per week, how long changes have been waiting, the open issues and changes
                        over three years and what was closed per year. Each chart switches to a table.
                    </p>
                    <p class="help-muted">The history is worked out from when issues and changes were created and closed, so it is close to, not exactly, what Forge and Gerrit showed back then.</p>
                </section>

                {# My Work #}
                <section id="my-work" class="help-section">
                    <header class="help-section-header">
                        <span class="help-section-icon">{{ icon('actions-user') }}</span>
                        <h2>My Work</h2>
                    </header>
                    <p>
                        Log in with your TYPO3 account to see your changes and the issues you reported or are assigned to.
                        Forger finds them by the email address and the name of your account. Closed ones are hidden until you choose "Include closed".
                    </p>
                </section>

                {# Sprints #}
                <section id="sprints" class="help-section">
                    <header class="help-section-header">
                        <span class="help-section-icon">{{ icon('actions-line-columns') }}</span>
                        <h2>Sprints</h2>
                    </header>
                    <div class="link-tiles">
                        <div class="link-tile link-tile-static">
                            <span class="link-tile-icon">{{ icon('actions-viewmode-tiles') }}</span>
                            <span class="link-tile-body">
                                <span class="link-tile-title">Sprint boards</span>
                                <span class="link-tile-text">Selected issues in the columns Blocked, Open, WIP, Review and Done. The Core team creates them.</span>
                            </span>
                        </div>
                        {{ help.tile('sprint_reviews', 'actions-line-columns', 'Review board', 'Open bugfixes, features or tasks, grouped by what they lack.') }}
                    </div>
                </section>

                {# Tools #}
                <section id="tools" class="help-section">
                    <header class="help-section-header">
                        <span class="help-section-icon">{{ icon('actions-briefcase') }}</span>
                        <h2>Tools</h2>
                    </header>
                    <div class="link-tiles">
                        {{ help.tile('utilities_backport', 'actions-code-compare', 'Backports', 'Merged into main within a year, with a version in "Releases:" that has no backport yet.') }}
                        {{ help.tile('utilities_rst', 'actions-file-text', 'ReST helper', 'Writes the changelog file of a breaking change, deprecation or feature.') }}
                    </div>
                </section>

                {# Filters #}
                <section id="filters" class="help-section">
                    <header class="help-section-header">
                        <span class="help-section-icon">{{ icon('actions-filter') }}</span>
                        <h2>Filters and search</h2>
                    </header>
                    <ul class="help-points">
                        <li>The number next to a filter value is how many results it has.</li>
                        <li>Values of one filter add up, different filters narrow each other down: <em>Stale or Orphaned, and on main</em>.</li>
                        <li>The "Type" filter of the review lists uses the tags in the subject, like BUGFIX, TASK, FEATURE, DOCS or !!! for a breaking change.</li>
                        <li>The "Tags" filter of the issue search shows the most used tags of the issues found, and the ones you selected.</li>
                        <li>The filters of people, "Owner" of the review lists and "Author" and "Assigned to" of the issue search, show the ten with the most results. Their search finds the others in the list while you type and filters by the one you pick.</li>
                        <li>The search in the header finds issues from every page.</li>
                    </ul>
                </section>
            </div>
        </div>
    </div>

{% endblock %}
