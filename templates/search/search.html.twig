{% extends 'base.html.twig' %}
{% block title %}Search issues{% endblock %}
{% block body %}
    {% import '_macros/sort.html.twig' as sorting %}

    <div class="content-section content-section-small">
        <div class="container">
            {% include '_partials/search_form.html.twig' with {'route': 'search_search'} %}
            {% include '_partials/search_tabs.html.twig' with {'active': 'issues'} %}
            {% include '_partials/exact_matches.html.twig' %}
            {# The parameters of the list, for the pages, the filters and the sort field #}
            {% set closedParameter = (searchClosed is defined) ? {'searchClosed': searchClosed} : {} %}
            {% set listArguments = {'query': query, 'filters': filters}|merge(closedParameter)|merge(sortParameter) %}
            {# Filters that find nothing stay, to untick them #}
            {% if totalResults > 0 or has_active_filters(filters) %}
                <div class="section">
                    <div class="section-filter">
                        <form action="{{ path('search_search') }}" method="get">
                            <input type="hidden" name="query" value="{{ query }}">
                            {{ sorting.hidden('searchClosed', searchClosed ?? null) }}
                            {{ sorting.hidden('sort', sortParameter.sort ?? null) }}
                            {% include '_partials/aggregations.html.twig' with {
                                'facetScope': 'issues',
                                'aggregations': aggs,
                                'dateFilters': {'created': {'title': 'Created', 'value': filters.created ?? {}}},
                                'query': query,
                                'personSearch': {
                                    'Author': {'filter': 'author', 'url': path('search_people', {'filter': 'author'}), 'label': 'Find an author'},
                                    'Assigned to': {'filter': 'assigned_to', 'url': path('search_people', {'filter': 'assigned_to'}), 'label': 'Find an assignee'},
                                },
                            } only %}
                        </form>
                    </div>
                    <div class="section-main">
                        <div class="results-toolbar">
                            {% if totalResults > 0 %}
                                {% include '_partials/pagination.html.twig' with {
                                    'resultsTotal': totalResults,
                                    'resultsFrom': startingAtItem,
                                    'resultsTo': endingAtItem,
                                } only %}
                            {% endif %}
                            {{ sorting.select(path(routeName), sort, sortOptions, {'query': query, 'filters': filters}|merge(closedParameter)) }}
                        </div>
                        {% if totalResults == 0 %}
                            {% include '_partials/alert.html.twig' with {
                                'title': query is not empty ? 'No issue matches "' ~ query ~ '" with the filters.' : 'No issue matches the filters.',
                                'message': 'Untick a filter, or',
                                'action': {'url': path('search_search', {'query': query}|merge(closedParameter)|merge(sortParameter)), 'label': 'remove the filters.'},
                                'style': 'info',
                            } only %}
                        {% else %}
                            <ul class="row-list row-list-panel">
                                {% for result in results %}
                                    <li>{% include '_partials/row/issue.html.twig' with {'issue': result.data, 'detailed': true} only %}</li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                        {# The pages only below the list, the count stands above it #}
                        {% include '_partials/pagination.html.twig' with {
                            'pages': pagesToLinkTo,
                            'current': currentPage,
                            'last': lastPage ?? null,
                            'routeName': routeName,
                            'arguments': listArguments
                        } only %}
                    </div>
                </div>
            {% else %}
                {% include '_partials/alert.html.twig' with {
                    'message': tabs.changes > 0 ? 'The tab "Reviews" has ' ~ tabs.changes ~ ' changes for it.' : 'Try other words, or tick "Include closed" for the resolved, closed and rejected ones.',
                    'title': query is not empty ? 'No issue was found for "' ~ query ~ '".' : 'No issue was found.',
                    'style': tabs.changes > 0 ? 'info' : 'danger'
                } %}
            {% endif %}
        </div>
    </div>

{% endblock %}
