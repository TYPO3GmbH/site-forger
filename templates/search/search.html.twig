{% extends 'base.html.twig' %}
{% import '_macros/buttons.html.twig' as buttons %}
{% block title %}{{ routeName }}!{% endblock %}
{% block body %}

    {% include '_partials/searchbar.html.twig' %}
    <div class="content-section content-section-small">
        <div class="container">
            {% if (ErrorMessage is defined) %}
                {% include '_partials/alert.html.twig' with {'message': ErrorMessage} %}
            {% else %}
                {% if mode == 'query' %}
                    {% if totalResults > 0 %}
                        <div class="row">
                            <div class="col-sm-3">
                                <h4>Aggregations</h4>
                                <form action="{{ path('search_search') }}" method="get">
                                    <input type="hidden" name="query" value="{{ (query is defined) ? query : '' }}">
                                    {{ buttons.submit('Filter', 'secondary', 'filter') }}
                                    {% include '_partials/aggregations.html.twig' with {'aggregations': aggs, 'query': query} %}
                                    {{ buttons.submit('Filter', 'secondary', 'filter') }}
                                </form>
                            </div>
                            <div class="col-sm-9">
                                <h4>Showing hits <strong>{{startingAtItem}} </strong>to <strong>{{endingAtItem}}</strong> of <strong>{{totalResults}}</strong></h4>
                                {% if results %}
                                    {{ block('paginator') }}
                                {% endif %}
                                {% for result in results %}
                                    {% include '_partials/issue.html.twig' with {'issue': result.hit} %}
                                {% endfor %}
                                {% block paginator %}
                                    <nav aria-label="Page navigation example">
                                        <ul class="pagination">
                                            {% for pageDesc, page in pagesToLinkTo %}
                                                {% if currentPage == page %}
                                                    <li class="page-item active"><a class="page-link" href="{{ path(routeName, {'query':query, 'page': page, 'filters': filters}) }}">{{ page }}</a></li>
                                                {% else %}
                                                    <li class="page-item"><a class="page-link" href="{{ path(routeName, {'query':query, 'page': page, 'filters': filters}) }}">{{ page }}</a></li>
                                                {% endif %}
                                            {% endfor %}
                                        </ul>
                                    </nav>
                                {% endblock %}
                            </div>
                        </div>
                    {% else %}
                        {% include '_partials/alert.html.twig' with {'message': 'Try another term or set the checkbox "Search closed tickets".', 'title': 'No results were found for <code>' ~ query ~ '</code>.', 'style': 'danger'} %}
                    {% endif %}
                {% else %}
                    <div class="row">
                        <div class="col-sm-12 col-md-6">
                            <h4>Requested Issue</h4>
                            {% include '_partials/issue.html.twig' with {'issue': issue} %}
                        </div>
                        <div class="col-sm-12 col-md-6">
                            <h4>{{totalResults}} potential duplicates</h4>
                            {% for result in results %}
                                {% include '_partials/issue.html.twig' with {'issue': result.hit} %}
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}
            {% endif %}
        </div>
    </div>

{% endblock %}
