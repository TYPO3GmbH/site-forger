# Enforce checkout with linux lf consistent over all plattforms
bin/console text eol=lf
*.xml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.svg text eol=lf
*.tmpl text eol=lf
*.less text eol=lf
*.js text eol=lf
*.json text eol=lf
*.php text eol=lf
*.rst text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.ts text eol=lf
*.xlf text eol=lf
*.sql text eol=lf
*.txt text eol=lf

# Not part of the deployed build (deploy.php builds from `git archive`)
/.ddev export-ignore
/.editorconfig export-ignore
/.env.test export-ignore
/.gitattributes export-ignore
/.github export-ignore
/.gitignore export-ignore
/.nvmrc export-ignore
/LICENSE export-ignore
/README.md export-ignore
/assets export-ignore
/build export-ignore
/deploy.php export-ignore
/package-lock.json export-ignore
/package.json export-ignore
/phpunit.xml.dist export-ignore
/symfony.lock export-ignore
/tests export-ignore
/webpack.config.js export-ignore
