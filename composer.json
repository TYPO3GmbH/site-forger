{
    "name": "t3g/forger",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^7.4.0",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-json": "*",
        "doctrine/doctrine-migrations-bundle": "2.*",
        "guzzlehttp/guzzle": "^6.3",
        "johnstyle/redmine-bundle": "^1.0",
        "kbsali/redmine-api": "^1.5",
        "knplabs/knp-menu-bundle": "^2.2",
        "netcarver/textile": "^3.7",
        "ruflin/elastica": "^6.1",
        "sensio/framework-extra-bundle": "^5.4",
        "symfony/console": "^4.3",
        "symfony/dotenv": "^4.3",
        "symfony/flex": "^1.3.1",
        "symfony/form": "^4.3",
        "symfony/framework-bundle": "^4.3",
        "symfony/ldap": "^4.3",
        "symfony/lock": "^4.3",
        "symfony/monolog-bundle": "^3.5",
        "symfony/orm-pack": "^1.0",
        "symfony/security-bundle": "^4.3",
        "symfony/twig-bundle": "^4.3",
        "symfony/validator": "^4.3",
        "symfony/webpack-encore-bundle": "^1.6",
        "symfony/yaml": "^4.3",
        "t3g/symfony-template-bundle": "^2.4",
        "t3g/symfony-usercentrics-bundle": "^1.0",
        "woeler/phpdiscord": "^1.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^2.15",
        "symfony/maker-bundle": "^1.11",
        "symfony/profiler-pack": "^1.0"
    },
    "config": {
        "preferred-install": {
            "*": "dist"
        },
        "platform": {
            "php": "7.4"
        },
        "bin-dir": "bin",
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "paragonie/random_compat": "2.*",
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php71": "*",
        "symfony/polyfill-php70": "*",
        "symfony/polyfill-php56": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "t3g:cgl": [
            "mkdir -p var/php-cs-fixer/; php-cs-fixer fix --config .php_cs.dist --format=junit > var/php-cs-fixer/php-cs-fixer.xml"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "^4.3"
        }
    }
}
