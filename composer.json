{
    "name": "t3g/forger",
    "license": "proprietary",
    "type": "project",
    "require": {
        "php": "^8.3",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-json": "*",
        "doctrine/doctrine-bundle": "^2.10",
        "doctrine/doctrine-migrations-bundle": "^3.2.4",
        "doctrine/orm": "^3.3",
        "guzzlehttp/guzzle": "^7.7.0",
        "kbsali/redmine-api": "^2.2",
        "knplabs/knp-menu-bundle": "^3.2",
        "netcarver/textile": "^4.1",
        "psr/log": "^2.0",
        "ruflin/elastica": "^7.3",
        "symfony/console": "^7.4",
        "symfony/dependency-injection": "^7.4",
        "symfony/dotenv": "^7.4",
        "symfony/flex": "^2.3",
        "symfony/form": "^7.4",
        "symfony/framework-bundle": "^7.4",
        "symfony/http-foundation": "^7.4",
        "symfony/lock": "^7.4",
        "symfony/monolog-bundle": "^3.8",
        "symfony/routing": "^7.4",
        "symfony/runtime": "^7.4",
        "symfony/security-bundle": "^7.4",
        "symfony/twig-bundle": "^7.4",
        "symfony/validator": "^7.4",
        "symfony/webpack-encore-bundle": "^2.0",
        "symfony/yaml": "^7.4",
        "t3g/symfony-keycloak-bundle": "^3.0",
        "t3g/symfony-template-bundle": "^6.1",
        "twig/twig": "^3.15",
        "typo3/html-sanitizer": "^2.3"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.18",
        "phpunit/phpunit": "^12.5",
        "rector/rector": "^2.0",
        "symfony/maker-bundle": "^1.49",
        "symfony/stopwatch": "^7.4",
        "symfony/web-profiler-bundle": "^7.4"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "replace": {
        "paragonie/random_compat": "2.*",
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/TYPO3GmbH/symfony-keycloak-bundle"
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": true,
            "php-http/discovery": true,
            "symfony/runtime": true
        },
        "bin-dir": "bin",
        "platform": {
            "php": "8.3"
        },
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.4.*"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "t3g:cgl": [
            "php-cs-fixer fix --config build/.php-cs-fixer.dist.php -v --dry-run --diff"
        ],
        "t3g:cgl:fix": [
            "php-cs-fixer fix --config build/.php-cs-fixer.dist.php"
        ],
        "t3g:test": [
            "@t3g:test:php"
        ],
        "t3g:test:php": [
            "bin/phpunit -c build/phpunit.xml"
        ]
    }
}
