{
    "name": "t3g/forger",
    "license": "proprietary",
    "type": "project",
    "require": {
        "php": "^8.3",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-json": "*",
        "doctrine/doctrine-bundle": "^2.10",
        "doctrine/doctrine-migrations-bundle": "^3.2.4",
        "doctrine/orm": "^3.3",
        "guzzlehttp/guzzle": "^7.7.0",
        "kbsali/redmine-api": "^2.2",
        "knplabs/knp-menu-bundle": "^3.2",
        "netcarver/textile": "^4.0",
        "psr/log": "^2.0",
        "ruflin/elastica": "^7.3",
        "symfony/console": "^6.4",
        "symfony/dependency-injection": "^6.4",
        "symfony/dotenv": "^6.4",
        "symfony/flex": "^2.3",
        "symfony/form": "^6.4",
        "symfony/framework-bundle": "^6.4",
        "symfony/http-foundation": "^6.4",
        "symfony/lock": "^6.4",
        "symfony/monolog-bundle": "^3.8",
        "symfony/routing": "^6.4",
        "symfony/runtime": "^6.4",
        "symfony/security-bundle": "^6.4",
        "symfony/twig-bundle": "^6.4",
        "symfony/validator": "^6.4",
        "symfony/webpack-encore-bundle": "^2.0",
        "symfony/yaml": "^6.4",
        "t3g/elastic-utility": "^7.0.2",
        "t3g/symfony-datahub-bundle": "^3.0",
        "t3g/symfony-keycloak-bundle": "^3.0",
        "t3g/symfony-template-bundle": "^4.0.3",
        "t3g/symfony-usercentrics-bundle": "^2.0",
        "twig/twig": "^3.15"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.18",
        "rector/rector": "^2.0",
        "roave/security-advisories": "dev-latest",
        "symfony/maker-bundle": "^1.49",
        "symfony/stopwatch": "^6.4",
        "symfony/web-profiler-bundle": "^6.4"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "replace": {
        "paragonie/random_compat": "2.*",
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://repo.packagist.com/typo3gmbh/"
        },
        {
            "packagist.org": false
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": true,
            "php-http/discovery": true,
            "symfony/runtime": true
        },
        "bin-dir": "bin",
        "platform": {
            "php": "8.3"
        },
        "preferred-install": {
            "*": "dist",
            "t3g/*": "src"
        },
        "sort-packages": true
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "^6.4"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "t3g:cgl": [
            "php-cs-fixer fix --config build/.php-cs-fixer.dist.php -v --dry-run --diff"
        ],
        "t3g:cgl:fix": [
            "php-cs-fixer fix --config build/.php-cs-fixer.dist.php"
        ]
    }
}
